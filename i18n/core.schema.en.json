{
  "settings_schema": {
    "brand": {
      "name": "Brand",
      "settings": {
        "logo": {
          "label": "Logo",
          "info": "Replaces the built-in SW mark and the text logo. Leave empty to use them."
        },
        "logo_style": {
          "label": "Logo style",
          "info": "Used when no logo image is uploaded.",
          "options": {
            "mark_and_wordmark": "SW mark and name",
            "mark": "SW mark only",
            "wordmark": "Name only"
          }
        },
        "logo_width": {
          "label": "Logo width"
        },
        "wordmark_start": {
          "label": "Text logo: first part"
        },
        "wordmark_end": {
          "label": "Text logo: highlighted part"
        },
        "accent": {
          "label": "Brand accent",
          "info": "Used for badges, the text logo and highlights. If you change it, update the color schemes that use it too."
        },
        "browser_theme_color": {
          "label": "Mobile browser bar color"
        },
        "favicon": {
          "label": "Favicon",
          "info": "Shown at 32 × 32 px"
        },
        "share_image": {
          "label": "Social sharing image",
          "info": "Shown when a page without its own image is shared. 1200 × 628 px recommended."
        }
      }
    },
    "colors": {
      "name": "Colors",
      "settings": {
        "background": {
          "label": "Background"
        },
        "surface": {
          "label": "Surface (cards, fields, chips)"
        },
        "border": {
          "label": "Borders"
        },
        "text": {
          "label": "Text"
        },
        "muted": {
          "label": "Secondary text"
        },
        "highlight": {
          "label": "Highlight",
          "info": "Accent used for selected states and highlights"
        },
        "on_highlight": {
          "label": "Text on highlight"
        },
        "button": {
          "label": "Primary button"
        },
        "button_label": {
          "label": "Primary button text"
        },
        "secondary_button_label": {
          "label": "Secondary button and links"
        },
        "sale": {
          "label": "Sale price"
        },
        "defaults": {
          "content": "Defaults"
        },
        "body_color_scheme": {
          "label": "Page background"
        },
        "drawer_color_scheme": {
          "label": "Drawers and pop-ups"
        },
        "background_gradient": {
          "label": "Background gradient",
          "info": "Optional. Replaces the background color when set."
        }
      }
    },
    "typography": {
      "name": "Typography",
      "settings": {
        "fonts_info": {
          "content": "The theme uses its own fonts for Hebrew, English and Arabic."
        },
        "body_scale": {
          "label": "Body text size"
        },
        "heading_scale": {
          "label": "Heading size"
        },
        "uppercase_latin_headings": {
          "label": "Uppercase English headings"
        }
      }
    },
    "layout": {
      "name": "Layout",
      "settings": {
        "page_width": {
          "label": "Page width",
          "options": {
            "narrow": "Narrow (1200 px)",
            "normal": "Normal (1440 px)",
            "wide": "Wide (1680 px)"
          }
        },
        "radius_card": {
          "label": "Card corner radius"
        },
        "radius_button": {
          "label": "Button corner radius"
        }
      }
    },
    "product_cards": {
      "name": "Product cards",
      "settings": {
        "card_subtitle": {
          "label": "Line above the product title",
          "options": {
            "team": "Team",
            "vendor": "Brand",
            "none": "None"
          }
        },
        "card_image_ratio": {
          "label": "Image shape",
          "options": {
            "square": "Square",
            "portrait": "Portrait (4:5)",
            "tall": "Tall (3:4)"
          }
        },
        "card_image_fit": {
          "label": "Image fit",
          "info": "\"Fit\" shows the whole product on a light background. \"Fill\" crops to fill the tile.",
          "options": {
            "contain": "Fit",
            "cover": "Fill"
          }
        },
        "card_secondary_image": {
          "label": "Show second image on hover"
        },
        "card_show_sale_badge": {
          "label": "Show sale badge"
        },
        "card_new_tag": {
          "label": "Tag for the \"New\" badge",
          "info": "Products with this tag get the \"New\" badge."
        }
      }
    },
    "cart": {
      "name": "Cart",
      "settings": {
        "cart_type": {
          "label": "Cart type",
          "options": {
            "drawer": "Drawer",
            "page": "Page"
          }
        },
        "free_shipping_threshold": {
          "label": "Free shipping from (₪)",
          "info": "Controls every free-shipping message (announcement bar, trust badges, product page, cart, FAQ). 0 = free shipping on every order: the cart shows a short line instead of the progress bar. Above 0 = free shipping from that amount, with the progress bar. Empty = no free-shipping messages. Shown to visitors in Israel only; must match Settings > Shipping."
        },
        "cart_show_upsell": {
          "label": "Suggest set items in the cart"
        },
        "cart_show_note": {
          "label": "Allow order notes"
        }
      }
    },
    "contact": {
      "name": "Business details",
      "settings": {
        "info": {
          "content": "Shown in the footer, on the contact page and in the accessibility statement. Israeli law requires sellers to publish these details."
        },
        "business_name": {
          "label": "Business name"
        },
        "business_id": {
          "label": "Business ID (עוסק / ח.פ.)"
        },
        "business_address": {
          "label": "Address"
        },
        "support_phone": {
          "label": "Phone"
        },
        "support_email": {
          "label": "Email"
        },
        "whatsapp_number": {
          "label": "WhatsApp number",
          "info": "International format without +, for example 972501234567"
        }
      }
    },
    "social": {
      "name": "Social media",
      "settings": {
        "instagram": {
          "label": "Instagram"
        },
        "tiktok": {
          "label": "TikTok"
        },
        "facebook": {
          "label": "Facebook"
        },
        "youtube": {
          "label": "YouTube"
        }
      }
    },
    "search": {
      "name": "Search",
      "settings": {
        "predictive_search": {
          "label": "Show suggestions while typing"
        }
      }
    }
  },
  "sections": {
    "groups": {
      "header": "Header",
      "footer": "Footer"
    },
    "cart_bubble": {
      "name": "Cart count"
    }
