{%- comment -%}
  Site header (header group): the banner landmark with the logo, the main menu, search, account,
  language and cart.
  The logo sits in the center of the bar at every width.
  - Below 1200px: menu button, centered logo and cart, with the search field as a full-width bar
    under them. The menu button opens the menu drawer (snippets/menu-drawer, id MenuDrawer) with
    drill-down category panels.
  - Desktop (1200px and up): the main menu (snippets/header-menu) at the start, whose top-level links
    with sub-links open full-width mega panels (snippets/header-mega-panel); the logo in the center;
    then the search field, account, language and cart at the end. The two sides share the width
    equally, so the logo stays centered.
  The search field (snippets/header-search) is one real form for every width: it submits to the
  search page, and shows suggestions under the field while typing.
  "Hide empty categories" leaves links to collections without products out of the menu, the mega
  panels and the drawer on the storefront; the theme editor always shows the whole menu.
  Blocks: "Mega menu promo" shows a promo card in the mega panel of the menu item that links to its
  collection, in place of the featured products.
  assets/header.js (<sw-header>) keeps --header-height up to date, hides the header while scrolling
  down when "Sticky header" is "When scrolling up", and runs the mega menu (hover intent, one panel
  at a time, Escape, outside clicks, closing when the header hides).
{%- endcomment -%}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id
  assign mega_scheme = section.settings.mega_color_scheme.id | default: 'scheme-day'
  assign menu = section.settings.menu

  # Positions of the menu links to leave out, shared by the desktop menu and the menu drawer:
  # ",4,1-3,2-5-1," is the 4th top-level link, the 3rd sub-link of the 1st and so on. A link to a
  # collection without products is left out unless one of its own sub-links still leads somewhere.
  # Only on the storefront: in the theme editor the owner sees the whole menu.
  assign hidden_links = ','
  assign visible_links = menu.links.size
  if section.settings.hide_empty_collections and request.design_mode != true
    assign visible_links = 0
    for link in menu.links
      assign link_index = forloop.index
      assign link_visible_children = 0
      for child in link.links
        assign child_key = link_index | append: '-' | append: forloop.index
        assign child_visible_children = 0
        for grandchild in child.links
          assign grandchild_empty = false
          if grandchild.type == 'collection_link'
            if grandchild.object.all_products_count == 0
              assign grandchild_empty = true
            endif
          endif
          if grandchild_empty
            assign hidden_links = hidden_links | append: child_key | append: '-' | append: forloop.index | append: ','
          else
            assign child_visible_children = child_visible_children | plus: 1
          endif
        endfor

        assign child_empty = false
        if child.type == 'collection_link' and child_visible_children == 0
          if child.object.all_products_count == 0
            assign child_empty = true
          endif
        endif
        if child_empty
          assign hidden_links = hidden_links | append: child_key | append: ','
        else
          assign link_visible_children = link_visible_children | plus: 1
        endif
      endfor

      assign link_empty = false
      if link.type == 'collection_link' and link_visible_children == 0
        if link.object.all_products_count == 0
          assign link_empty = true
        endif
      endif
      if link_empty
        assign hidden_links = hidden_links | append: link_index | append: ','
      else
        assign visible_links = visible_links | plus: 1
      endif
    endfor
  endif
-%}
<sw-header class="header-root" data-sticky="{{ section.settings.sticky }}">
  <header class="header color-{{ color_scheme }}">
    <div class="header__inner">
      <div class="header__start">
        {%- comment -%}
          commandfor/command open the menu natively where JavaScript is off; with JavaScript, the
          <sw-drawer> click handler in @theme/core takes over (focus return, aria-expanded).
        {%- endcomment -%}
        <button
          type="button"
          class="header__icon"
          data-drawer-open="MenuDrawer"
          aria-haspopup="dialog"
          aria-expanded="false"
          commandfor="MenuDrawerDialog"
          command="show-modal"
        >
          {%- render 'icon', name: 'menu', size: 24 -%}
          <span class="visually-hidden">{{ 'header.menu.open' | t }}</span>
        </button>
      </div>

      <div class="header__logo">
        {%- render 'logo' -%}
      </div>

      {%- if visible_links > 0 -%}
        <div class="header__nav">
          {%- render 'header-menu',
            menu: menu,
            hidden_links: hidden_links,
            mega_scheme: mega_scheme,
            show_featured: section.settings.show_featured_products,
            promos: section.blocks
          -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        Below 1200px this wrapper steps out of the layout (display: contents): the search field takes
        the full-width row under the bar and the actions stay in the end column.
      {%- endcomment -%}
      <div class="header__end">
        {%- render 'header-search' -%}

        <div class="header__actions">
          <div class="header__desktop-actions">
            {%- if shop.customer_accounts_enabled -%}
              <a href="{{ routes.account_url }}" class="header__icon">
                {%- render 'icon', name: 'user', size: 23 -%}
                <span class="visually-hidden">
                  {%- if customer -%}
                    {{- 'header.account.account' | t -}}
                  {%- else -%}
                    {{- 'header.account.log_in' | t -}}
                  {%- endif -%}
                </span>
              </a>
            {%- endif -%}
            {%- render 'localization-switcher', id: 'HeaderLocalization', style: 'compact' -%}
          </div>

          <a
            href="{{ routes.cart_url }}"
            class="header__icon header__cart"
            {% if settings.cart_type == 'drawer' and request.page_type != 'cart' %}
              data-drawer-open="CartDrawer" aria-haspopup="dialog" aria-expanded="false"
            {% endif %}
          >
            {%- render 'icon', name: 'bag', size: 23 -%}
            <span data-cart-bubble>{% render 'cart-bubble' %}</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  {%- comment -%}
    Dims the page under an open mega panel or search panel; a click on it closes the panel
    (assets/header.js, assets/predictive-search.js).
  {%- endcomment -%}
  <div class="header__overlay" aria-hidden="true"></div>

  {%- render 'menu-drawer',
    menu: menu,
    hidden_links: hidden_links,
    visible_links: visible_links,
    color_scheme: color_scheme
  -%}
</sw-header>

<script type="module" src="{{ 'header.js' | asset_url }}"></script>
<script type="module" src="{{ 'predictive-search.js' | asset_url }}"></script>

{% stylesheet %}
  .header-section {
    position: relative;
    z-index: var(--z-header);
    transition: transform var(--duration) var(--ease);
  }

  .header-section:has(> .header-root[data-sticky='always']),
  .header-section:has(> .header-root[data-sticky='scroll-up']) {
    position: sticky;
    inset-block-start: 0;
  }

  .header-section[data-header-hidden] {
    transform: translateY(-100%);
  }

  .header-root {
    display: block;
  }

  .header {
    position: relative;
    border-block-end: 1px solid var(--color-border);
  }

  /* Below 1200px: menu, logo and cart on a 60px row, the search field on a row of its own under them
     (44px field + 8px, 16px from the screen edges). */
  .header__inner {
    display: grid;
    grid-template-areas:
      'start logo end'
      'search search search';
    grid-template-columns: minmax(var(--touch-target), 1fr) auto minmax(var(--touch-target), 1fr);
    grid-template-rows: 60px auto;
    align-items: center;
    column-gap: var(--space-2);
    max-inline-size: calc(var(--page-width, 1440px) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--space-2);

    /* Menu and actions share the sides equally, so the logo sits in the exact center. */
    @media screen and (min-width: 1200px) {
      --header-bar-height: 72px;

      grid-template-areas: 'nav logo end';
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-rows: auto;
      column-gap: 28px;
      min-block-size: var(--header-bar-height);
      padding-inline: var(--gutter);
    }

    @media screen and (min-width: 1400px) {
      column-gap: var(--space-8);
    }
  }

  .header__start {
    display: flex;
    grid-area: start;
    align-items: center;

    @media screen and (min-width: 1200px) {
      display: none;
    }
  }

  .header__logo {
    --logo-mark-size: 30px;

    display: flex;
    grid-area: logo;
    justify-content: center;
    min-inline-size: 0;

    @media screen and (min-width: 1200px) {
      --logo-mark-size: 36px;
    }
  }

  /* The nav fills the height of the bar, so every top-level link is a full-height target. */
  .header__nav {
    display: none;
    grid-area: nav;
    align-self: stretch;
    justify-self: start;
    min-inline-size: 0;

    @media screen and (min-width: 1200px) {
      display: flex;
    }
  }

  /* A layout-free wrapper below 1200px (its children are grid items of the bar); the end column
     from 1200px: the search field, then the icons. */
  .header__end {
    display: contents;

    @media screen and (min-width: 1200px) {
      display: flex;
      grid-area: end;
      align-items: center;
      justify-content: flex-end;
      min-inline-size: 0;
    }
  }

  .header__actions {
    display: flex;
    grid-area: end;
    align-items: center;
    justify-content: flex-end;
    justify-self: end;
    gap: 2px;

    @media screen and (min-width: 1200px) {
      flex-shrink: 0;
    }
  }

  .header__desktop-actions {
    display: none;

    @media screen and (min-width: 1200px) {
      display: flex;
      align-items: center;
      gap: 2px;
    }
  }

  .header__icon {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    inline-size: var(--touch-target);
    block-size: var(--touch-target);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease);

    &:hover {
      background: color-mix(in srgb, currentColor 10%, transparent);
    }
  }

  /* Dims the page under an open mega panel or search panel. It sits under the header bar (z-index -1
     inside the header's stacking context) and only shows once the scripts run, so it can always close. */
  .header__overlay {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--color-overlay);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--duration) var(--ease),
      visibility 0s linear var(--duration);
  }

  .header-root:defined:has(.header-menu__details[open]) .header__overlay {
    opacity: 0.8;
    visibility: visible;
    pointer-events: auto;
    transition: opacity var(--duration) var(--ease);
  }

  /* The search panel dims the page on wide screens; below 1200px its sheet covers the page anyway. */
  @media screen and (min-width: 1200px) {
    .header-root:defined:has(.header-search[data-open]) .header__overlay {
      opacity: 0.8;
      visibility: visible;
      pointer-events: auto;
      transition: opacity var(--duration) var(--ease);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "div",
  "class": "header-section",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.header.settings.info.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-night"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu",
      "info": "t:sections.header.settings.menu.info",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "t:sections.header.settings.sticky.label",
      "default": "scroll-up",
      "options": [
        {
          "value": "none",
          "label": "t:sections.header.settings.sticky.options.none"
        },
        {
          "value": "always",
          "label": "t:sections.header.settings.sticky.options.always"
        },
        {
          "value": "scroll-up",
          "label": "t:sections.header.settings.sticky.options.scroll_up"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.mega_menu.content"
    },
    {
      "type": "color_scheme",
      "id": "mega_color_scheme",
      "label": "t:sections.header.settings.mega_color_scheme.label",
      "default": "scheme-day"
    },
    {
      "type": "checkbox",
      "id": "hide_empty_collections",
      "label": "t:sections.header.settings.hide_empty_collections.label",
      "info": "t:sections.header.settings.hide_empty_collections.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_featured_products",
      "label": "t:sections.header.settings.show_featured_products.label",
      "info": "t:sections.header.settings.show_featured_products.info",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "t:sections.header.blocks.mega_promo.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.header.blocks.mega_promo.settings.info.content"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.header.blocks.mega_promo.settings.collection.label",
          "info": "t:sections.header.blocks.mega_promo.settings.collection.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:settings.eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:settings.button_label",
          "info": "t:settings.default_text_info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.header.name"
    }
  ]
}
{% endschema %}
