{%- comment -%}
  Collections list page (/collections): heading (the page's h1) and a grid of collection cards
  (image on the light tile, title, product count). Shows the hand-picked collections when set,
  otherwise every collection: A to Z across pages, or another order for up to 50 collections.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'collections.list_title' | t
  endif

  assign picked = section.settings.collections
  assign sorted = null
  if picked == blank
    case section.settings.sort
      when 'alphabetical_reversed'
        assign sorted = collections | sort_natural: 'title' | reverse
      when 'products_high'
        assign sorted = collections | sort: 'all_products_count' | reverse
      when 'products_low'
        assign sorted = collections | sort: 'all_products_count'
      when 'date'
        assign sorted = collections | sort: 'published_at' | reverse
      when 'date_reversed'
        assign sorted = collections | sort: 'published_at'
    endcase
  endif

  case section.settings.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '1 / 1'
  endcase

  assign cols_desktop = section.settings.columns_desktop
  assign cols_mobile = section.settings.columns_mobile | plus: 0
  assign desktop_space = cols_desktop | minus: 1 | times: 20
  assign mobile_size = 'calc((100vw - 52px) / 2)'
  if cols_mobile == 1
    assign mobile_size = 'calc(100vw - 40px)'
  endif
  assign card_sizes = '(min-width: 990px) calc((min(100vw - 64px, ' | append: settings.page_width | append: 'px) - ' | append: desktop_space | append: 'px) / ' | append: cols_desktop | append: '), (min-width: 750px) calc((100vw - 104px) / 3), ' | append: mobile_size
-%}
<div
  class="section main-list-collections color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <h1 class="list-collections__title display-l">{{ heading | escape }}</h1>

    {%- paginate collections by section.settings.per_page -%}
      {%- liquid
        assign paginated = false
        if picked != blank
          assign source = picked
        elsif sorted != blank
          assign source = sorted
        else
          assign source = collections
          assign paginated = true
        endif
        assign shown = 0
      -%}
      <ul
        class="grid list-collections__grid"
        role="list"
        style="--grid-cols: {{ cols_mobile }}; --grid-cols-tablet: 3; --grid-cols-desktop: {{ cols_desktop }}; --media-ratio: {{ ratio }};"
      >
        {%- for collection in source limit: 50 -%}
          {%- if section.settings.hide_empty and collection.all_products_count == 0 -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="list-collections__item">
            <article class="collection-card">
              <div class="collection-card__media media-tile">
                {%- render 'image',
                  image: collection.featured_image,
                  sizes: card_sizes,
                  widths: '240, 360, 480, 720, 960',
                  alt: '',
                  class: 'collection-card__image',
                  placeholder: 'collection-1'
                -%}
              </div>
              <div class="collection-card__info">
                <h2 class="collection-card__title">
                  <a class="collection-card__link" href="{{ collection.url }}">{{ collection.title | escape }}</a>
                </h2>
                {%- if section.settings.show_count -%}
                  <p class="collection-card__count">
                    {{- 'collections.product_count' | t: count: collection.all_products_count -}}
                  </p>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}

        {%- if shown == 0 and request.design_mode -%}
          {%- for i in (1..4) -%}
            <li class="list-collections__item">
              <article class="collection-card">
                <div class="collection-card__media media-tile">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg collection-card__image' }}
                </div>
                <div class="collection-card__info">
                  <h2 class="collection-card__title">{{ 'collections.list_title' | t }}</h2>
                </div>
              </article>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- if shown == 0 and request.design_mode == false -%}
        <p class="list-collections__empty">{{ 'collections.list_empty' | t }}</p>
      {%- endif -%}

      {%- if paginated -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .list-collections__title {
    margin-block-end: var(--space-8);
    overflow-wrap: anywhere;
  }

  .list-collections__grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list-collections__item {
    display: flex;
    min-inline-size: 0;

    & > * {
      flex: 1 1 auto;
    }
  }

  .list-collections__empty {
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .collection-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-inline-size: 0;
  }

  .collection-card__media {
    isolation: isolate;
  }

  .collection-card__image {
    transition: transform var(--duration) var(--ease);
  }

  @media (hover: hover) {
    .collection-card:hover .collection-card__image {
      transform: scale(1.03);
    }
  }

  .collection-card__info {
    display: grid;
    gap: 2px;
  }

  .collection-card__title {
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    overflow-wrap: anywhere;
  }

  .collection-card__link {
    color: inherit;
    text-decoration: none;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 2;
    }

    &:focus-visible {
      outline: none;

      &::after {
        outline: 2px solid var(--color-text);
        outline-offset: 3px;
        border-radius: var(--radius-card);
      }
    }
  }

  .collection-card__count {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main_list_collections.headers.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:settings.collections",
      "info": "t:sections.main_list_collections.settings.collections.info",
      "limit": 50
    },
    {
      "type": "select",
      "id": "sort",
      "label": "t:sections.main_list_collections.settings.sort.label",
      "info": "t:sections.main_list_collections.settings.sort.info",
      "options": [
        {
          "value": "alphabetical",
          "label": "t:sections.main_list_collections.settings.sort.options.alphabetical"
        },
        {
          "value": "alphabetical_reversed",
          "label": "t:sections.main_list_collections.settings.sort.options.alphabetical_reversed"
        },
        {
          "value": "products_high",
          "label": "t:sections.main_list_collections.settings.sort.options.products_high"
        },
        {
          "value": "products_low",
          "label": "t:sections.main_list_collections.settings.sort.options.products_low"
        },
        {
          "value": "date",
          "label": "t:sections.main_list_collections.settings.sort.options.date"
        },
        {
          "value": "date_reversed",
          "label": "t:sections.main_list_collections.settings.sort.options.date_reversed"
        }
      ],
      "default": "alphabetical"
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "t:sections.main_list_collections.settings.hide_empty.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.main_list_collections.settings.show_count.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_list_collections.headers.layout"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.main_list_collections.settings.image_ratio.label",
      "options": [
        {
          "value": "square",
          "label": "t:sections.main_list_collections.settings.image_ratio.options.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.main_list_collections.settings.image_ratio.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:sections.main_list_collections.settings.image_ratio.options.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "label": "t:sections.main_list_collections.settings.per_page.label",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:settings.columns_desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        { "value": "1", "label": "t:options.columns.one" },
        { "value": "2", "label": "t:options.columns.two" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "t:sections.main_list_collections.headers.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
