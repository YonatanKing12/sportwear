{%- comment -%}
  "Complete the set" (home): a jersey and the shorts of the same team, bought together. Each set is a
  block (a jersey and shorts product). With more than one set, team tabs switch between them; a tab is
  named after the jersey's team category (its team: tag), in every language. A set shows both products
  on one photo tile, a size choice for each, the total, and one button that adds both to the cart and
  opens the cart drawer (assets/set-builder.js, <sw-set-builder>). Choosing the jersey's size also picks
  it for the shorts while they have none.
  Without JavaScript every set is a plain cart form (items[0], items[1]) and all sets show, one under the
  other. Sets whose jersey or shorts is missing or sold out are left out.
{%- endcomment -%}
{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme.id

  assign eyebrow = section.settings.eyebrow | escape
  if eyebrow == blank
    assign eyebrow = 'home.promo_banner.eyebrow' | t
  endif

  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = 'home.promo_banner.heading' | t
  endif

  assign text = section.settings.text
  if text == blank
    assign text = 'home.promo_banner.text' | t
  endif

  assign link_label = section.settings.button_label | escape
  if link_label == blank
    assign link_label = 'home.promo_banner.button_label' | t
  endif
  assign link_url = section.settings.button_link | default: routes.all_products_collection_url

  # The sets that can be sold: both products chosen and in stock.
  assign set_ids = ','
  assign set_count = 0
  for block in section.blocks
    assign jersey = block.settings.jersey
    assign shorts = block.settings.shorts
    if jersey != blank and shorts != blank and jersey.available and shorts.available
      assign set_ids = set_ids | append: block.id | append: ','
      assign set_count = set_count | plus: 1
    endif
  endfor

  assign jersey_label = 'home.promo_banner.jersey' | t
  assign shorts_label = 'home.promo_banner.shorts' | t
  assign jersey_legend = 'home.promo_banner.jersey_size' | t
  assign shorts_legend = 'home.promo_banner.shorts_size' | t
  assign note_template = 'home.promo_banner.matched' | t: size: '[size]'

  # The kit tile is the full panel width on phones (100vw less the gutters and the panel padding) and
  # about half of it from 750px; the jersey takes 56% of the tile, the shorts 42%.
  assign jersey_sizes = '(min-width: 1440px) 380px, (min-width: 750px) 27vw, calc((100vw - 72px) * 0.56)'
  assign shorts_sizes = '(min-width: 1440px) 280px, (min-width: 750px) 20vw, calc((100vw - 72px) * 0.42)'
-%}

<div
  class="section set-builder"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <sw-set-builder class="set-builder__panel {{ scheme_class }}">
      <div class="set-builder__top">
        <div class="set-builder__intro">
          {%- if section.settings.show_eyebrow -%}
            <p class="set-builder__eyebrow eyebrow">{{ eyebrow }}</p>
          {%- endif -%}
          <h2 class="set-builder__heading display-l">{{ heading }}</h2>
          <p class="set-builder__text">{{ text }}</p>
        </div>

        {%- if set_count > 1 -%}
          <div class="set-builder__tabs js-only" role="tablist" aria-label="{{ 'home.promo_banner.tabs_label' | t }}">
            {%- assign first_tab = true -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_key = ',' | append: block.id | append: ','
                unless set_ids contains block_key
                  continue
                endunless
                capture team_name
                  render 'set-team-name', jersey: block.settings.jersey
                endcapture
              -%}
              <button
                type="button"
                role="tab"
                class="chip set-builder__tab"
                id="SetTab-{{ block.id }}"
                aria-controls="SetPanel-{{ block.id }}"
                aria-selected="{{ first_tab }}"
                tabindex="{% if first_tab %}0{% else %}-1{% endif %}"
                data-set-tab
              >
                {{- team_name -}}
              </button>
              {%- assign first_tab = false -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- assign first_set = true -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_key = ',' | append: block.id | append: ','
          unless set_ids contains block_key
            continue
          endunless
          assign jersey = block.settings.jersey
          assign shorts = block.settings.shorts
          assign total = jersey.price | plus: shorts.price
          assign jersey_prefix = 'Set-' | append: block.id | append: '-0'
          assign shorts_prefix = 'Set-' | append: block.id | append: '-1'
        -%}
        <form
          class="set-builder__set"
          id="SetPanel-{{ block.id }}"
          action="{{ routes.cart_add_url }}"
          method="post"
          {% if set_count > 1 %}
            role="tabpanel"
            aria-labelledby="SetTab-{{ block.id }}"
          {% endif %}
          {% unless first_set %}
            data-set-hidden
          {% endunless %}
          data-set-panel
          data-added-message="{{ 'home.promo_banner.added' | t | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if set_count > 1 -%}
            <h3 class="set-builder__set-title no-js-only">
              {%- render 'set-team-name', jersey: jersey -%}
            </h3>
          {%- endif -%}

          <div class="set-builder__kit">
            <a class="set-builder__kit-jersey" href="{{ jersey.url }}" tabindex="-1" aria-hidden="true">
              {%- render 'image',
                image: jersey.featured_media.preview_image,
                sizes: jersey_sizes,
                widths: '240, 360, 480, 640, 800',
                alt: ''
              -%}
            </a>
            <a class="set-builder__kit-shorts" href="{{ shorts.url }}" tabindex="-1" aria-hidden="true">
              {%- render 'image',
                image: shorts.featured_media.preview_image,
                sizes: shorts_sizes,
                widths: '180, 280, 360, 480, 640',
                alt: ''
              -%}
            </a>
          </div>

          <div class="set-builder__buy color-scheme-day">
            {%- render 'set-item',
              product: jersey,
              index: 0,
              role: jersey_label,
              legend: jersey_legend,
              id_prefix: jersey_prefix
            -%}
            {%- render 'set-item',
              product: shorts,
              index: 1,
              role: shorts_label,
              legend: shorts_legend,
              id_prefix: shorts_prefix,
              note_template: note_template
            -%}
            <p class="set-builder__total">
              <span>{{ 'home.promo_banner.total' | t }}</span>
              <span class="set-builder__total-price">{{ total | money_without_trailing_zeros }}</span>
            </p>
            <p
              class="set-builder__error"
              role="alert"
              data-set-error
              data-both-message="{{ 'home.promo_banner.choose_both' | t | escape }}"
              data-jersey-message="{{ 'home.promo_banner.choose_jersey' | t | escape }}"
              data-shorts-message="{{ 'home.promo_banner.choose_shorts' | t | escape }}"
            ></p>
            <button type="submit" class="button button--primary button--full set-builder__add" data-set-add>
              {{- 'home.promo_banner.add' | t -}}
            </button>
          </div>
        </form>
        {%- assign first_set = false -%}
      {%- endfor -%}

      {%- if set_count == 0 and request.design_mode -%}
        <p class="set-builder__editor-note">{{ 'home.promo_banner.editor_note' | t }}</p>
      {%- endif -%}

      <a class="set-builder__link link link-arrow" href="{{ link_url }}">
        <span>{{ link_label }}</span>
        {%- render 'icon', name: 'arrow-forward', size: 18 -%}
      </a>
    </sw-set-builder>
  </div>
</div>

<script type="module" src="{{ 'set-builder.js' | asset_url }}"></script>

{% stylesheet %}
  /* Phones: the pitch, the team tabs, the photo tile, then the white card with the sizes and the button. */
  .set-builder__panel {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-card);
  }

  .set-builder__top {
    display: grid;
    gap: var(--space-4);
  }

  .set-builder__heading {
    margin-block-start: var(--space-2);
    overflow-wrap: break-word;

    @media screen and (max-width: 749px) {
      font-size: calc(40px * var(--heading-scale, 1) * var(--display-lang-scale));
    }
  }

  .set-builder__text {
    max-inline-size: 34em;
    margin-block-start: var(--space-3);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.5;
  }

  /* Team tabs: one row of chips that scrolls sideways on narrow screens, out to the panel's edges. */
  .set-builder__tabs {
    display: flex;
    gap: var(--space-2);
    margin-inline: calc(var(--space-5) * -1);
    padding-inline: var(--space-5);
    overflow-x: auto;
    scroll-padding-inline: var(--space-5);
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .set-builder__tab {
    flex: none;
    cursor: pointer;

    &[aria-selected='true'] {
      border-color: var(--color-text);
      background: var(--color-text);
      color: var(--color-background);
      font-weight: 700;
    }
  }

  /* With JavaScript only the chosen set shows; without it, every set shows under its team's name. */
  .js .set-builder__set[data-set-hidden] {
    display: none;
  }

  .set-builder__set {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  .set-builder__set-title {
    font-size: var(--text-lg);
    font-weight: 800;
  }

  /* One tile for the set, like a flat lay: the jersey at the top start, the shorts at the bottom end,
     side by side (never overlapping, so neither photo's background can cover the other garment). The
     tile is the studio photos' background as the CDN serves it (#f4f4f4 comes back as #f5f5f5 in WebP),
     so the two photos read as one picture. */
  .set-builder__kit {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #f5f5f5;
  }

  /* Each photo fades out over its outer 2.5%, so a photo whose background is a shade lighter than the
     tile (photos made before the studio line) shows no edge. */
  .set-builder__kit-jersey,
  .set-builder__kit-shorts {
    position: absolute;
    display: block;
    mask-image:
      linear-gradient(to right, transparent, #000 2.5%, #000 97.5%, transparent),
      linear-gradient(to bottom, transparent, #000 2.5%, #000 97.5%, transparent);
    mask-composite: intersect;

    & img {
      display: block;
      inline-size: 100%;
      block-size: auto;
    }
  }

  .set-builder__kit-jersey {
    inset-block-start: 1%;
    inset-inline-start: 1%;
    inline-size: 56%;
  }

  .set-builder__kit-shorts {
    inset-block-end: 1%;
    inset-inline-end: 1%;
    inline-size: 42%;
  }

  .set-builder__buy {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius-card);
    background: var(--color-background);
    color: var(--color-text);
  }

  .set-builder__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--text-md);
    font-weight: 800;
  }

  .set-builder__total-price {
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums;
  }

  .set-builder__error {
    color: var(--color-error);
    font-size: var(--text-md);
    font-weight: 700;

    &:empty {
      margin-block-start: calc(var(--space-4) * -1);
    }
  }

  .set-builder__link {
    justify-self: start;
  }

  .set-builder__editor-note {
    font-weight: 700;
  }

  /* From 750px: the photo tile and the card side by side. */
  @media screen and (min-width: 750px) {
    .set-builder__panel {
      padding: var(--space-8) var(--space-8);
    }

    .set-builder__set {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-6);
    }

    .set-builder__buy {
      padding: var(--space-6);
    }

    .set-builder__text {
      font-size: var(--text-lg);
    }
  }

  /* From 990px: the pitch and the team tabs share the top row. */
  @media screen and (min-width: 990px) {
    .set-builder__panel {
      gap: var(--space-6);
      padding: var(--space-10) var(--space-12);
    }

    .set-builder__top {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: var(--space-8);
    }

    .set-builder__tabs {
      margin-inline: 0;
      padding-inline: 0;
    }

    .set-builder__set {
      gap: var(--space-10);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.promo_banner.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-accent"
    },
    {
      "type": "header",
      "content": "t:sections.promo_banner.headers.content"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "t:sections.promo_banner.settings.show_eyebrow.label",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "info": "t:settings.default_text_info",
      "visible_if": "{{ section.settings.show_eyebrow }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.promo_banner.settings.button_label.label",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.button_link",
      "info": "t:sections.promo_banner.settings.button_link.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "t:sections.promo_banner.blocks.set.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.promo_banner.blocks.set.settings.info.content"
        },
        {
          "type": "product",
          "id": "jersey",
          "label": "t:sections.promo_banner.blocks.set.settings.jersey.label"
        },
        {
          "type": "product",
          "id": "shorts",
          "label": "t:sections.promo_banner.blocks.set.settings.shorts.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo_banner.name",
      "blocks": [
        {
          "type": "set"
        }
      ]
    }
  ]
}
{% endschema %}
