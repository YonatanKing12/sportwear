{%- comment -%}
  Promo banner (home): a compact panel that pairs two products, e.g. a jersey and the shorts of the
  same team, shown as regular product cards with a "+" between them, next to a short pitch and one
  button. Without products it shows the text and the button only; in the theme editor, empty
  product slots show placeholder cards.
{%- endcomment -%}
{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme.id
  assign full_width = section.settings.full_width

  assign eyebrow = section.settings.eyebrow | escape
  if eyebrow == blank
    assign eyebrow = 'home.promo_banner.eyebrow' | t
  endif

  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = 'home.promo_banner.heading' | t
  endif

  assign text = section.settings.text
  if text == blank
    assign text = 'home.promo_banner.text' | t
  endif

  assign button_label = section.settings.button_label | escape
  if button_label == blank
    assign button_label = 'home.promo_banner.button_label' | t
  endif
  assign button_link = section.settings.button_link | default: routes.all_products_collection_url

  assign product_1 = section.settings.product_1
  assign product_2 = section.settings.product_2
  assign set_count = 0
  if product_1 != blank
    assign set_count = set_count | plus: 1
  endif
  if product_2 != blank
    assign set_count = set_count | plus: 1
  endif

  assign show_placeholders = false
  if set_count == 0 and request.design_mode
    assign show_placeholders = true
  endif

  # A card is 180px wide from 990px, 160px on tablets, and half the panel on phones
  # (100vw less the page gutters, the panel padding and the gap that holds the "+").
  assign card_sizes = '(min-width: 990px) 180px, (min-width: 750px) 160px, calc((100vw - 108px) / 2)'

  assign card_loading = 'lazy'
  unless section.index > 2
    assign card_loading = 'eager'
  endunless
-%}

<div
  class="section promo-banner{% if full_width %} promo-banner--full {{ scheme_class }}{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="promo-banner__panel{% unless full_width %} {{ scheme_class }}{% endunless %}{% if set_count > 0 or show_placeholders %} promo-banner__panel--set{% endif %}">
      <div class="promo-banner__content">
        {%- if section.settings.show_eyebrow -%}
          <p class="promo-banner__eyebrow eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        <h2 class="promo-banner__heading display-l">{{ heading }}</h2>
        <p class="promo-banner__text">{{ text }}</p>
      </div>

      {%- if set_count > 0 or show_placeholders -%}
        <ul class="promo-banner__set{% if set_count == 1 %} promo-banner__set--single{% endif %}" role="list">
          {%- if show_placeholders -%}
            <li class="promo-banner__item">
              {%- render 'product-card', product: blank, sizes: card_sizes -%}
            </li>
            <li class="promo-banner__item">
              {%- render 'product-card', product: blank, sizes: card_sizes -%}
            </li>
          {%- else -%}
            {%- if product_1 != blank -%}
              <li class="promo-banner__item">
                {%- render 'product-card', product: product_1, sizes: card_sizes, loading: card_loading -%}
              </li>
            {%- endif -%}
            {%- if product_2 != blank -%}
              <li class="promo-banner__item">
                {%- render 'product-card', product: product_2, sizes: card_sizes, loading: card_loading -%}
              </li>
            {%- endif -%}
          {%- endif -%}
        </ul>
      {%- endif -%}

      <a class="button button--primary promo-banner__button" href="{{ button_link }}">{{ button_label }}</a>
    </div>
  </div>
</div>

{% stylesheet %}
  /* Phones: the pitch, the two cards side by side, then a full-width button. */
  .promo-banner__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'content' 'set' 'button';
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-card);
  }

  .promo-banner--full .promo-banner__panel {
    padding-inline: 0;
    border-radius: 0;
  }

  .promo-banner__content {
    grid-area: content;
  }

  .promo-banner__heading {
    margin-block-start: var(--space-2);
    overflow-wrap: break-word;

    @media screen and (max-width: 749px) {
      font-size: calc(40px * var(--heading-scale, 1) * var(--display-lang-scale));
    }
  }

  .promo-banner__text {
    max-inline-size: 34em;
    margin-block-start: var(--space-3);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.5;
  }

  /* The two cards with a "+" in the gap between them. Square tiles keep the banner short (supplier
     photos are square). */
  .promo-banner__set {
    --set-gap: 36px;
    --card-ratio: 1 / 1;
    grid-area: set;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--set-gap);
    margin-block-start: var(--space-5);
  }

  .promo-banner__set--single {
    grid-template-columns: minmax(0, 1fr);
    max-inline-size: 240px;
  }

  .promo-banner__item {
    position: relative;
    min-inline-size: 0;
  }

  /* The "+" is centred in the gap and on the image tile: a percentage margin resolves against the
     card's width, and the tile is that width divided by the card ratio (theme setting). */
  .promo-banner__item + .promo-banner__item::before {
    content: '+';
    content: '+' / '';
    position: absolute;
    z-index: 2;
    inset-block-start: 0;
    inset-inline-start: calc(var(--set-gap) / -2 - 16px);
    margin-block-start: calc(50% / (var(--card-ratio, 4 / 5)) - 16px);
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: 50%;
    background: var(--color-button);
    color: var(--color-button-label);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
  }

  .promo-banner__button {
    grid-area: button;
    margin-block-start: var(--space-5);
  }

  @media screen and (min-width: 750px) {
    .promo-banner__panel {
      padding: var(--space-6) var(--space-10);
    }

    /* Pitch and button on the start side, the cards on the end side. */
    .promo-banner__panel--set {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas: '. set' 'content set' 'button set' '. set';
      column-gap: var(--space-10);
    }

    .promo-banner__set {
      --set-gap: 40px;
      grid-template-columns: repeat(2, 160px);
      align-self: center;
      margin-block-start: 0;
    }

    .promo-banner__set--single {
      grid-template-columns: 160px;
    }

    .promo-banner__text {
      font-size: var(--text-lg);
    }

    .promo-banner__button {
      justify-self: start;
      min-inline-size: 220px;
      margin-block-start: var(--space-6);
    }
  }

  @media screen and (min-width: 990px) {
    .promo-banner__panel {
      padding: var(--space-6) var(--space-12);
    }

    .promo-banner__set {
      --set-gap: 48px;
      grid-template-columns: repeat(2, 180px);
    }

    .promo-banner__set--single {
      grid-template-columns: 180px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.promo_banner.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-accent"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.promo_banner.headers.products"
    },
    {
      "type": "paragraph",
      "content": "t:sections.promo_banner.settings.products_info.content"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "t:sections.promo_banner.settings.product_1.label"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "t:sections.promo_banner.settings.product_2.label"
    },
    {
      "type": "header",
      "content": "t:sections.promo_banner.headers.content"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "t:sections.promo_banner.settings.show_eyebrow.label",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "info": "t:settings.default_text_info",
      "visible_if": "{{ section.settings.show_eyebrow }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.button_link",
      "info": "t:sections.promo_banner.settings.button_link.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo_banner.name"
    }
  ]
}
{% endschema %}
