{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id

  assign has_title = false
  assign has_picker = false
  assign picker_block = null
  assign has_size_guide = false
  assign has_buy_buttons = false
  for block in section.blocks
    case block.type
      when 'title'
        assign has_title = true
      when 'variant_picker'
        assign has_picker = true
        assign picker_block = block
        if block.settings.show_size_guide
          assign has_size_guide = true
        endif
      when 'buy_buttons'
        assign has_buy_buttons = true
    endcase
  endfor

  capture whatsapp_digits
    render 'whatsapp-digits'
  endcapture
  if product.has_only_default_variant
    assign has_size_guide = false
  endif

  # Single-option products (every SportWear product has one Size option): the size radios carry the
  # variant id and post it to the product form (form="…"), so choosing a size works without
  # JavaScript. The form's hidden id input then starts disabled; assets/product-info.js enables it
  # and keeps it in sync, so express checkout buttons and apps find the variant inside the form.
  assign picker_submits_id = false
  if has_picker and product.has_only_default_variant == false and product.options.size == 1
    assign picker_submits_id = true
  endif

  # The size is a conscious choice: with more than one size in stock and no ?variant= in the URL, no
  # size counts as chosen, the buttons read "Choose a size" and pressing them asks for one
  # (assets/product-info.js). Without JavaScript the first available size stays preselected, so the
  # form always works. size_choice: the sticky bar and its size sheet can choose the size too.
  assign size_choice = false
  assign size_required = false
  if picker_submits_id and product.available
    assign size_choice = true
    assign sizes_in_stock = product.variants | where: 'available'
    if product.selected_variant == blank and sizes_in_stock.size > 1
      assign size_required = true
    endif
  endif

  assign is_lcp = false
  unless section.index > 1
    assign is_lcp = true
  endunless

  # Free shipping (see free-shipping-cents): free_all when every order ships free, free_amount when
  # orders ship free from an amount, neither when no free-shipping promise applies to the visitor.
  assign free_all = false
  assign free_amount = ''
  capture threshold_cents
    render 'free-shipping-cents'
  endcapture
  assign threshold_cents = threshold_cents | plus: 0
  if threshold_cents < 0
    assign free_all = true
  elsif threshold_cents > 0
    # The amount is wrapped in invisible Unicode isolates (U+2068/U+2069) so it keeps its direction in RTL sentences.
    assign free_amount = threshold_cents | money_without_trailing_zeros | prepend: '⁨' | append: '⁩'
  endif
-%}
<div
  class="section main-product color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- render 'product-breadcrumbs', product: product, show_nav: section.settings.show_breadcrumbs -%}

    {%- unless has_title -%}
      {%- # The page keeps its one h1 even when the merchant removes the title block. -%}
      <h1 class="visually-hidden">{{ product.title | escape }}</h1>
    {%- endunless -%}

    <div class="main-product__layout{% if section.settings.sticky_info %} main-product__layout--sticky{% endif %}">
      <div class="main-product__media">
        {%- render 'product-gallery',
          product: product,
          variant: current_variant,
          section_id: section.id,
          ratio: section.settings.media_ratio,
          lcp: is_lcp,
          zoom: section.settings.enable_zoom,
          badge_text: section.settings.media_badge_text
        -%}
      </div>

      <sw-product-info
        class="main-product__info product-info"
        data-section-id="{{ section.id }}"
        data-product-url="{{ product.url }}"
        data-variant-id="{{ current_variant.id }}"
        data-variant-available="{{ current_variant.available | default: false }}"
        data-variant-media-id="{{ current_variant.featured_media.id }}"
        data-added-message="{{ 'products.buy.added' | t: title: product.title }}"
        {% if picker_submits_id %}
          data-added-size-message="{{ 'products.buy.added_with_size' | t: title: product.title, size: '[size]' }}"
        {% endif %}
        {% if size_required %}
          data-size-required
        {% endif %}
      >
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="product-info__block product-info__block--app" {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>

            {%- when 'eyebrow' -%}
              {%- liquid
                assign team = product.metafields.sportwear.team.value
                assign league = product.metafields.sportwear.leagues.value | first
                assign team_name = team.name.value
                assign league_name = league.name.value
              -%}
              {%- if team_name != blank or league_name != blank -%}
                <p
                  class="product-info__block product-info__block--eyebrow product-eyebrow"
                  {{ block.shopify_attributes }}
                >
                  <span class="product-eyebrow__marker" aria-hidden="true"></span>
                  <span>
                    {{- team_name | escape -}}
                    {%- if team_name != blank and league_name != blank %} · {% endif -%}
                    {{- league_name | escape -}}
                  </span>
                </p>
              {%- elsif request.design_mode -%}
                <p class="product-info__block product-editor-note" {{ block.shopify_attributes }}>
                  {{ 'products.editor.eyebrow' | t }}
                </p>
              {%- endif -%}

            {%- when 'title' -%}
              {%- liquid
                # A title such as "… 1 אדום | כיתוב BULLS" names a detail that tells look-alike products apart:
                # it shows as a quieter line under the name instead of a bar in the big heading.
                assign title_main = product.title | split: ' | ' | first
                assign title_detail = ''
                if product.title contains ' | '
                  assign title_detail = product.title | remove_first: title_main | remove_first: ' | '
                endif
              -%}
              <h1
                class="product-info__block product-info__block--title product-info__title display-l"
                {{ block.shopify_attributes }}
              >
                {%- # The ending after a dash stays together, as on product cards (snippets/product-card.liquid). -%}
                {{-
                  title_main
                  | escape
                  | replace: ' – ', '&nbsp;–&#8288;&nbsp;'
                  | replace: ' - ', '&nbsp;-&#8288;&nbsp;'
                -}}
                {%- if title_detail != blank -%}
                  <span class="visually-hidden">, </span>
                  <span class="product-info__title-detail">{{ title_detail | escape }}</span>
                {%- endif -%}
              </h1>

            {%- when 'price' -%}
              {%- liquid
                # Before a size is chosen the product's price shows ("From ₪…" when sizes differ in price).
                assign show_saving = false
                if current_variant.compare_at_price > current_variant.price
                  assign show_saving = true
                  if size_required
                    if product.price_varies or product.compare_at_price_varies
                      assign show_saving = false
                    endif
                  endif
                endif
              -%}
              <div class="product-info__block product-info__block--price" {{ block.shopify_attributes }}>
                <div class="product-price" data-product-dynamic="price">
                  {%- if current_variant != blank and size_required == false -%}
                    {%- render 'price', variant: current_variant, class: 'product-price__amount' -%}
                  {%- else -%}
                    {%- render 'price', product: product, class: 'product-price__amount' -%}
                  {%- endif -%}
                  {%- if show_saving -%}
                    {%- liquid
                      assign saved_cents = current_variant.compare_at_price | minus: current_variant.price
                      # Unicode isolates keep the amount's direction inside the RTL sentence.
                      assign saved = saved_cents | money_without_trailing_zeros | prepend: '⁨' | append: '⁩'
                    -%}
                    <span class="product-price__save">{{ 'products.price.save' | t: amount: saved }}</span>
                  {%- endif -%}
                  {%- if block.settings.show_tax_note and cart.taxes_included -%}
                    <span class="product-price__note">{{ 'products.price.tax_included' | t }}</span>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'audience_toggle' -%}
              {%- liquid
                assign counterpart = product.metafields.sportwear.counterpart.value
                assign audience = product.metafields.sportwear.audience.value | default: 'adult'
                # The other version's option shows its price, so a parent sees the kids set's price before switching.
                assign counterpart_price = ''
                if counterpart != blank and counterpart.available
                  assign counterpart_price = counterpart.price_min | money_without_trailing_zeros
                  if counterpart.price_varies
                    assign counterpart_price = 'general.price.from_price' | t: price: counterpart_price
                  endif
                endif
              -%}
              {%- if counterpart != blank and counterpart.id != product.id -%}
                <nav
                  class="product-info__block product-info__block--audience product-audience"
                  aria-label="{{ 'products.audience.label' | t }}"
                  {{ block.shopify_attributes }}
                >
                  <ul class="product-audience__list" role="list">
                    <li class="product-audience__item">
                      {%- if audience == 'kids' -%}
                        <a class="product-audience__option product-audience__option--link" href="{{ counterpart.url }}">
                          <span>
                            {{- 'products.audience.adult' | t -}}
                            {%- if counterpart_price != blank %}
                              <bdi class="product-audience__price">{{ counterpart_price }}</bdi>
                            {%- endif -%}
                          </span>
                        </a>
                      {%- else -%}
                        <span class="product-audience__option product-audience__option--current" aria-current="page">
                          {{- 'products.audience.adult' | t -}}
                        </span>
                      {%- endif -%}
                    </li>
                    <li class="product-audience__item">
                      {%- if audience == 'kids' -%}
                        <span class="product-audience__option product-audience__option--current" aria-current="page">
                          {{- 'products.audience.kids' | t -}}
                        </span>
                      {%- else -%}
                        <a class="product-audience__option product-audience__option--link" href="{{ counterpart.url }}">
                          <span>
                            {{- 'products.audience.kids' | t -}}
                            {%- if counterpart_price != blank %}
                              <bdi class="product-audience__price">{{ counterpart_price }}</bdi>
                            {%- endif -%}
                          </span>
                        </a>
                      {%- endif -%}
                    </li>
                  </ul>
                </nav>
              {%- elsif request.design_mode -%}
                <p class="product-info__block product-editor-note" {{ block.shopify_attributes }}>
                  {{ 'products.editor.audience_toggle' | t }}
                </p>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- capture inventory_note -%}
                {%- comment -%} The stock note is about the chosen size, so it waits for one. {%- endcomment -%}
                {%- if block.settings.show_inventory and current_variant != blank and size_required == false -%}
                  {%- if current_variant.available == false -%}
                    <p class="product-inventory__note product-inventory__note--out">
                      {{- 'products.variant_picker.unavailable' | t -}}
                    </p>
                  {%- elsif current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_stock_threshold -%}
                    <p class="product-inventory__note product-inventory__note--low">
                      {{- 'products.variant_picker.low_stock' | t: count: current_variant.inventory_quantity -}}
                    </p>
                  {%- else -%}
                    <p class="product-inventory__note product-inventory__note--in">
                      {{- 'products.variant_picker.in_stock' | t -}}
                    </p>
                  {%- endif -%}
                {%- endif -%}
              {%- endcapture -%}
              {%- if product.has_only_default_variant == false or inventory_note != blank -%}
                <div class="product-info__block product-info__block--variant-picker" {{ block.shopify_attributes }}>
                  {%- unless product.has_only_default_variant -%}
                    {%- render 'variant-picker',
                      product: product,
                      block: block,
                      section_id: section.id,
                      form_id: form_id,
                      submits_id: picker_submits_id,
                      size_required: size_required
                    -%}
                  {%- endunless -%}
                  {%- if block.settings.show_inventory -%}
                    <div class="product-inventory" data-product-dynamic="inventory" aria-live="polite">
                      {{- inventory_note -}}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'buy_buttons' -%}
              <div class="product-info__block product-info__block--buy-buttons" {{ block.shopify_attributes }}>
                {%- render 'product-buy-buttons',
                  product: product,
                  variant: current_variant,
                  block: block,
                  form_id: form_id,
                  id_disabled: picker_submits_id,
                  size_required: size_required
                -%}
                {%- if block.settings.show_payment_icons -%}
                  {%- assign payment_prefix = 'Product-' | append: section.id -%}
                  {%- capture payment_icons -%}
                    {%- render 'payment-icons',
                      id_prefix: payment_prefix,
                      class: 'product-payments__list',
                      item_class: 'product-payments__item',
                      icon_class: 'product-payments__icon'
                    -%}
                  {%- endcapture -%}
                  {%- if payment_icons != blank -%}
                    <div class="product-payments">
                      <p class="product-payments__label">
                        {%- render 'icon', name: 'lock', size: 14 -%}
                        <span>{{ 'products.buy.secure_checkout' | t }}</span>
                      </p>
                      {{ payment_icons }}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>

            {%- when 'shipping_note' -%}
              {%- liquid
                assign free_text = ''
                if block.settings.show_free_shipping
                  if free_all
                    assign free_text = 'products.shipping_note.free_all' | t
                  elsif free_amount != blank
                    assign free_text = 'products.shipping_note.free_from' | t: amount: free_amount
                  endif
                endif
                # Worded and ordered like the announcement bar: the free shipping, then the delivery time,
                # which is shorter after it ("Up to 10 business days") than on its own.
                assign delivery_text = block.settings.text | escape
                if delivery_text == blank
                  if free_text != blank
                    assign delivery_text = 'products.shipping_note.delivery_short' | t
                  else
                    assign delivery_text = 'products.shipping_note.delivery' | t
                  endif
                endif
              -%}
              <p
                class="product-info__block product-info__block--shipping-note product-shipping-note"
                {{ block.shopify_attributes }}
              >
                {%- render 'icon', name: 'truck', size: 18 -%}
                <span>
                  {%- # The no-break space keeps the dot at the end of a line when the note wraps. -%}
                  {%- if free_text != blank %}{{ free_text }}&nbsp;· {% endif -%}
                  {{- delivery_text -}}
                </span>
              </p>

            {%- when 'trust' -%}
              {%- liquid
                assign trust_shipping = block.settings.text_shipping | escape
                if trust_shipping == blank
                  if free_all
                    assign trust_shipping = 'general.trust.shipping_free' | t
                  else
                    assign trust_shipping = 'general.trust.shipping' | t
                  endif
                endif
                assign trust_returns = block.settings.text_returns | escape
                if trust_returns == blank
                  assign trust_returns = 'general.trust.returns' | t
                endif
                assign trust_stock = block.settings.text_stock | escape
                if trust_stock == blank
                  assign trust_stock = 'general.trust.stock' | t
                endif
                assign trust_payment = block.settings.text_payment | escape
                if trust_payment == blank
                  assign trust_payment = 'general.trust.secure_payment' | t
                endif
              -%}
              <div class="product-info__block product-info__block--trust" {{ block.shopify_attributes }}>
                <ul class="product-trust" role="list">
                  <li class="product-trust__item">
                    <span class="product-trust__icon">{%- render 'icon', name: 'truck', size: 20 -%}</span>
                    <span>{{ trust_shipping }}</span>
                  </li>
                  <li class="product-trust__item">
                    <span class="product-trust__icon">{%- render 'icon', name: 'return', size: 20 -%}</span>
                    <span>{{ trust_returns }}</span>
                  </li>
                  <li class="product-trust__item">
                    <span class="product-trust__icon">{%- render 'icon', name: 'map-pin', size: 20 -%}</span>
                    <span>{{ trust_stock }}</span>
                  </li>
                  <li class="product-trust__item">
                    <span class="product-trust__icon">{%- render 'icon', name: 'lock', size: 20 -%}</span>
                    <span>{{ trust_payment }}</span>
                  </li>
                </ul>
                {%- if block.settings.show_whatsapp and whatsapp_digits != blank -%}
                  {%- assign help_message = 'products.help.whatsapp_message_html'
                    | t: title: product.title
                    | url_encode
                    | replace: '+', '%20'
                  -%}
                  <a
                    class="product-help"
                    href="https://wa.me/{{ whatsapp_digits }}?text={{ help_message }}"
                    target="_blank"
                    rel="noopener"
                  >
                    {%- render 'icon', name: 'whatsapp', size: 20 -%}
                    <span>{{ 'products.help.whatsapp' | t }}</span>
                    <span class="visually-hidden">({{ 'accessibility.new_window' | t }})</span>
                  </a>
                {%- endif -%}
              </div>

            {%- when 'complete_set' -%}
              {%- assign complements = product.metafields.sportwear.complements.value -%}
              {%- if complements != blank -%}
                {%- assign available_complements = complements | where: 'available' -%}
                {%- if available_complements.size > 0 -%}
                  <div class="product-info__block product-info__block--complete-set" {{ block.shopify_attributes }}>
                    {%- render 'product-complete-set',
                      product: product,
                      variant: current_variant,
                      size_required: size_required,
                      complements: complements,
                      block: block
                    -%}
                  </div>
                {%- endif -%}
              {%- elsif request.design_mode -%}
                <p class="product-info__block product-editor-note" {{ block.shopify_attributes }}>
                  {{ 'products.editor.complete_set' | t }}
                </p>
              {%- endif -%}

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                {%- liquid
                  assign accordion_heading = block.settings.heading | escape
                  if accordion_heading == blank
                    assign accordion_heading = 'products.description.heading' | t
                  endif
                -%}
                {%- capture accordion_content -%}
                  <div class="rte">{{ product.description }}</div>
                {%- endcapture -%}
                {%- render 'product-accordion',
                  block: block,
                  heading: accordion_heading,
                  content: accordion_content,
                  open: block.settings.open
                -%}
              {%- elsif request.design_mode -%}
                <p class="product-info__block product-editor-note" {{ block.shopify_attributes }}>
                  {{ 'products.editor.description' | t }}
                </p>
              {%- endif -%}

            {%- when 'collapsible' -%}
              {%- liquid
                assign accordion_heading = block.settings.heading | escape
                assign accordion_body = block.settings.content
                if block.settings.page != blank
                  assign accordion_body = block.settings.page.content
                  if accordion_heading == blank
                    assign accordion_heading = block.settings.page.title | escape
                  endif
                endif
                assign use_default = false
                if accordion_heading == blank and accordion_body == blank
                  assign use_default = true
                  assign accordion_heading = 'products.shipping_returns.heading' | t
                endif
              -%}
              {%- capture accordion_content -%}
                <div class="rte">
                  {%- if use_default -%}
                    <p>
                      {{- 'products.shipping_returns.delivery' | t -}}
                      {%- if free_all %} {{ 'products.shipping_returns.free_shipping_all' | t }}
                      {%- elsif free_amount != blank %} {{ 'products.shipping_returns.free_shipping' | t: amount: free_amount }}
                      {%- endif -%}
                    </p>
                    <p>
                      {{- 'products.shipping_returns.returns' | t -}}
                      {%- if shop.refund_policy != blank %} {{ 'products.shipping_returns.returns_policy' | t }}{% endif -%}
                    </p>
                    {%- if shop.shipping_policy != blank or shop.refund_policy != blank -%}
                      <p>
                        {{- 'products.shipping_returns.details' | t }}
                        {% if shop.shipping_policy != blank -%}
                          <a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a>
                        {%- endif -%}
                        {%- if shop.shipping_policy != blank and shop.refund_policy != blank %} · {% endif -%}
                        {%- if shop.refund_policy != blank -%}
                          <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a>
                        {%- endif -%}
                      </p>
                    {%- endif -%}
                  {%- else -%}
                    {{- accordion_body -}}
                  {%- endif -%}
                </div>
              {%- endcapture -%}
              {%- if use_default or accordion_body != blank or request.design_mode -%}
                {%- render 'product-accordion',
                  block: block,
                  heading: accordion_heading,
                  content: accordion_content,
                  open: block.settings.open
                -%}
              {%- endif -%}

            {%- when 'size_table' -%}
              {%- liquid
                assign accordion_heading = block.settings.heading | escape
                if accordion_heading == blank
                  assign accordion_heading = 'products.size_chart.heading' | t
                endif
                assign chart_id = 'SizeChartInline-' | append: block.id
              -%}
              {%- capture accordion_content -%}
                {%- render 'size-chart', product: product, id: chart_id, heading_tag: 'p' -%}
              {%- endcapture -%}
              {%- render 'product-accordion',
                block: block,
                heading: accordion_heading,
                content: accordion_content,
                open: block.settings.open
              -%}

            {%- when 'team_card' -%}
              {%- render 'product-team-card', product: product, block: block -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.show_sticky_buy and has_buy_buttons -%}
          {%- render 'product-sticky-buy',
            product: product,
            variant: current_variant,
            section_id: section.id,
            form_id: form_id,
            color_scheme: section.settings.color_scheme.id,
            picker_block: picker_block,
            size_choice: size_choice,
            size_required: size_required
          -%}
        {%- endif -%}
      </sw-product-info>
    </div>
  </div>

  {%- if has_size_guide -%}
    <sw-drawer id="SizeChart">
      <dialog
        class="modal size-chart-modal color-{{ settings.drawer_color_scheme.id }}"
        aria-labelledby="SizeChartTitle"
      >
        <div class="product-modal__header">
          <h2 id="SizeChartTitle" class="product-modal__title">{{ 'products.variant_picker.size_guide' | t }}</h2>
          <button type="button" class="button button--icon" data-drawer-close>
            {%- render 'icon', name: 'close' -%}
            <span class="visually-hidden">{{ 'general.close' | t }}</span>
          </button>
        </div>
        <div class="product-modal__body">
          {%- render 'size-chart', product: product, id: 'SizeChartDialog' -%}
        </div>
      </dialog>
    </sw-drawer>
  {%- endif -%}
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>
<script type="module" src="{{ 'product-info.js' | asset_url }}"></script>
<script type="module" src="{{ 'product-gallery.js' | asset_url }}"></script>

{% stylesheet %}
  .product-editor-note {
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* Layout: mobile single column with a full-bleed gallery; desktop media (58%) at the start side and
     the product info at the end side, sticky under the header. */
  .main-product__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-5);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
      align-items: start;
      column-gap: clamp(32px, 4vw, 64px);
    }
  }

  .main-product__media {
    min-inline-size: 0;
    margin-inline: calc(-1 * var(--gutter));

    @media screen and (min-width: 750px) {
      margin-inline: 0;
    }
  }

  .main-product__info {
    display: block;
    min-inline-size: 0;
  }

  @media screen and (min-width: 990px) {
    .main-product__layout--sticky .main-product__info {
      position: sticky;
      inset-block-start: calc(var(--header-height, 0px) + var(--space-6));
    }
  }

  /* Spacing between the info blocks, whatever order the merchant puts them in. */
  .product-info > * + * {
    margin-block-start: var(--space-5);
  }

  .product-info > .product-info__block--title {
    margin-block-start: var(--space-2);
  }

  .product-info > :is(.product-info__block--price, .product-info__block--shipping-note) {
    margin-block-start: var(--space-3);
  }

  .product-info > .product-info__block--variant-picker {
    margin-block-start: var(--space-4);
  }

  .product-info > :is(.product-info__block--trust, .product-info__block--complete-set) {
    margin-block-start: var(--space-6);
  }

  .product-info > .product-info__block--accordion {
    margin-block-start: var(--space-4);
  }

  .product-info > .product-info__block--accordion + .product-info__block--accordion {
    margin-block-start: 0;
  }

  .product-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: var(--leading-tight);
  }

  .product-eyebrow__marker {
    flex-shrink: 0;
    inline-size: 10px;
    block-size: 10px;
    border-radius: 2px;
    background: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-text);
  }

  /* A product title, not a poster: large enough to lead, small enough to leave the price and sizes
     in the first screen. */
  .product-info .product-info__title {
    font-size: calc(34px * var(--heading-scale, 1) * var(--display-lang-scale, 1));
    overflow-wrap: break-word;
    text-wrap: pretty;

    @media screen and (min-width: 990px) {
      font-size: calc(46px * var(--heading-scale, 1) * var(--display-lang-scale, 1));
    }
  }

  /*
    "More from the team": a dark card that links to the team's (or player's) page. With a collector card
    (sections/collection-circles.liquid) it carries the card's jersey, big number and colour glow at the end side.
  */
  .team-card {
    --team-color: transparent;
    --team-glow-x: 88%;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-block-size: 112px;
    padding-block: var(--space-4);
    padding-inline: var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-card);
    background:
      radial-gradient(
        150px 110px at var(--team-glow-x) 50%,
        color-mix(in oklab, var(--team-color) 55%, transparent),
        transparent
      ),
      var(--color-background);
    color: var(--color-text);
    text-decoration: none;
    transition: transform var(--duration) var(--ease);

    &:hover {
      transform: translateY(-2px);
    }

    /* The card is dark on a light page: the ring is ink (the card's own scheme would make it white). */
    &:focus-visible {
      outline: 2px solid var(--color-on-accent);
      outline-offset: 3px;
    }
  }

  [dir='rtl'] .team-card {
    --team-glow-x: 12%;
  }

  .team-card__text {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .team-card__eyebrow {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .team-card__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-display);
    overflow-wrap: anywhere;

    &:lang(en) {
      text-transform: var(--latin-heading-transform, uppercase);
      letter-spacing: 0.01em;
    }

    &:lang(ar) {
      line-height: 1.22;
    }
  }

  .team-card__count {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;

    & .icon {
      transition: translate var(--duration) var(--ease);
    }
  }

  .team-card:hover .team-card__count .icon {
    translate: 3px 0;
  }

  :dir(rtl) .team-card:hover .team-card__count .icon {
    translate: -3px 0;
  }

  .team-card__art {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    margin-inline-start: auto;
    inline-size: 104px;
    block-size: 96px;
  }

  .team-card__mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: color-mix(in oklab, var(--team-color) 20%, transparent);
    font-family: var(--font-display);
    font-size: 84px;
    line-height: 0.8;
    -webkit-text-stroke: 1.25px color-mix(in oklab, var(--team-color) 72%, white);
    direction: ltr;
    white-space: nowrap;
    user-select: none;
  }

  .team-card__jersey {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.5));
    transition: transform var(--duration) var(--ease);
  }

  .team-card:hover .team-card__jersey {
    transform: translateY(-3px) scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card,
    .team-card:hover,
    .team-card:hover .team-card__jersey,
    .team-card:hover .team-card__count .icon {
      transform: none;
      translate: none;
    }
  }

  .product-info__title-detail {
    display: block;
    margin-block-start: var(--space-2);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
  }

  .product-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) 10px;
    transition: opacity var(--duration-fast) var(--ease);
  }

  .product-price__amount {
    font-size: calc(28px * var(--body-scale, 1));
    line-height: 1.2;
  }

  .product-price__note {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* The sale color is dark on light schemes and light on dark ones: the scheme's background color reads
     on it in all of them (white text on the light orange of the dark scheme would not). */
  .product-price__save {
    align-self: center;
    padding: 3px 10px;
    border-radius: var(--radius-badge);
    background: var(--color-sale);
    color: var(--color-background);
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: 1.3;
  }

  .product-info[aria-busy='true'] :is(.product-price, .product-buy__submit) {
    opacity: 0.6;
  }

  .product-audience__list {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-1);
    border-radius: calc(var(--radius-button) + 2px);
    background: var(--color-surface);
    list-style: none;
  }

  .product-audience__item {
    display: flex;
    flex: 1 1 0;
    min-inline-size: 0;
  }

  .product-audience__option {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-3);
    border-radius: var(--radius-button);
    color: var(--color-text);
    font-size: calc(15px * var(--body-scale, 1));
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .product-audience__option--link:hover {
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .product-audience__option--current {
    background: var(--color-text);
    color: var(--color-background);
  }

  .product-audience__price {
    margin-inline-start: var(--space-1);
    color: var(--color-muted);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .product-inventory:not(:empty) {
    margin-block-start: var(--space-3);
  }

  .product-inventory__note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .product-inventory__note--low::before {
    content: '';
    flex-shrink: 0;
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background: var(--color-sale);
  }

  .product-inventory__note--in::before {
    content: '';
    flex-shrink: 0;
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background: #1f9d55;
    box-shadow: 0 0 0 3px color-mix(in srgb, #1f9d55 22%, transparent);
  }

  .product-inventory__note--out {
    color: var(--color-muted);
    font-weight: 600;
  }

  /* Payment options right under the buy buttons. */
  .product-payments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-3);
    margin-block-start: var(--space-3);
  }

  .product-payments__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .product-payments__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-payments__item {
    display: flex;
  }

  .product-payments__icon {
    inline-size: 34px;
    block-size: 22px;
  }

  /* Block, not flex: a longer English or Arabic sentence wraps as text around the inline icon. */
  .product-shipping-note {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: center;
    text-wrap: balance;

    & .icon {
      display: inline-block;
      vertical-align: -4px;
      margin-inline-end: var(--space-2);
    }
  }

  /* Trust: four short promises in a 2 x 2 grid of cells split by hairlines. */
  .product-trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-border);
    list-style: none;
  }

  .product-trust__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: 64px;
    padding: var(--space-3);
    background: var(--color-background);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.35;
  }

  .product-trust__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: 50%;
    background: var(--color-surface);
  }

  .product-help {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-block-size: var(--touch-target);
    margin-block-start: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;

    & .icon {
      color: #1f9d55;
    }

    &:hover {
      border-color: var(--color-text);
    }
  }

  /* Dialog shell shared by the size guide and the image zoom. */
  .product-modal__header {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-block-size: 64px;
    padding-inline: var(--space-5) var(--space-2);
    border-block-end: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .product-modal__title {
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: var(--leading-tight);
  }

  .product-modal__body {
    padding: var(--space-5);
  }
{% endstylesheet %}

