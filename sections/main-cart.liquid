{%- comment -%}
  Cart page (templates/cart.json). Owns the page <h1>. Works without JavaScript: quantities submit
  with the cart form (Update button), lines are removed through url_to_remove links and the
  checkout button posts the form. With JavaScript, assets/cart.js re-renders [data-cart-content]
  through the Section Rendering API (this section's id), exactly like the cart drawer.
{%- endcomment -%}
{%- liquid
  assign shop_url = routes.all_products_collection_url
  if section.settings.empty_collection != blank
    assign shop_url = section.settings.empty_collection.url
  endif
  assign total_money = cart.total_price | money_without_trailing_zeros

  # "Total" when checkout adds nothing (prices include taxes and shipping is free), as in cart-summary.
  capture threshold_cents
    render 'free-shipping-cents'
  endcapture
  assign threshold_cents = threshold_cents | plus: 0
  assign total_label = 'cart.summary.subtotal' | t
  if cart.taxes_included
    if threshold_cents < 0 or threshold_cents > 0 and cart.total_price >= threshold_cents
      assign total_label = 'cart.summary.total' | t
    endif
  endif
-%}
<div
  class="section main-cart color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <sw-cart
    class="page-width main-cart__cart"
    data-section-id="{{ section.id }}"
    data-removed-message="{{ 'cart.status.removed' | t: title: '[title]' }}"
    data-max-quantity-message="{{ 'cart.errors.max_quantity' | t: quantity: '[quantity]' }}"
  >
    <div class="main-cart__content" data-cart-content>
      <div class="main-cart__header">
        <h1 class="main-cart__title display-m" tabindex="-1" data-cart-focus-fallback>
          {{ 'cart.title' | t }}
          {% if cart.item_count > 0 %}
            <span class="main-cart__count" aria-hidden="true">({{ cart.item_count }})</span>
            <span class="visually-hidden">{{ 'cart.item_count' | t: count: cart.item_count }}</span>
          {% endif %}
        </h1>
        {%- unless cart.empty? -%}
          <a class="link-arrow main-cart__continue" href="{{ shop_url }}">
            {{- 'cart.continue_shopping' | t -}}
            {%- render 'icon', name: 'arrow-forward', size: 18 -%}
          </a>
        {%- endunless -%}
      </div>

      {%- if cart.empty? -%}
        {%- render 'cart-empty',
          url: shop_url,
          menu: section.settings.empty_menu,
          id_prefix: 'MainCart',
          class: 'main-cart__empty'
        -%}
      {%- else -%}
        <div class="main-cart__layout">
          <div class="main-cart__main">
            {%- render 'free-shipping-bar', cart: cart, class: 'main-cart__shipping' -%}
            <p class="cart-alert" data-cart-error hidden></p>
            {%- render 'cart-items',
              cart: cart,
              id_prefix: 'MainCart',
              form_id: 'MainCartForm',
              sizes: '(min-width: 600px) 112px, 88px',
              eager: 3
            -%}
            <div class="main-cart__update no-js-only">
              <button type="submit" name="update" form="MainCartForm" class="button button--secondary button--small">
                {{- 'cart.update' | t -}}
              </button>
            </div>
            {%- if settings.cart_show_upsell -%}
              {%- render 'cart-upsell',
                cart: cart,
                id_prefix: 'MainCart',
                heading_tag: 'h2',
                color_scheme: section.settings.upsell_color_scheme.id
              -%}
            {%- endif -%}
            {%- if section.settings.show_recs -%}
              {%- render 'cart-recs',
                cart: cart,
                id_prefix: 'MainCart',
                fill_collection: section.settings.recs_collection,
                limit: section.settings.recs_limit,
                heading_tag: 'h2',
                sizes: '(min-width: 990px) 180px, (min-width: 750px) 24vw, 38vw'
              -%}
            {%- endif -%}

            {%- comment -%}
              Phones: the total and the checkout button stay at the bottom of the screen while the lines
              scroll (sticky, no JavaScript), and settle right above the summary at the end of the column.
              From 990px the summary sits beside the lines and is sticky itself, so the bar is hidden.
            {%- endcomment -%}
            <div class="main-cart__bar">
              <p class="main-cart__bar-total">
                <span class="main-cart__bar-label">{{ total_label }}</span>
                <bdi>{{ total_money }}</bdi>
              </p>
              <button
                type="submit"
                name="checkout"
                form="MainCartForm"
                class="button button--primary main-cart__bar-button"
                data-cart-checkout
                data-cart-focus="checkout-bar"
              >
                <span class="cart-summary__checkout-label">
                  {%- render 'icon', name: 'lock', size: 18 -%}
                  {{ 'cart.checkout' | t }}
                </span>
                <span class="spinner cart-summary__spinner" aria-hidden="true"></span>
              </button>
            </div>
          </div>

          <form
            class="main-cart__summary"
            id="MainCartForm"
            action="{{ routes.cart_url }}"
            method="post"
            novalidate
            aria-labelledby="MainCartSummaryTitle"
          >
            <h2 class="main-cart__summary-title title-m" id="MainCartSummaryTitle">
              {{- 'cart.summary.heading' | t -}}
            </h2>
            {%- if settings.cart_show_note -%}
              {%- render 'cart-note', cart: cart, id_prefix: 'MainCart', form_id: 'MainCartForm' -%}
            {%- endif -%}
            {%- render 'cart-summary', cart: cart, id_prefix: 'MainCart', express: true -%}
          </form>
        </div>
      {%- endif -%}

      <p hidden data-cart-status>
        {%- if cart.empty? -%}
          {{- 'cart.status.empty' | t -}}
        {%- else -%}
          {{- 'cart.status.summary' | t: count: cart.item_count, total: total_money -}}
        {%- endif -%}
      </p>
    </div>
  </sw-cart>
</div>
<script type="module" src="{{ 'cart.js' | asset_url }}"></script>
{%- if section.settings.show_recs -%}
  <script type="module" src="{{ 'product-carousel.js' | asset_url }}"></script>
{%- endif -%}

{% stylesheet %}
  .main-cart__cart {
    display: block;
  }

  .main-cart__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-block-end: var(--space-6);
  }

  .main-cart__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .main-cart__count {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  .main-cart__layout {
    display: grid;
    gap: var(--space-8);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1fr) minmax(340px, 400px);
      align-items: start;
      gap: var(--space-12);
    }
  }

  .main-cart__main {
    min-inline-size: 0;
  }

  .main-cart__shipping {
    border-radius: var(--radius-card);
  }

  .main-cart__update {
    margin-block-start: var(--space-4);
  }

  .main-cart__bar {
    position: sticky;
    inset-block-end: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-start: var(--space-5);
    margin-inline: calc(-1 * var(--gutter));
    padding-block: var(--space-3) max(var(--space-3), env(safe-area-inset-bottom));
    padding-inline: var(--gutter);
    border-block-start: 1px solid var(--color-border);
    background: var(--color-background);
    box-shadow: 0 -8px 24px rgb(13 14 17 / 0.08);

    @media screen and (min-width: 990px) {
      display: none;
    }
  }

  .main-cart__bar-total {
    display: grid;
    line-height: 1.2;
    font-size: var(--text-lg);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .main-cart__bar-label {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .main-cart__bar-button {
    flex: 1 1 auto;
    max-inline-size: 280px;
  }

  .main-cart__summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-6);
    padding-inline: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-surface);

    @media screen and (min-width: 990px) {
      position: sticky;
      inset-block-start: calc(var(--header-height, 0px) + var(--space-6));
      padding-inline: var(--space-6);
    }
  }

  .main-cart__summary-title {
    margin-block-end: var(--space-2);
  }

  .main-cart__empty {
    max-inline-size: 560px;
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "tag": "div",
  "class": "main-cart-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main_cart.settings.info.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "color_scheme",
      "id": "upsell_color_scheme",
      "label": "t:sections.main_cart.settings.upsell_color_scheme.label",
      "default": "scheme-day"
    },
    {
      "type": "header",
      "content": "t:sections.main_cart.settings.recs_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_recs",
      "label": "t:sections.main_cart.settings.show_recs.label",
      "info": "t:sections.main_cart.settings.show_recs.info",
      "default": true
    },
    {
      "type": "collection",
      "id": "recs_collection",
      "label": "t:sections.main_cart.settings.recs_collection.label",
      "info": "t:sections.main_cart.settings.recs_collection.info"
    },
    {
      "type": "range",
      "id": "recs_limit",
      "label": "t:sections.main_cart.settings.recs_limit.label",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:sections.main_cart.settings.empty_header.content"
    },
    {
      "type": "collection",
      "id": "empty_collection",
      "label": "t:sections.main_cart.settings.empty_collection.label",
      "info": "t:sections.main_cart.settings.empty_collection.info"
    },
    {
      "type": "link_list",
      "id": "empty_menu",
      "label": "t:sections.main_cart.settings.empty_menu.label",
      "info": "t:sections.main_cart.settings.empty_menu.info",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
