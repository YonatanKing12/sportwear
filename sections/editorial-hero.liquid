{%- liquid
  assign image = section.settings.image
  assign heading = section.settings.heading | default: ''
  assign highlight = section.settings.highlight | default: ''
  assign intro = section.settings.intro | default: ''
  if heading == blank
    assign heading = 'editorial.heading' | t
  endif
  if highlight == blank
    assign highlight = 'editorial.highlight' | t
  endif
  if intro == blank
    assign intro = 'editorial.intro' | t
  endif
  assign football_url = collections.football.url | default: routes.all_products_collection_url
  assign basketball_url = collections.basketball.url | default: routes.all_products_collection_url
-%}
<section
  class="editorial-hero color-{{ section.settings.color_scheme.id }}"
  aria-labelledby="EditorialHeading-{{ section.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="editorial-hero__layout">
    <div class="editorial-hero__copy">
      <p class="eyebrow editorial-hero__eyebrow"><span aria-hidden="true"></span>{{ 'editorial.eyebrow' | t }}</p>
      <h1 id="EditorialHeading-{{ section.id }}">
        {{ 'editorial.heading' | t -}}
        <span>{{ highlight | escape }}</span>
      </h1>
      <p class="editorial-hero__intro">{{ intro | escape }}</p>
      <div class="editorial-hero__actions">
        <a class="button button--primary" href="{{ football_url }}">
          {{- 'editorial.football' | t -}}
          {%- render 'icon', name: 'arrow-forward', size: 20 -%}
        </a>
        <a class="button button--secondary" href="{{ basketball_url }}">
          {{- 'editorial.basketball' | t -}}
          {%- render 'icon', name: 'arrow-forward', size: 20 -%}
        </a>
      </div>
      <p class="editorial-hero__signature" aria-hidden="true" lang="en" dir="ltr">SPORT / STYLE / EVERY DAY</p>
    </div>
    <div class="editorial-hero__visual">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 2000
          | image_tag:
            widths: '600, 900, 1200, 1600, 2000',
            sizes: '(min-width: 990px) 65vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: '',
            class: 'editorial-hero__image'
        }}
      {%- endif -%}
      <div class="editorial-hero__destinations">
        <a href="{{ football_url }}"
          ><span aria-hidden="true">01</span>{{ 'editorial.football_world' | t -}}
          {%- render 'icon', name: 'arrow-forward', size: 20 -%}
        </a>
        <a href="{{ basketball_url }}"
          ><span aria-hidden="true">02</span>{{ 'editorial.basketball_world' | t -}}
          {%- render 'icon', name: 'arrow-forward', size: 20 -%}
        </a>
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
  .editorial-hero {
    padding-block: var(--section-pt) var(--section-pb);
  }
  .editorial-hero__layout {
    display: grid;
    min-inline-size: 0;
  }
  .editorial-hero__copy {
    padding: 32px var(--gutter) 24px;
    position: relative;
  }
  .editorial-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--color-muted);
  }
  .editorial-hero__eyebrow > span {
    inline-size: 8px;
    block-size: 8px;
    background: var(--color-accent);
  }
  .editorial-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(56px, 16vw, 80px);
    line-height: 0.98;
    margin: 0;
    font-weight: 700;
  }
  .editorial-hero h1 span {
    display: block;
    color: var(--color-accent);
  }
  .editorial-hero:lang(ar) h1 {
    line-height: 1.25;
    font-size: clamp(42px, 11vw, 66px);
  }
  .editorial-hero:lang(en) h1 {
    font-size: clamp(40px, 11vw, 62px);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .editorial-hero__intro {
    margin: 18px 0 22px;
    max-inline-size: 34ch;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.65;
  }
  .editorial-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .editorial-hero__actions .button {
    flex: 1 1 auto;
    gap: 10px;
    padding-inline: 16px;
  }
  .editorial-hero__signature {
    display: none;
  }
  .editorial-hero__visual {
    min-inline-size: 0;
    position: relative;
    background: #eee9e1;
  }
  .editorial-hero__image {
    display: block;
    inline-size: 100%;
    aspect-ratio: 1.95;
    object-fit: cover;
    object-position: left center;
  }
  .editorial-hero__destinations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--color-background);
    border-block: 1px solid var(--color-border);
  }
  .editorial-hero__destinations a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 14px;
    font-weight: 600;
    font-size: 13px;
    min-block-size: 60px;
    text-decoration: none;
  }
  .editorial-hero__destinations a + a {
    border-inline-start: 1px solid var(--color-border);
  }
  .editorial-hero__destinations a > span {
    color: var(--color-muted);
    font-size: 11px;
  }
  .editorial-hero__destinations .icon {
    margin-inline-start: auto;
    flex-shrink: 0;
  }
  .editorial-hero__destinations a:hover {
    color: var(--color-accent);
  }
  @media screen and (min-width: 990px) {
    .editorial-hero__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    }
    .editorial-hero__copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 48px clamp(32px, 4vw, 76px);
    }
    .editorial-hero h1 {
      font-size: clamp(76px, 7.5vw, 128px);
    }
    .editorial-hero:lang(en) h1 {
      font-size: clamp(48px, 4.3vw, 78px);
    }
    .editorial-hero:lang(ar) h1 {
      font-size: clamp(50px, 4.5vw, 78px);
    }
    .editorial-hero__intro {
      font-size: 17px;
    }
    .editorial-hero__signature {
      display: block;
      margin: 38px 0 0;
      font-size: 10px;
      letter-spacing: 0.24em;
      color: var(--color-muted);
      text-align: start;
    }
    .editorial-hero__visual {
      display: flex;
      flex-direction: column;
      justify-content: end;
    }
    .editorial-hero__image {
      flex: 1;
      min-block-size: 0;
      aspect-ratio: auto;
      block-size: 100%;
      max-block-size: 620px;
      object-position: 18% center;
    }
    .editorial-hero__destinations a {
      padding: 22px 28px;
      font-size: 15px;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Editorial hero",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-night" },
    { "type": "image_picker", "id": "image", "label": "Campaign image" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "highlight", "label": "Highlighted heading" },
    { "type": "textarea", "id": "intro", "label": "Introduction" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [{ "name": "Editorial hero" }]
}
{% endschema %}
