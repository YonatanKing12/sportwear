{%- comment -%}
  Business details as a definition list: business name, business ID, address, phone, email and
  WhatsApp, from Theme settings > Business details (Israeli consumer law requires online sellers to
  publish them; also used on the accessibility statement page). Only the details that are set are
  shown; phone, email and WhatsApp can be turned off where a contact card already shows them. When
  nothing is set, the storefront shows nothing and the theme editor shows a reminder.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'pages.business_details.heading' | t
  endif

  assign phone_href = settings.support_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'

  assign support_phone = ''
  assign support_email = ''
  assign whatsapp_digits = ''
  if section.settings.show_channels
    assign support_phone = settings.support_phone
    assign support_email = settings.support_email | strip
    assign whatsapp_digits = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  endif

  assign has_details = false
  if settings.business_name != blank or settings.business_id != blank or settings.business_address != blank
    assign has_details = true
  elsif support_phone != blank or support_email != blank or whatsapp_digits != blank
    assign has_details = true
  endif
-%}
{%- if has_details or request.design_mode -%}
  <div
    class="section business-details color-{{ section.settings.color_scheme.id }}"
    style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      <div class="business-details__inner business-details__inner--{{ section.settings.content_width }}">
        <h2 class="title-l business-details__heading">{{ heading }}</h2>
        {%- if has_details -%}
          <dl class="business-details__list">
            {%- if settings.business_name != blank -%}
              <div class="business-details__item">
                <dt class="business-details__term">{{ 'pages.business_details.name' | t }}</dt>
                <dd class="business-details__value">{{ settings.business_name | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if settings.business_id != blank -%}
              <div class="business-details__item">
                <dt class="business-details__term">{{ 'pages.business_details.id' | t }}</dt>
                <dd class="business-details__value">
                  <bdi>{{ settings.business_id | escape }}</bdi>
                </dd>
              </div>
            {%- endif -%}
            {%- if settings.business_address != blank -%}
              <div class="business-details__item">
                <dt class="business-details__term">{{ 'pages.business_details.address' | t }}</dt>
                <dd class="business-details__value">
                  <bdi>{{ settings.business_address | escape }}</bdi>
                </dd>
              </div>
            {%- endif -%}
            {%- if support_phone != blank -%}
              <div class="business-details__item">
                <dt class="business-details__term">{{ 'pages.business_details.phone' | t }}</dt>
                <dd class="business-details__value">
                  <a class="business-details__link" href="tel:{{ phone_href | escape }}" dir="ltr">
                    {{- support_phone | escape -}}
                  </a>
                </dd>
              </div>
            {%- endif -%}
            {%- if support_email != blank -%}
              <div class="business-details__item">
                <dt class="business-details__term">{{ 'pages.business_details.email' | t }}</dt>
                <dd class="business-details__value">
                  <a
                    class="business-details__link"
                    href="mailto:{{ support_email | escape }}"
                    dir="ltr"
                  >
                    {{- support_email | escape -}}
                  </a>
                </dd>
              </div>
            {%- endif -%}
            {%- if whatsapp_digits != blank -%}
              <div class="business-details__item">
                <dt class="business-details__term">{{ 'pages.business_details.whatsapp' | t }}</dt>
                <dd class="business-details__value">
                  <a
                    class="business-details__link"
                    href="https://wa.me/{{ whatsapp_digits }}"
                    target="_blank"
                    rel="noopener"
                  >
                    {%- render 'icon', name: 'whatsapp', size: 18 -%}
                    <span>{{ 'pages.business_details.whatsapp_link' | t }}</span>
                    <span class="visually-hidden">({{ 'accessibility.new_window' | t }})</span>
                  </a>
                </dd>
              </div>
            {%- endif -%}
          </dl>
        {%- else -%}
          <p class="business-details__editor-note">{{ 'pages.business_details.editor_note' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .business-details__inner {
    display: grid;
    gap: var(--space-5);
    margin-inline: auto;
  }

  .business-details__inner--narrow {
    max-inline-size: 760px;
  }

  .business-details__list {
    display: grid;
    gap: var(--space-3);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .business-details__inner--normal .business-details__list {
    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .business-details__item {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .business-details__term {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .business-details__value {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .business-details__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--touch-target);
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .business-details__editor-note {
    padding: var(--space-3);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.business_details.name",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.business_details.settings.info.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.business_details.settings.content_width.label",
      "options": [
        {
          "value": "narrow",
          "label": "t:sections.business_details.settings.content_width.options.narrow"
        },
        {
          "value": "normal",
          "label": "t:sections.business_details.settings.content_width.options.normal"
        }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "show_channels",
      "label": "t:sections.business_details.settings.show_channels.label",
      "info": "t:sections.business_details.settings.show_channels.info",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:sections.business_details.name"
    }
  ]
}
{% endschema %}
