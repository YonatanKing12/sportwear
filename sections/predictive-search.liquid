{%- comment -%}
  Render-only section for the header search suggestions (Predictive Search API + Section Rendering
  API): {{ routes.predictive_search_url }}?q=…&resources[type]=product,collection,query&section_id=predictive-search.
  assets/predictive-search.js replaces the children of the search sheet's [data-predictive-search-results]
  with the [data-predictive-search] element below, then reads the options of #PredictiveSearchListbox
  (ids are unique within one response) and announces [data-predictive-search-announcement].
  Every option is a real link (role="option"), so clicks, middle-clicks and "open in new tab" work.
  Not addable in the theme editor (no presets).
{%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- liquid
    assign terms = predictive_search.terms
    assign queries = predictive_search.resources.queries
    assign collections = predictive_search.resources.collections
    assign products = predictive_search.resources.products
    assign result_count = queries.size | plus: collections.size | plus: products.size
  -%}
  <div class="predictive-search" data-predictive-search>
    <div hidden data-predictive-search-announcement>
      {%- if result_count > 0 -%}
        {{- 'predictive_search.results_count' | t: count: result_count -}}
      {%- else -%}
        {{- 'predictive_search.no_results' | t: terms: terms -}}
      {%- endif -%}
    </div>

    {%- if result_count == 0 -%}
      <div class="predictive-search__empty">
        <p class="predictive-search__empty-title">{{ 'predictive_search.no_results' | t: terms: terms }}</p>
        <p class="predictive-search__empty-hint">{{ 'predictive_search.no_results_hint' | t }}</p>
      </div>
    {%- endif -%}

    <div
      id="PredictiveSearchListbox"
      class="predictive-search__listbox"
      role="listbox"
      aria-label="{{ 'predictive_search.label' | t }}"
    >
      {%- if queries.size > 0 or collections.size > 0 -%}
        <div class="predictive-search__aside">
          {%- if queries.size > 0 -%}
            <div class="predictive-search__group" role="group" aria-labelledby="PredictiveSearchGroup-queries">
              <div id="PredictiveSearchGroup-queries" class="predictive-search__heading">
                {{- 'predictive_search.suggestions' | t -}}
              </div>
              {%- for query in queries -%}
                <a
                  id="PredictiveSearchOption-query-{{ forloop.index }}"
                  class="predictive-search__option predictive-search__query"
                  href="{{ query.url }}"
                  role="option"
                  aria-selected="false"
                  tabindex="-1"
                >
                  {%- render 'icon', name: 'search', size: 18 -%}
                  <span>{{ query.styled_text }}</span>
                </a>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if collections.size > 0 -%}
            <div class="predictive-search__group" role="group" aria-labelledby="PredictiveSearchGroup-collections">
              <div id="PredictiveSearchGroup-collections" class="predictive-search__heading">
                {{- 'predictive_search.collections' | t -}}
              </div>
              <div class="predictive-search__chips">
                {%- for collection in collections -%}
                  <a
                    id="PredictiveSearchOption-collection-{{ collection.id }}"
                    class="chip predictive-search__option"
                    href="{{ collection.url }}"
                    role="option"
                    aria-selected="false"
                    tabindex="-1"
                  >
                    {{- collection.title | escape -}}
                  </a>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if products.size > 0 -%}
        <div
          class="predictive-search__group predictive-search__group--products"
          role="group"
          aria-labelledby="PredictiveSearchGroup-products"
        >
          <div id="PredictiveSearchGroup-products" class="predictive-search__heading">
            {{- 'predictive_search.products' | t -}}
          </div>
          <div class="predictive-search__products">
            {%- for product in products -%}
              {%- liquid
                assign subtitle = ''
                case settings.card_subtitle
                  when 'team'
                    assign team = product.metafields.sportwear.team.value
                    if team != blank
                      assign subtitle = team.name.value
                    endif
                  when 'vendor'
                    assign subtitle = product.vendor
                endcase
              -%}
              <a
                id="PredictiveSearchOption-product-{{ product.id }}"
                class="predictive-search__option predictive-search__product"
                href="{{ product.url }}"
                role="option"
                aria-selected="false"
                tabindex="-1"
              >
                <div class="predictive-search__media media-tile">
                  {%- render 'image',
                    image: product.featured_media.preview_image,
                    sizes: '(min-width: 990px) 180px, 64px',
                    widths: '64, 128, 192, 256, 384',
                    alt: ''
                  -%}
                </div>
                <div class="predictive-search__info">
                  {%- if subtitle != blank -%}
                    <span class="predictive-search__subtitle">{{ subtitle | escape }}</span>
                  {%- endif -%}
                  <span class="predictive-search__title">{{ product.title | escape }}</span>
                  {%- render 'price', product: product, class: 'predictive-search__price' -%}
                  {%- unless product.available -%}
                    <span class="badge badge--sold-out">{{ 'general.badges.sold_out' | t }}</span>
                  {%- endunless -%}
                </div>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="predictive-search__footer">
        <a
          id="PredictiveSearchOption-all"
          class="predictive-search__option predictive-search__all"
          href="{{ routes.search_url }}?q={{ terms | url_encode }}&amp;options%5Bprefix%5D=last"
          role="option"
          aria-selected="false"
          tabindex="-1"
        >
          <span>
            {%- if result_count > 0 -%}
              {{- 'predictive_search.view_all' | t: terms: terms -}}
            {%- else -%}
              {{- 'predictive_search.search_all' | t: terms: terms -}}
            {%- endif -%}
          </span>
          {%- render 'icon', name: 'arrow-forward', size: 18 -%}
        </a>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .predictive-search {
    display: grid;
    gap: var(--space-5);
    max-inline-size: calc(var(--page-width, 1440px) + var(--gutter) * 2);
    margin-inline: auto;
    padding: var(--space-4) var(--gutter) var(--space-6);
  }

  .predictive-search__empty {
    display: grid;
    gap: var(--space-1);
  }

  .predictive-search__empty-title {
    font-size: var(--text-lg);
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .predictive-search__empty-hint {
    color: var(--color-muted);
    font-size: var(--text-md);
  }

  .predictive-search__listbox {
    display: grid;
    gap: var(--space-6);

    @media screen and (min-width: 990px) {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: var(--space-6) var(--space-10);
    }
  }

  .predictive-search__aside,
  .predictive-search__group {
    display: grid;
    align-content: start;
    min-inline-size: 0;
  }

  .predictive-search__aside {
    gap: var(--space-6);

    @media screen and (min-width: 990px) {
      flex: 0 0 min(280px, 30%);
    }
  }

  .predictive-search__group--products {
    @media screen and (min-width: 990px) {
      flex: 1 1 0;
    }
  }

  .predictive-search__group {
    gap: var(--space-2);
  }

  .predictive-search__heading {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .predictive-search__option {
    color: inherit;
    text-decoration: none;

    &[aria-selected='true'] {
      outline: 2px solid var(--color-text);
      outline-offset: 2px;
    }
  }

  .predictive-search__query {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--touch-target);
    padding-inline: var(--space-2);
    border-radius: var(--radius-button);
    overflow-wrap: anywhere;

    &:hover,
    &[aria-selected='true'] {
      background: var(--color-surface);
    }

    & .icon {
      color: var(--color-muted);
    }

    & mark {
      background: none;
      color: inherit;
      font-weight: 800;
    }
  }

  .predictive-search__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .predictive-search__products {
    display: grid;
    gap: var(--space-1);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2) var(--grid-gap);
    }

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-6) var(--grid-gap);
    }
  }

  .predictive-search__product {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-content: start;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-card);

    &:hover,
    &[aria-selected='true'] {
      background: var(--color-surface);
    }

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 10px;
      padding: 0;

      &:hover,
      &[aria-selected='true'] {
        background: none;
      }

      &:hover .predictive-search__title {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
    }
  }

  .predictive-search__info {
    display: grid;
    justify-items: start;
    gap: 2px;
    min-inline-size: 0;
  }

  .predictive-search__subtitle {
    color: var(--color-muted);
    font-size: calc(12.5px * var(--body-scale, 1));
    font-weight: 600;
  }

  .predictive-search__title {
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .predictive-search__price {
    font-size: var(--text-base);
  }

  .predictive-search__footer {
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-border);

    @media screen and (min-width: 990px) {
      flex: 0 0 100%;
    }
  }

  .predictive-search__all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--touch-target);
    padding-inline: var(--space-2);
    border-radius: var(--radius-button);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.predictive_search.name",
  "tag": "div",
  "settings": []
}
{% endschema %}
