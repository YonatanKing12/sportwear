{%- comment -%}
  Render-only section for the header search suggestions (Predictive Search API + Section Rendering
  API): {{ routes.predictive_search_url }}?q=…&resources[type]=product,collection,query&section_id=predictive-search
  (see assets/predictive-search.js for the other parameters). The script puts the
  [data-predictive-search] element below into the header's panel, reads the options of
  #PredictiveSearchListbox (ids are unique within one response) and announces
  [data-predictive-search-announcement].
  Order: matching categories (chips), products (image, title, price, sold out), query suggestions,
  then "all results", which opens the search page. When nothing matches, it says so and offers the
  main menu's top-level categories instead (links to empty collections left out).
  Every option is a real link (role="option"), so clicks, middle-clicks and "open in new tab" work.
  Its CSS is in assets/predictive-search.css (sections fetched later miss {% stylesheet %} CSS).
  Not addable in the theme editor (no presets).
{%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- liquid
    assign terms = predictive_search.terms
    assign queries = predictive_search.resources.queries
    assign collections = predictive_search.resources.collections
    assign products = predictive_search.resources.products

    assign shown_collections = collections.size | at_most: 6
    assign shown_products = products.size | at_most: 6
    assign shown_queries = queries.size | at_most: 4
    assign result_count = shown_collections | plus: shown_products | plus: shown_queries

    assign encoded_terms = terms | url_encode
    assign search_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last'
  -%}
  <div class="predictive-search" data-predictive-search>
    <div hidden data-predictive-search-announcement>
      {%- if result_count > 0 -%}
        {{- 'predictive_search.results_count' | t: count: result_count -}}
      {%- else -%}
        {{- 'predictive_search.no_results' | t: terms: terms -}}
      {%- endif -%}
    </div>

    {%- if result_count == 0 -%}
      <div class="predictive-search__empty">
        <p class="predictive-search__empty-title">{{ 'predictive_search.no_results' | t: terms: terms }}</p>
        <p class="predictive-search__empty-hint">{{ 'predictive_search.no_results_hint' | t }}</p>
      </div>
    {%- endif -%}

    <div
      id="PredictiveSearchListbox"
      class="predictive-search__listbox"
      role="listbox"
      aria-label="{{ 'predictive_search.label' | t }}"
    >
      {%- if shown_collections > 0 -%}
        <div class="predictive-search__group" role="group" aria-labelledby="PredictiveSearchGroup-collections">
          <div id="PredictiveSearchGroup-collections" class="predictive-search__heading">
            {{- 'predictive_search.collections' | t -}}
          </div>
          <div class="predictive-search__chips">
            {%- for collection in collections limit: 6 -%}
              <a
                id="PredictiveSearchOption-collection-{{ collection.id }}"
                class="chip predictive-search__option predictive-search__chip"
                href="{{ collection.url }}"
                role="option"
                aria-selected="false"
                tabindex="-1"
              >
                {{- collection.title | escape -}}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if shown_products > 0 -%}
        <div class="predictive-search__group" role="group" aria-labelledby="PredictiveSearchGroup-products">
          <div id="PredictiveSearchGroup-products" class="predictive-search__heading">
            {{- 'predictive_search.products' | t -}}
          </div>
          <div class="predictive-search__products">
            {%- for product in products limit: 6 -%}
              {%- liquid
                assign subtitle = ''
                case settings.card_subtitle
                  when 'team'
                    assign team = product.metafields.sportwear.team.value
                    if team != blank
                      assign subtitle = team.name.value
                    endif
                  when 'vendor'
                    assign subtitle = product.vendor
                endcase
              -%}
              <a
                id="PredictiveSearchOption-product-{{ product.id }}"
                class="predictive-search__option predictive-search__product"
                href="{{ product.url }}"
                role="option"
                aria-selected="false"
                tabindex="-1"
              >
                <span class="predictive-search__media media-tile">
                  {%- render 'image',
                    image: product.featured_media.preview_image,
                    sizes: '64px',
                    widths: '64, 128, 192',
                    alt: ''
                  -%}
                </span>
                <span class="predictive-search__info">
                  {%- if subtitle != blank -%}
                    <span class="predictive-search__subtitle">{{ subtitle | escape }}</span>
                  {%- endif -%}
                  <span class="predictive-search__title">{{ product.title | escape }}</span>
                  <span class="predictive-search__meta">
                    {%- render 'price', product: product, class: 'predictive-search__price' -%}
                    {%- unless product.available -%}
                      <span class="badge badge--sold-out">{{ 'general.badges.sold_out' | t }}</span>
                    {%- endunless -%}
                  </span>
                </span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if shown_queries > 0 -%}
        <div class="predictive-search__group" role="group" aria-labelledby="PredictiveSearchGroup-queries">
          <div id="PredictiveSearchGroup-queries" class="predictive-search__heading">
            {{- 'predictive_search.suggestions' | t -}}
          </div>
          <div class="predictive-search__queries">
            {%- for query in queries limit: 4 -%}
              <a
                id="PredictiveSearchOption-query-{{ forloop.index }}"
                class="predictive-search__option predictive-search__query"
                href="{{ query.url }}"
                role="option"
                aria-selected="false"
                tabindex="-1"
              >
                {%- render 'icon', name: 'search', size: 18 -%}
                <span>{{ query.styled_text }}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if result_count == 0 -%}
        {%- liquid
          # The main menu's top-level links, without links to collections that have no products.
          assign menu = linklists['main-menu']
        -%}
        {%- if menu.links.size > 0 -%}
          <div class="predictive-search__group" role="group" aria-labelledby="PredictiveSearchGroup-browse">
            <div id="PredictiveSearchGroup-browse" class="predictive-search__heading">
              {{- 'predictive_search.browse' | t -}}
            </div>
            <div class="predictive-search__chips">
              {%- for link in menu.links -%}
                {%- liquid
                  assign link_empty = false
                  if link.type == 'collection_link'
                    if link.object.all_products_count == 0
                      assign link_empty = true
                    endif
                  endif
                  if link.url == blank or link.url == '#'
                    assign link_empty = true
                  endif
                -%}
                {%- unless link_empty -%}
                  <a
                    id="PredictiveSearchOption-browse-{{ forloop.index }}"
                    class="chip predictive-search__option predictive-search__chip"
                    href="{{ link.url }}"
                    role="option"
                    aria-selected="false"
                    tabindex="-1"
                  >
                    {{- link.title | escape -}}
                  </a>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

      <a
        id="PredictiveSearchOption-all"
        class="predictive-search__option predictive-search__all"
        href="{{ search_url | escape }}"
        role="option"
        aria-selected="false"
        tabindex="-1"
      >
        <span class="predictive-search__all-text">
          {%- if result_count > 0 -%}
            {{- 'predictive_search.view_all' | t: terms: terms -}}
          {%- else -%}
            {{- 'predictive_search.search_all' | t: terms: terms -}}
          {%- endif -%}
        </span>
        {%- render 'icon', name: 'arrow-forward', size: 18 -%}
      </a>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.predictive_search.name",
  "tag": "div",
  "settings": []
}
{% endschema %}
