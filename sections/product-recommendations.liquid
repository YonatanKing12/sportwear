{%- comment -%}
  Product recommendations ("You may also like" / complementary products) for the product template.
  Rendered first as a skeleton that reserves the grid's space; assets/product-recommendations.js
  loads the real products from routes.product_recommendations_url (Section Rendering API) when the
  section nears the viewport, and hides the section when there is nothing to recommend.
  "You may also like" first tries the product's own team: when it has a team:<slug> tag whose
  collection holds at least two other products in stock, those are shown right away (the same
  audience first), since Shopify's recommendations have no sales to learn from yet and often suggest
  another sport. Without a team page, a hoodie gets the NFL hoodies of its audience and other
  products their league's page (sportwear.league_handle).
{%- endcomment -%}
{%- liquid
  assign columns = section.settings.columns_desktop
  assign columns_tablet = columns | at_most: 3
  assign limit = section.settings.products_to_show

  assign heading = section.settings.heading | escape
  if heading == blank
    if section.settings.intent == 'complementary'
      assign heading = 'products.recommendations.heading_complementary' | t
    else
      assign heading = 'products.recommendations.heading' | t
    endif
  endif

  assign team_collection = blank
  if recommendations.performed? != true and section.settings.intent != 'complementary' and product != blank
    for tag in product.tags
      assign team_prefix = tag | slice: 0, 5
      if team_prefix == 'team:'
        assign team_handle = tag | remove_first: 'team:'
        assign team_collection = collections[team_handle]
        break
      endif
    endfor

    # No team page with other products (the NFL teams have none): the hoodies of the same audience, else
    # the product's league, before Shopify's recommendations (which suggested football shirts for hoodies).
    if team_collection == blank or team_collection.all_products_count < 3
      if product.type == 'Hoodie'
        if product.tags contains 'audience:kids'
          assign team_collection = collections['nfl-hoodies-kids']
        elsif product.tags contains 'audience:women'
          assign team_collection = collections['nfl-hoodies-women']
        else
          assign team_collection = collections['nfl-hoodies-men']
        endif
      else
        assign league_handle = product.metafields.sportwear.league_handle.value
        if league_handle != blank and collections[league_handle].all_products_count > 2
          assign team_collection = collections[league_handle]
        endif
      endif
    endif
  endif
  assign is_kids = false
  if product.tags contains 'audience:kids'
    assign is_kids = true
  endif

  assign gaps_desktop = columns | minus: 1 | times: 20 | plus: 64
  assign card_sizes = '(min-width: 990px) calc((min(100vw, 1440px) - ' | append: gaps_desktop | append: 'px) / ' | append: columns | append: '), (min-width: 750px) calc((100vw - 104px) / ' | append: columns_tablet | append: '), calc((100vw - 52px) / 2)'

  assign team_count = 0
  if team_collection != blank
    capture team_cards
      for pass in (1..2)
        for item in team_collection.products
          if team_count >= limit
            break
          endif
          if item.id == product.id or item.available == false
            continue
          endif
          assign item_kids = false
          if item.tags contains 'audience:kids'
            assign item_kids = true
          endif
          if pass == 1 and item_kids != is_kids
            continue
          endif
          if pass == 2 and item_kids == is_kids
            continue
          endif
          echo '<li class="product-recommendations__item" data-recommendation>'
          render 'product-card', product: item, sizes: card_sizes
          echo '</li>'
          assign team_count = team_count | plus: 1
        endfor
      endfor
    endcapture
  endif
-%}
<sw-product-recommendations
  class="section product-recommendations color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  data-url="{{ routes.product_recommendations_url }}"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
  data-limit="{{ limit }}"
  data-intent="{{ section.settings.intent }}"
  {% unless recommendations.performed? or team_count >= 2 %}
    aria-busy="true"
  {% endunless %}
>
  <div class="page-width">
    {%- if team_count >= 2 -%}
      <div class="section-header">
        <h2 class="product-recommendations__heading display-m">{{ heading }}</h2>
      </div>
      <ul
        class="grid product-recommendations__grid"
        role="list"
        style="--grid-cols: 2; --grid-cols-tablet: {{ columns_tablet }}; --grid-cols-desktop: {{ columns }};"
      >
        {{- team_cards -}}
      </ul>
    {%- elsif recommendations.performed? -%}
      {%- if recommendations.products_count > 0 -%}
        <div class="section-header">
          <h2 class="product-recommendations__heading display-m">{{ heading }}</h2>
        </div>
        <ul
          class="grid product-recommendations__grid"
          role="list"
          style="--grid-cols: 2; --grid-cols-tablet: {{ columns_tablet }}; --grid-cols-desktop: {{ columns }};"
        >
          {%- for recommendation in recommendations.products -%}
            <li class="product-recommendations__item" data-recommendation>
              {%- render 'product-card', product: recommendation, sizes: card_sizes -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- else -%}
      <div class="product-recommendations__skeleton" aria-hidden="true">
        <div class="section-header">
          <span class="product-recommendations__bar product-recommendations__bar--heading"></span>
        </div>
        <div
          class="grid"
          style="--grid-cols: 2; --grid-cols-tablet: {{ columns_tablet }}; --grid-cols-desktop: {{ columns }};"
        >
          {%- for i in (1..limit) -%}
            <div class="product-recommendations__placeholder">
              <span class="media-tile"></span>
              <span class="product-recommendations__bar product-recommendations__bar--short"></span>
              <span class="product-recommendations__bar"></span>
              <span class="product-recommendations__bar product-recommendations__bar--price"></span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</sw-product-recommendations>

<script type="module" src="{{ 'product-recommendations.js' | asset_url }}"></script>

{% stylesheet %}
  .product-recommendations {
    display: block;
  }

  .product-recommendations__heading {
    min-inline-size: 0;
  }

  .product-recommendations__placeholder {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product-recommendations__bar {
    display: block;
    block-size: 14px;
    inline-size: 80%;
    border-radius: var(--radius-badge);
    background: var(--color-surface);
  }

  .product-recommendations__bar--short {
    block-size: 12px;
    inline-size: 45%;
  }

  .product-recommendations__bar--price {
    block-size: 17px;
    inline-size: 30%;
  }

  .product-recommendations__bar--heading {
    block-size: calc(var(--display-m) * 0.94);
    inline-size: min(60%, 320px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-recommendations__skeleton {
      animation: product-recommendations-pulse 1.4s ease-in-out infinite;
    }
  }

  @keyframes product-recommendations-pulse {
    50% {
      opacity: 0.55;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "class": "product-recommendations-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.product_recommendations.settings.intent",
      "info": "t:sections.product_recommendations.settings.intent_info",
      "options": [
        {
          "value": "related",
          "label": "t:sections.product_recommendations.options.related"
        },
        {
          "value": "complementary",
          "label": "t:sections.product_recommendations.options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "t:settings.products_to_show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:settings.columns_desktop",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_recommendations.name"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
