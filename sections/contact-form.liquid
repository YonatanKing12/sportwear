{%- comment -%}
  Contact form (Shopify contact form: messages go to the store's sender email) with a side card
  for quick channels: WhatsApp (prefilled message), phone, email and opening hours. Phone, email
  and WhatsApp come from Theme settings > Business details. Validation is accessible: required
  markers, errors linked to their fields, and an error summary / success status that receives
  focus after the page reloads (assets/content-form.js).
  Note: keep one contact-type form per page (this section or team-orders); Shopify reports the
  submission state to every contact form on the page.
{%- endcomment -%}
{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign name_id = form_id | append: '-name'
  assign email_id = form_id | append: '-email'
  assign phone_id = form_id | append: '-phone'
  assign body_id = form_id | append: '-body'

  assign whatsapp_digits = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign phone_href = settings.support_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign whatsapp_message = 'contact.card.whatsapp_message' | t: shop: shop.name | url_encode | replace: '+', '%20'

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'contact.heading' | t
  endif
  assign intro = section.settings.text
  if intro == blank
    assign intro = 'contact.text' | t
  endif
  assign card_heading = section.settings.card_heading
  if card_heading == blank
    assign card_heading = 'contact.card.heading' | t
  endif

  assign has_channels = false
  if whatsapp_digits != blank or settings.support_phone != blank or settings.support_email != blank or section.settings.hours != blank
    assign has_channels = true
  endif
  assign show_card = false
  if section.settings.show_card
    if has_channels or request.design_mode
      assign show_card = true
    endif
  endif
-%}
<div
  class="section contact-form color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="contact-form__layout{% if show_card %} contact-form__layout--with-card{% endif %}">
      {%- if show_card -%}
        <aside class="contact-form__card" aria-labelledby="ContactCardHeading-{{ section.id }}">
          <h2 class="contact-form__card-heading title-m" id="ContactCardHeading-{{ section.id }}">
            {{ card_heading }}
          </h2>
          {%- if has_channels -%}
            {%- if whatsapp_digits != blank -%}
              <a
                class="button button--primary button--full contact-form__whatsapp"
                href="https://wa.me/{{ whatsapp_digits }}?text={{ whatsapp_message }}"
                target="_blank"
                rel="noopener"
              >
                {%- render 'icon', name: 'whatsapp', size: 20 -%}
                <span>{{ 'contact.card.whatsapp' | t }}</span>
                <span class="visually-hidden">({{ 'accessibility.new_window' | t }})</span>
              </a>
            {%- endif -%}
            <dl class="contact-form__channels">
              {%- if settings.support_phone != blank -%}
                <div class="contact-form__channel">
                  <dt class="contact-form__channel-label">
                    {%- render 'icon', name: 'phone', size: 18 -%}
                    {{- 'contact.card.phone' | t -}}
                  </dt>
                  <dd class="contact-form__channel-value">
                    <a class="contact-form__channel-link" href="tel:{{ phone_href | escape }}" dir="ltr">
                      {{- settings.support_phone | escape -}}
                    </a>
                  </dd>
                </div>
              {%- endif -%}
              {%- if settings.support_email != blank -%}
                <div class="contact-form__channel">
                  <dt class="contact-form__channel-label">
                    {%- render 'icon', name: 'mail', size: 18 -%}
                    {{- 'contact.card.email' | t -}}
                  </dt>
                  <dd class="contact-form__channel-value">
                    <a
                      class="contact-form__channel-link"
                      href="mailto:{{ settings.support_email | strip | escape }}"
                      dir="ltr"
                    >
                      {{- settings.support_email | strip | escape -}}
                    </a>
                  </dd>
                </div>
              {%- endif -%}
              {%- if section.settings.hours != blank -%}
                <div class="contact-form__channel">
                  <dt class="contact-form__channel-label">
                    {%- render 'icon', name: 'info', size: 18 -%}
                    {{- 'contact.card.hours' | t -}}
                  </dt>
                  <dd class="contact-form__channel-value contact-form__hours">{{ section.settings.hours }}</dd>
                </div>
              {%- endif -%}
            </dl>
          {%- else -%}
            <p class="contact-form__editor-note">{{ 'contact.editor.no_channels' | t }}</p>
          {%- endif -%}
        </aside>
      {%- endif -%}

      <div class="contact-form__main">
        <div class="contact-form__header">
          <h2 class="contact-form__heading title-l">{{ heading }}</h2>
          <p class="contact-form__text">{{ intro }}</p>
        </div>
        <sw-validated-form
          data-error-required="{{ 'pages.form.errors.required' | t }}"
          data-error-email="{{ 'pages.form.errors.email' | t }}"
          data-error-invalid="{{ 'pages.form.errors.invalid' | t }}"
        >
          {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
            {%- liquid
              assign success_message = 'contact.form.success' | t
              assign email_error = ''
              if form.errors contains 'email'
                assign email_error = 'pages.form.errors.email' | t
              endif
              assign body_error = ''
              if form.errors contains 'body'
                assign body_error = 'pages.form.errors.required' | t
              endif

              assign name_value = ''
              assign email_value = form.email
              if customer
                assign name_value = customer.name
                if email_value == blank
                  assign email_value = customer.email
                endif
              endif
              assign body_value = ''
              unless form.posted_successfully?
                assign body_value = form.body
              endunless

              assign name_label = 'contact.form.name' | t
              assign email_label = 'contact.form.email' | t
              assign phone_label = 'contact.form.phone' | t
              assign body_label = 'contact.form.message' | t
              assign body_hint = 'contact.form.message_hint' | t
              assign email_placeholder = 'pages.form.email_placeholder' | t
            -%}
            {%- render 'content-form-status', form: form, form_id: form_id, success: success_message -%}
            <p class="contact-form__note">{{ 'pages.form.required_note' | t }}</p>
            <div class="contact-form__fields">
              {%- render 'content-field',
                id: name_id,
                name: 'contact[name]',
                label: name_label,
                required: true,
                value: name_value,
                autocomplete: 'name'
              -%}
              {%- render 'content-field',
                id: email_id,
                name: 'contact[email]',
                type: 'email',
                label: email_label,
                required: true,
                value: email_value,
                autocomplete: 'email',
                dir: 'ltr',
                placeholder: email_placeholder,
                error: email_error
              -%}
              {%- render 'content-field',
                id: phone_id,
                name: 'contact[phone]',
                type: 'tel',
                label: phone_label,
                autocomplete: 'tel',
                dir: 'ltr'
              -%}
              {%- render 'content-field',
                id: body_id,
                name: 'contact[body]',
                type: 'textarea',
                label: body_label,
                required: true,
                value: body_value,
                hint: body_hint,
                error: body_error,
                rows: 6,
                class: 'contact-form__field--full'
              -%}
            </div>
            <button class="button button--primary button--large contact-form__submit" type="submit">
              {{- 'contact.form.submit' | t -}}
            </button>
          {%- endform -%}
        </sw-validated-form>
      </div>
    </div>
  </div>
</div>
<script type="module" src="{{ 'content-form.js' | asset_url }}"></script>

{% stylesheet %}
  .contact-form__layout {
    display: grid;
    gap: var(--space-8);

    @media screen and (min-width: 990px) {
      gap: var(--space-12);
      align-items: start;
    }
  }

  .contact-form__layout--with-card {
    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(280px, 1fr) minmax(0, 2fr);
    }
  }

  .contact-form__card {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-surface);

    @media screen and (min-width: 750px) {
      padding: var(--space-8);
    }
  }

  .contact-form__whatsapp .icon {
    flex-shrink: 0;
  }

  .contact-form__channels {
    display: grid;
    gap: var(--space-4);
  }

  .contact-form__channel {
    display: grid;
    gap: 2px;
  }

  .contact-form__channel-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .contact-form__channel-value {
    margin: 0;
    padding-inline-start: calc(18px + var(--space-2));
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .contact-form__channel-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-form__hours {
    font-weight: 500;

    & > * + * {
      margin-block-start: var(--space-1);
    }
  }

  .contact-form__main {
    display: grid;
    gap: var(--space-5);
    min-inline-size: 0;
    max-inline-size: 820px;
  }

  .contact-form__header {
    display: grid;
    gap: var(--space-2);
  }

  .contact-form__text {
    color: var(--color-muted);
  }

  .contact-form__note {
    margin-block-end: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .contact-form__fields {
    display: grid;
    align-items: end;
    gap: var(--space-5) var(--space-4);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form__submit {
    inline-size: 100%;
    margin-block-start: var(--space-6);

    @media screen and (min-width: 750px) {
      inline-size: auto;
      min-inline-size: 240px;
    }
  }

  .contact-form__editor-note {
    padding: var(--space-3);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.card.content"
    },
    {
      "type": "checkbox",
      "id": "show_card",
      "label": "t:sections.contact_form.settings.show_card.label",
      "info": "t:sections.contact_form.settings.show_card.info",
      "default": true
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "t:sections.contact_form.settings.card_heading.label",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "t:sections.contact_form.settings.hours.label",
      "info": "t:sections.contact_form.settings.hours.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.name"
    }
  ]
}
{% endschema %}
