{%- comment -%}
  Collection tabs: one row of products with tabs above it, one tab per collection (for example the
  big football leagues). Each tab is a block; its label is the collection's own (translated) title.
  Every tab's row is rendered here (images load lazily, and only once a tab is shown), so switching
  is instant: assets/collection-tabs.js (<sw-collection-tabs>) turns the chips into an ARIA tab list
  with arrow-key, Home and End support (arrows follow the page direction). Without JavaScript the
  first tab's row shows, with the other collections as plain links. Each row scrolls sideways like
  the featured collection's (<sw-carousel>), ends with a "view all" tile, and shows up to
  "products per tab" products, optionally one per team and only adults or only kids, out of the first
  40 of its collection (every tab renders on the page, so each one reads few products).
{%- endcomment -%}
{%- liquid
  # Further down a page (after its third section) this section can wait until the visitor scrolls near
  # it: it renders as an outline (snippets/deferred-section.liquid) and assets/deferred-section.js loads
  # it through the Section Rendering API, where section.index is nil, as in the theme editor, so both
  # render it in full. A long page stays within Shopify's render time this way.
  assign defer_render = false
  if section.settings.lazy_render and section.index > 3
    assign defer_render = true
  endif
-%}
{%- if defer_render -%}
  {%- render 'deferred-section',
    section_id: section.id,
    color_scheme: section.settings.color_scheme.id,
    min_height: 720,
    min_height_desktop: 780,
    shape: 'row'
  -%}
{%- else -%}
  {%- liquid
    assign copy = section.settings.copy | default: 'none'
    assign eyebrow = section.settings.eyebrow | escape
    assign heading = section.settings.heading | escape
    assign text = section.settings.text | escape
    if copy != 'none'
      assign copy_key = 'home.collection_tabs.copy.' | append: copy
      if eyebrow == blank
        assign eyebrow = copy_key | append: '.eyebrow' | t
      endif
      if heading == blank
        assign heading = copy_key | append: '.heading' | t
      endif
      if text == blank
        assign text = copy_key | append: '.text' | t
      endif
    endif
    if heading == blank
      assign heading = 'home.collection_tabs.heading' | t
    endif

    assign limit = section.settings.products_per_tab
    assign heading_id = 'CollectionTabsHeading-' | append: section.id
    assign mobile_visible = 1.5
    assign columns_desktop = section.settings.columns_desktop
    assign columns_tablet = columns_desktop | at_most: 3
    capture card_sizes
      echo '(min-width: 990px) calc((min(100vw, '
      echo settings.page_width
      echo 'px) - 64px) / '
      echo columns_desktop
      echo '), (min-width: 750px) calc((100vw - 64px) / '
      echo columns_tablet
      echo '), calc((100vw - 40px) / '
      echo mobile_visible
      echo ')'
    endcapture

    assign tab_count = 0
    for block in section.blocks
      if block.settings.collection.products_count > 0
        assign tab_count = tab_count | plus: 1
      endif
    endfor
  -%}
  {%- if tab_count > 0 or request.design_mode -%}
    <div
      class="section collection-tabs color-{{ section.settings.color_scheme.id }}"
      style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
    >
      <sw-collection-tabs class="collection-tabs__root">
        <div class="page-width">
          <div class="section-header collection-tabs__header">
            <div class="collection-tabs__title">
              {%- if eyebrow != blank -%}
                <p class="eyebrow collection-tabs__eyebrow">{{ eyebrow }}</p>
              {%- endif -%}
              <h2 id="{{ heading_id }}" class="collection-tabs__heading display-m">{{ heading }}</h2>
              {%- if text != blank -%}
                <p class="collection-tabs__text">{{ text }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- comment -%} The chips scroll sideways on phones, edge to edge like the rows. {%- endcomment -%}
        <div class="collection-tabs__tabs js-only" role="tablist" aria-labelledby="{{ heading_id }}">
          {%- assign index = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign tab_collection = block.settings.collection -%}
            {%- if tab_collection == blank or tab_collection.products_count == 0 -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign index = index | plus: 1 -%}
            <button
              type="button"
              role="tab"
              id="CollectionTab-{{ section.id }}-{{ index }}"
              class="chip collection-tabs__tab"
              aria-selected="{% if index == 1 %}true{% else %}false{% endif %}"
              aria-controls="CollectionTabPanel-{{ section.id }}-{{ index }}"
              tabindex="{% if index == 1 %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{- tab_collection.title | escape -}}
            </button>
          {%- endfor -%}
        </div>
        <ul class="collection-tabs__links no-js-only" role="list">
          {%- for block in section.blocks -%}
            {%- assign tab_collection = block.settings.collection -%}
            {%- if tab_collection == blank or tab_collection.products_count == 0 -%}
              {%- continue -%}
            {%- endif -%}
            <li>
              <a class="chip" href="{{ tab_collection.url }}">{{ tab_collection.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>

        {%- assign index = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign tab_collection = block.settings.collection -%}
          {%- if tab_collection == blank or tab_collection.products_count == 0 -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign index = index | plus: 1
            assign list_id = 'CollectionTabList-' | append: section.id | append: '-' | append: index
            assign eager = 0
            if index == 1 and section.index <= 2
              assign eager = columns_desktop
            endif
          -%}
          <div
            id="CollectionTabPanel-{{ section.id }}-{{ index }}"
            class="collection-tabs__panel"
            role="tabpanel"
            aria-labelledby="CollectionTab-{{ section.id }}-{{ index }}"
            tabindex="0"
            {% if index > 1 %}
              hidden
            {% endif %}
          >
            <sw-carousel class="collection-tabs__carousel">
              <div class="page-width collection-tabs__bar">
                <a class="link-arrow collection-tabs__view-all" href="{{ tab_collection.url }}">
                  {{- 'home.featured_collection.view_all' | t -}}
                  <span class="visually-hidden"> ({{ tab_collection.title | escape }})</span>
                  {%- render 'icon', name: 'chevron-forward', size: 16 -%}
                </a>
                <span class="collection-tabs__count">
                  {{- 'home.featured_collection.count' | t: count: tab_collection.products_count -}}
                </span>
                <div class="collection-tabs__arrows js-only">
                  <button
                    type="button"
                    class="featured-collection__arrow"
                    aria-controls="{{ list_id }}"
                    aria-disabled="true"
                    data-carousel-prev
                  >
                    {%- render 'icon', name: 'chevron-back', size: 20 -%}
                    <span class="visually-hidden">{{ 'accessibility.previous' | t }}</span>
                  </button>
                  <button
                    type="button"
                    class="featured-collection__arrow"
                    aria-controls="{{ list_id }}"
                    aria-disabled="false"
                    data-carousel-next
                  >
                    {%- render 'icon', name: 'chevron-forward', size: 20 -%}
                    <span class="visually-hidden">{{ 'accessibility.next' | t }}</span>
                  </button>
                </div>
              </div>
              <ul
                id="{{ list_id }}"
                class="featured-collection__track collection-tabs__track"
                role="list"
                data-carousel-track
                style="--grid-cols: 1; --grid-cols-tablet: {{ columns_tablet }}; --grid-cols-desktop: {{ columns_desktop }}; --carousel-peek: 0.5;"
              >
                {%- render 'home-row-cards',
                  row_collection: tab_collection,
                  limit: limit,
                  sizes: card_sizes,
                  item_class: 'featured-collection__item',
                  audience: section.settings.audience,
                  one_per_team: section.settings.one_per_team,
                  eager: eager,
                  scan: 40
                -%}
                {%- if tab_collection.products_count > limit -%}
                  <li class="featured-collection__item featured-collection__more">
                    <a class="featured-collection__more-link" href="{{ tab_collection.url }}">
                      <span class="featured-collection__more-icon">
                        {%- render 'icon', name: 'arrow-forward', size: 24 -%}
                      </span>
                      <span class="featured-collection__more-label">{{ 'home.featured_collection.view_all' | t }}</span>
                      <span class="featured-collection__more-count">
                        {{- 'home.featured_collection.count' | t: count: tab_collection.products_count -}}
                      </span>
                      <span class="visually-hidden">({{ tab_collection.title | escape }})</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
              <div class="page-width featured-collection__progress-wrap js-only" aria-hidden="true">
                <div class="featured-collection__progress">
                  <span class="featured-collection__progress-thumb"></span>
                </div>
              </div>
            </sw-carousel>
          </div>
        {%- endfor -%}
      </sw-collection-tabs>
    </div>
    <script type="module" src="{{ 'product-carousel.js' | asset_url }}"></script>
    <script type="module" src="{{ 'collection-tabs.js' | asset_url }}"></script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .collection-tabs__root,
  .collection-tabs__carousel {
    display: block;
  }

  .collection-tabs__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .collection-tabs__eyebrow {
    margin: 0;
    color: var(--color-accent-text);
  }

  .collection-tabs__heading {
    margin: 0;
  }

  .collection-tabs__text {
    max-inline-size: 60ch;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }

  /* The chips: one row that scrolls sideways, starting where the page content starts. */
  .collection-tabs__tabs,
  .collection-tabs__links {
    --tabs-start: max(var(--gutter), calc((100% - var(--page-width, 1440px)) / 2));
    display: flex;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding-block: var(--space-1);
    padding-inline: var(--tabs-start) var(--gutter);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    list-style: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .collection-tabs__tab {
    flex-shrink: 0;
    cursor: pointer;

    &[aria-selected='true'] {
      border-color: var(--color-text);
      background: var(--color-text);
      color: var(--color-background);
      font-weight: 700;
    }
  }

  .collection-tabs__panel:focus-visible {
    outline-offset: -2px;
  }

  .collection-tabs__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-block-end: var(--space-4);
  }

  .collection-tabs__count {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .collection-tabs__arrows {
    display: none;
    gap: var(--space-2);
    margin-inline-start: auto;

    @media screen and (min-width: 750px) {
      display: flex;
    }
  }

  sw-carousel:not([data-scrollable]) :is(.collection-tabs__arrows, .featured-collection__progress-wrap) {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_tabs.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "checkbox",
      "id": "lazy_render",
      "label": "t:sections.featured_collection.settings.lazy_render.label",
      "info": "t:sections.featured_collection.settings.lazy_render.info",
      "default": true
    },
    {
      "type": "select",
      "id": "copy",
      "label": "t:sections.collection_tabs.settings.copy.label",
      "info": "t:sections.collection_tabs.settings.copy.info",
      "options": [
        { "value": "none", "label": "t:sections.collection_tabs.settings.copy.options.none" },
        { "value": "leagues", "label": "t:sections.collection_tabs.settings.copy.options.leagues" },
        { "value": "nba_teams", "label": "t:sections.collection_tabs.settings.copy.options.nba_teams" }
      ],
      "default": "leagues"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "select",
      "id": "audience",
      "label": "t:sections.featured_collection.settings.audience.label",
      "info": "t:sections.featured_collection.settings.audience.info",
      "options": [
        { "value": "all", "label": "t:sections.featured_collection.settings.audience.options.all" },
        { "value": "adult", "label": "t:sections.featured_collection.settings.audience.options.adult" },
        { "value": "kids", "label": "t:sections.featured_collection.settings.audience.options.kids" }
      ],
      "default": "adult"
    },
    {
      "type": "checkbox",
      "id": "one_per_team",
      "label": "t:sections.featured_collection.settings.one_per_team.label",
      "info": "t:sections.featured_collection.settings.one_per_team.info",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_tab",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "t:sections.collection_tabs.settings.products_per_tab.label",
      "default": 10
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "t:settings.columns_desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.collection_tabs.blocks.tab.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "t:sections.collection_tabs.presets.name",
      "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }]
    }
  ]
}
{% endschema %}
