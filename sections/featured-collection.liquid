{%- liquid
  # On a product page a row can show only for the products of one sport or audience, and only on one product
  # page in two or three (by the product's id), so that product pages end with different rows. Elsewhere the
  # row always shows.
  assign row_visible = true
  if product != blank
    case section.settings.show_for
      when 'football'
        unless product.tags contains 'sport:football'
          assign row_visible = false
        endunless
      when 'basketball'
        unless product.tags contains 'sport:basketball'
          assign row_visible = false
        endunless
      when 'american_football'
        unless product.tags contains 'sport:american-football' or product.type == 'Hoodie'
          assign row_visible = false
        endunless
      when 'kids'
        unless product.tags contains 'audience:kids'
          assign row_visible = false
        endunless
      when 'adults'
        if product.tags contains 'audience:kids'
          assign row_visible = false
        endif
    endcase
    assign rotation = section.settings.rotation | default: 'every'
    if rotation != 'every'
      assign rotation_parts = rotation | split: '_'
      assign rotation_slot = rotation_parts.first | plus: 0
      assign rotation_of = rotation_parts.last | plus: 0
      # Shopify's ids step by 32768, so the turn comes from the id divided by it (the id itself is always even).
      assign product_slot = product.id | divided_by: 32768 | modulo: rotation_of | plus: 1
      if product_slot != rotation_slot
        assign row_visible = false
      endif
    endif
  endif

  # Further down a page (after its third section) this section can wait until the visitor scrolls near
  # it: it renders as an outline (snippets/deferred-section.liquid) and assets/deferred-section.js loads
  # it through the Section Rendering API, where section.index is nil, as in the theme editor, so both
  # render it in full. A long page stays within Shopify's render time this way.
  assign defer_render = false
  if section.settings.lazy_render and section.index > 3
    assign defer_render = true
  endif
-%}
{%- if row_visible == false -%}
  {%- comment -%} Not for this product: nothing at all, not even the deferred outline. {%- endcomment -%}
{%- elsif defer_render -%}
  {%- render 'deferred-section',
    section_id: section.id,
    color_scheme: section.settings.color_scheme.id,
    min_height: 600,
    min_height_desktop: 660,
    shape: 'row'
  -%}
{%- else -%}
  {%- liquid
    assign featured = section.settings.collection
    assign product_limit = section.settings.products_to_show
    assign columns_desktop = section.settings.columns_desktop
    assign columns_tablet = columns_desktop | at_most: 3
    assign columns_mobile = section.settings.columns_mobile | plus: 0
    assign use_scroller = section.settings.mobile_scroller
    # Carousel: one row that runs across the whole screen at every width, with previous/next buttons, a
    # progress bar and a "view all" tile at its end. The next card peeks in: 0.3 of a card, or half a
    # card on a phone showing one column, so a large card still reads as a row to swipe.
    assign is_carousel = false
    if section.settings.layout == 'carousel'
      assign is_carousel = true
    endif
    assign mobile_peek = 0.3
    if columns_mobile == 1
      assign mobile_peek = 0.5
    endif
    assign mobile_visible = columns_mobile | plus: mobile_peek
    assign list_id = 'FeaturedCollection-' | append: section.id
    # Which of the collection's products the row shows: all, adults only or kids only (kids carry the
    # tag audience:kids), and optionally only the first product of each team (its team:<slug> tag), so
    # a row sorted by date doesn't fill up with the team imported last.
    assign audience_filter = section.settings.audience | default: 'all'
    if audience_filter == 'product'
      assign audience_filter = 'all'
      if product != blank
        assign audience_filter = 'adult'
        if product.tags contains 'audience:kids'
          assign audience_filter = 'kids'
        endif
      endif
    endif
    assign one_per_team = section.settings.one_per_team
    # Optionally only one product type, e.g. only the jerseys of a collection that also holds shorts;
    # such a row looks through more of the collection (its first 80 products instead of 40).
    assign row_type = section.settings.product_type
    assign row_scan = 40
    if row_type == 'all'
      assign row_type = blank
    else
      assign row_scan = 80
    endif

    # Where the products come from: the chosen collection, or "more from the same league" on a product
    # page (the league of the product's sportwear.league_handle, in the product's audience, without its
    # own team, which the recommendations above already show) or on a team's collection page (the
    # league of the team's products, without the team). Football leagues without a collection of their
    # own are in "other-leagues". A row never repeats the collection of the page it sits on.
    assign source = section.settings.source | default: 'collection'
    assign exclude_tag = ''
    assign exclude_id = blank
    assign league_handle = ''
    if source == 'product_league'
      assign featured = blank
      if product != blank
        assign league_handle = product.metafields.sportwear.league_handle.value
        assign team_handle = product.metafields.sportwear.team_handle.value
        if team_handle != blank
          assign exclude_tag = 'team:' | append: team_handle
        endif
        assign exclude_id = product.id
        assign audience_filter = 'adult'
        if product.tags contains 'audience:kids'
          assign audience_filter = 'kids'
        endif
        # Of the same kind: a jersey's page shows jerseys, a pair of shorts' page shows shorts. The NBA's
        # newest products are its shorts, so the row looks further into the league's collection.
        if row_type == blank
          assign row_type = product.type
        endif
        assign row_scan = 250
        assign row_sport_football = false
        if product.tags contains 'sport:football'
          assign row_sport_football = true
        endif
      endif
    elsif source == 'collection_league'
      assign featured = blank
      if collection != blank and collection.products_count > 0
        assign first_product = collection.products.first
        assign own_team_tag = 'team:' | append: collection.handle
        if first_product.tags contains own_team_tag
          assign league_handle = first_product.metafields.sportwear.league_handle.value
          assign exclude_tag = own_team_tag
          # A basketball team's league row shows jerseys (the NBA's newest products are its shorts).
          if row_type == blank and first_product.tags contains 'sport:basketball'
            assign row_type = 'Basketball Jersey'
            assign row_scan = 250
          endif
          assign row_sport_football = false
          if first_product.tags contains 'sport:football'
            assign row_sport_football = true
          endif
        endif
      endif
    endif
    if league_handle != blank
      assign featured = collections[league_handle]
      if featured == blank and row_sport_football
        assign featured = collections['other-leagues']
        assign league_fallback = true
      endif
    endif
    if collection != blank and featured != blank and featured.handle == collection.handle
      assign featured = blank
    endif

    assign has_products = false
    if featured != blank and featured.products_count > 0
      assign has_products = true
    endif
    assign has_more = false
    if has_products and featured.products_count > product_limit
      assign has_more = true
    endif
    assign count_label = ''
    if has_products
      assign count_label = 'home.featured_collection.count' | t: count: featured.products_count
    endif
    assign show_count = false
    if section.settings.show_count and has_products
      assign show_count = true
    endif

    # Texts: the owner's own, else a translated copy set chosen in the editor (an eyebrow and a line of
    # text for rows such as new arrivals or retro jerseys). The heading is the owner's, else the
    # collection's (translated) name, else the translated default ("This season's jerseys"). "More from
    # the same league" rows say so in their eyebrow (not when their league has no collection of its own and
    # the row shows "other leagues" instead).
    assign copy = section.settings.copy | default: 'none'
    assign eyebrow = section.settings.eyebrow | escape
    assign heading = section.settings.heading | escape
    assign text = section.settings.text | escape
    if copy != 'none'
      assign copy_key = 'home.featured_collection.copy.' | append: copy
      if eyebrow == blank
        assign eyebrow = copy_key | append: '.eyebrow' | t
      endif
      if text == blank
        assign text = copy_key | append: '.text' | t
      endif
    endif
    if eyebrow == blank and source != 'collection' and league_fallback != true
      assign eyebrow = 'home.featured_collection.same_league' | t
    endif
    if heading == blank and featured != blank
      assign heading = featured.title | escape
    endif
    if heading == blank
      assign heading = 'home.featured_collection.heading' | t
    endif

    # An opening card, in the accent color, can lead a scrolling row: it carries the eyebrow, the
    # heading, the text and the "view all" button, so the header above keeps only the arrows.
    assign intro_card = false
    if is_carousel and section.settings.intro_card
      assign intro_card = true
    endif

    assign view_all_url = routes.all_products_collection_url
    if featured != blank
      assign view_all_url = featured.url
    endif

    # Image sizes follow the layout: grid cells inside the page width, or carousel cards (the visible
    # columns plus a peek) across the screen.
    if is_carousel
      capture card_sizes
        echo '(min-width: 990px) min(calc((100vw - 64px) / '
        echo columns_desktop
        echo '), 420px), (min-width: 750px) calc((100vw - 64px) / '
        echo columns_tablet
        echo '), calc((100vw - 40px) / '
        echo mobile_visible
        echo ')'
      endcapture
    else
      # 64px of gutters and 20px gaps from 750px, 40px and 12px below it.
      assign gaps_desktop = columns_desktop | minus: 1 | times: 20
      assign gaps_tablet = columns_tablet | minus: 1 | times: 20
      if columns_mobile == 1
        assign mobile_size = 'calc(100vw - 40px)'
        if use_scroller
          assign mobile_size = 'calc((100vw - 40px) / 1.25)'
        endif
      else
        assign mobile_size = 'calc((100vw - 52px) / 2)'
        if use_scroller
          assign mobile_size = 'calc((100vw - 52px) / 2.25)'
        endif
      endif
      capture card_sizes
        echo '(min-width: 990px) calc((min(100vw - 64px, '
        echo settings.page_width
        echo 'px) - '
        echo gaps_desktop
        echo 'px) / '
        echo columns_desktop
        echo '), (min-width: 750px) calc((100vw - 64px - '
        echo gaps_tablet
        echo 'px) / '
        echo columns_tablet
        echo '), '
        echo mobile_size
      endcapture
    endif

    # Only the first two sections of a page (the hero is short) may load images eagerly: their first row of cards.
    assign eager_cards = 0
    unless section.index > 2
      assign eager_cards = columns_desktop
    endunless
  -%}

  {%- capture section_header -%}
  <div class="section-header featured-collection__header{% if intro_card %} featured-collection__header--intro{% endif %}">
    {%- unless intro_card -%}
      <div class="featured-collection__title">
        {%- if eyebrow != blank -%}
          <p class="eyebrow featured-collection__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        <div class="featured-collection__title-row">
          <h2 class="featured-collection__heading display-m">{{ heading }}</h2>
          {%- if show_count -%}
            <span class="featured-collection__count">{{ count_label }}</span>
          {%- endif -%}
        </div>
        {%- if text != blank -%}
          <p class="featured-collection__text">{{ text }}</p>
        {%- endif -%}
      </div>
    {%- endunless -%}
    {%- if section.settings.show_view_all or is_carousel -%}
      <div class="featured-collection__header-end">
        {%- if section.settings.show_view_all and intro_card == false -%}
          <a class="link-arrow featured-collection__view-all" href="{{ view_all_url }}">
            {{- 'home.featured_collection.view_all' | t -}}
            <span class="visually-hidden"> ({{ heading }})</span>
            {%- render 'icon', name: 'chevron-forward', size: 16 -%}
          </a>
        {%- endif -%}
        {%- if is_carousel -%}
          <div class="featured-collection__arrows js-only">
            <button
              type="button"
              class="featured-collection__arrow"
              aria-controls="{{ list_id }}"
              aria-disabled="true"
              data-carousel-prev
            >
              {%- render 'icon', name: 'chevron-back', size: 20 -%}
              <span class="visually-hidden">{{ 'accessibility.previous' | t }}</span>
            </button>
            <button
              type="button"
              class="featured-collection__arrow"
              aria-controls="{{ list_id }}"
              aria-disabled="false"
              data-carousel-next
            >
              {%- render 'icon', name: 'chevron-forward', size: 20 -%}
              <span class="visually-hidden">{{ 'accessibility.next' | t }}</span>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endcapture -%}

  {%- assign shown = 0 -%}
  {%- capture cards -%}
  {%- if has_products -%}
    {%- capture product_cards -%}
      {%- render 'home-row-cards',
        row_collection: featured,
        limit: product_limit,
        sizes: card_sizes,
        item_class: 'featured-collection__item',
        audience: audience_filter,
        product_type: row_type,
        scan: row_scan,
        one_per_team: one_per_team,
        exclude_tag: exclude_tag,
        exclude_id: exclude_id,
        eager: eager_cards
      -%}
    {%- endcapture -%}
    {%- assign shown = product_cards | split: 'data-row-card' | size | minus: 1 -%}
    {%- if intro_card -%}
      <li class="featured-collection__item featured-collection__intro">
        <div class="featured-collection__intro-card">
          <div class="featured-collection__intro-top">
            {%- if eyebrow != blank -%}
              <p class="eyebrow featured-collection__intro-eyebrow">{{ eyebrow }}</p>
            {%- endif -%}
            <h2 class="featured-collection__intro-heading display-l">{{ heading }}</h2>
            {%- if text != blank -%}
              <p class="featured-collection__intro-text">{{ text }}</p>
            {%- endif -%}
          </div>
          <div class="featured-collection__intro-bottom">
            {%- if show_count -%}
              <p class="featured-collection__intro-count">{{ count_label }}</p>
            {%- endif -%}
            <a class="button featured-collection__intro-button" href="{{ view_all_url }}">
              {{- 'home.featured_collection.view_all' | t -}}
              <span class="visually-hidden"> ({{ heading }})</span>
            </a>
          </div>
        </div>
      </li>
    {%- endif -%}
    {{- product_cards -}}
    {%- if is_carousel and has_more -%}
      <li class="featured-collection__item featured-collection__more">
        <a class="featured-collection__more-link" href="{{ view_all_url }}">
          <span class="featured-collection__more-icon">
            {%- render 'icon', name: 'arrow-forward', size: 24 -%}
          </span>
          <span class="featured-collection__more-label">{{ 'home.featured_collection.view_all' | t }}</span>
          <span class="featured-collection__more-count">
            {{- 'home.featured_collection.count' | t: count: featured.products_count -}}
          </span>
          <span class="visually-hidden">({{ heading }})</span>
        </a>
      </li>
    {%- endif -%}
  {%- else -%}
    {%- for index in (1..product_limit) -%}
      <li class="featured-collection__item">
        {%- render 'product-card', product: null -%}
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

  {%- liquid
    # A collection whose products the audience or team options filter out entirely shows nothing.
    assign show_section = false
    if has_products and shown > 0
      assign show_section = true
    endif
    if request.design_mode
      assign show_section = true
    endif
  -%}
  {%- if show_section -%}
    <div
      class="section featured-collection color-{{ section.settings.color_scheme.id }}{% if is_carousel %} featured-collection--carousel{% endif %}"
      style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
    >
      {%- if is_carousel -%}
        <sw-carousel class="featured-collection__carousel">
          <div class="page-width">{{ section_header }}</div>
          <ul
            id="{{ list_id }}"
            class="featured-collection__track"
            role="list"
            data-carousel-track
            style="--grid-cols: {{ columns_mobile }}; --grid-cols-tablet: {{ columns_tablet }}; --grid-cols-desktop: {{ columns_desktop }}; --carousel-peek: {{ mobile_peek }};"
          >
            {{- cards -}}
          </ul>
          <div class="page-width featured-collection__progress-wrap js-only" aria-hidden="true">
            <div class="featured-collection__progress">
              <span class="featured-collection__progress-thumb"></span>
            </div>
          </div>
        </sw-carousel>
      {%- else -%}
        <div class="page-width">
          {{ section_header }}
          <ul
            id="{{ list_id }}"
            class="grid featured-collection__grid{% if use_scroller %} featured-collection__grid--scroll{% endif %}"
            role="list"
            style="--grid-cols: {{ columns_mobile }}; --grid-cols-tablet: {{ columns_tablet }}; --grid-cols-desktop: {{ columns_desktop }};"
          >
            {{- cards -}}
          </ul>
        </div>
      {%- endif -%}
    </div>
    {%- if is_carousel -%}
      <script type="module" src="{{ 'product-carousel.js' | asset_url }}"></script>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .featured-collection__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .featured-collection__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    min-inline-size: 0;
  }

  .featured-collection__eyebrow {
    margin: 0;
    color: var(--color-accent-text);
  }

  .featured-collection__text {
    max-inline-size: 60ch;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: var(--leading-body, 1.5);
  }

  /* With an opening card the header only holds the arrows (tablets and up); phones swipe. */
  .featured-collection__header--intro {
    display: none;
    justify-content: flex-end;

    @media screen and (min-width: 750px) {
      display: flex;
    }
  }

  /* The opening card: an accent-colored tile as tall as the product cards, with the row's eyebrow,
     heading and text at its top and the count and the "view all" button at its bottom. */
  .featured-collection__intro {
    display: flex;
  }

  .featured-collection__intro-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    inline-size: 100%;
    min-block-size: 280px;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-accent);
    color: var(--color-on-accent);

    @media screen and (min-width: 990px) {
      padding: var(--space-8) var(--space-6);
    }
  }

  .featured-collection__intro-top,
  .featured-collection__intro-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .featured-collection__intro-eyebrow,
  .featured-collection__intro-text,
  .featured-collection__intro-count {
    margin: 0;
  }

  .featured-collection__intro-heading {
    margin: 0;
    overflow-wrap: break-word;
  }

  .featured-collection__intro-text {
    font-size: var(--text-md);
    font-weight: 600;
    line-height: var(--leading-body, 1.5);
  }

  .featured-collection__intro-count {
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .featured-collection__intro-button {
    border-color: var(--color-on-accent);
    background: var(--color-on-accent);
    color: var(--color-accent);

    &:hover {
      background: var(--color-on-accent);
      color: var(--color-accent);
      opacity: 0.9;
    }
  }

  .featured-collection__heading {
    min-inline-size: 0;
    overflow-wrap: break-word;
  }

  .featured-collection__count {
    display: inline-flex;
    align-items: center;
    min-block-size: 28px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-chip);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .featured-collection__header-end {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-4);
  }

  .featured-collection__view-all {
    flex-shrink: 0;
  }

  /* Optional mobile layout for the grid: one swipeable row that runs to the screen edges, with a peek
     of the next card. Two classes to win over the list reset (ul[role='list'] { padding: 0 }). */
  .featured-collection__grid.featured-collection__grid--scroll {
    display: flex;
    gap: var(--grid-gap);
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--space-1) var(--gutter);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      display: grid;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }

  .featured-collection__grid--scroll .featured-collection__item {
    flex: 0 0 calc((100vw - 2 * var(--gutter) - (var(--grid-cols) - 1) * var(--grid-gap)) / (var(--grid-cols) + 0.25));
    scroll-snap-align: start;
  }

  .featured-collection__arrows {
    display: none;
    gap: var(--space-2);

    @media screen and (min-width: 750px) {
      display: flex;
    }
  }

  /* Nothing to scroll (fewer products than columns): no buttons, no progress bar. */
  sw-carousel:not([data-scrollable]) :is(.featured-collection__arrows, .featured-collection__progress-wrap) {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "checkbox",
      "id": "lazy_render",
      "label": "t:sections.featured_collection.settings.lazy_render.label",
      "info": "t:sections.featured_collection.settings.lazy_render.info",
      "default": true
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:sections.featured_collection.settings.source.label",
      "info": "t:sections.featured_collection.settings.source.info",
      "options": [
        { "value": "collection", "label": "t:sections.featured_collection.settings.source.options.collection" },
        { "value": "product_league", "label": "t:sections.featured_collection.settings.source.options.product_league" },
        {
          "value": "collection_league",
          "label": "t:sections.featured_collection.settings.source.options.collection_league"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "copy",
      "label": "t:sections.featured_collection.settings.copy.label",
      "info": "t:sections.featured_collection.settings.copy.info",
      "options": [
        { "value": "none", "label": "t:sections.featured_collection.settings.copy.options.none" },
        { "value": "new", "label": "t:sections.featured_collection.settings.copy.options.new" },
        { "value": "retro", "label": "t:sections.featured_collection.settings.copy.options.retro" },
        { "value": "city_edition", "label": "t:sections.featured_collection.settings.copy.options.city_edition" },
        {
          "value": "special_editions",
          "label": "t:sections.featured_collection.settings.copy.options.special_editions"
        },
