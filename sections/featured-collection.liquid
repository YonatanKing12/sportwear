{%- liquid
  assign featured = section.settings.collection
  assign product_limit = section.settings.products_to_show
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = columns_desktop | at_most: 4
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign use_scroller = section.settings.mobile_scroller

  assign has_products = false
  if featured != blank and featured.products_count > 0
    assign has_products = true
  endif

  # Heading: the owner's text, else the collection's (translated) name, else "Best sellers".
  assign heading = section.settings.heading | escape
  if heading == blank and featured != blank
    assign heading = featured.title | escape
  endif
  if heading == blank
    assign heading = 'home.featured_collection.heading' | t
  endif

  assign view_all_url = routes.all_products_collection_url
  if featured != blank
    assign view_all_url = featured.url
  endif

  # Image sizes follow the grid: 64px of gutters and 20px gaps from 750px, 40px and 12px below it.
  assign gaps_desktop = columns_desktop | minus: 1 | times: 20
  assign gaps_tablet = columns_tablet | minus: 1 | times: 20
  if columns_mobile == 1
    assign mobile_size = 'calc(100vw - 40px)'
    if use_scroller
      assign mobile_size = 'calc((100vw - 40px) / 1.25)'
    endif
  else
    assign mobile_size = 'calc((100vw - 52px) / 2)'
    if use_scroller
      assign mobile_size = 'calc((100vw - 52px) / 2.25)'
    endif
  endif
  capture card_sizes
    echo '(min-width: 990px) calc((min(100vw - 64px, '
    echo settings.page_width
    echo 'px) - '
    echo gaps_desktop
    echo 'px) / '
    echo columns_desktop
    echo '), (min-width: 750px) calc((100vw - 64px - '
    echo gaps_tablet
    echo 'px) / '
    echo columns_tablet
    echo '), '
    echo mobile_size
  endcapture

  # Only the first section of a page may load images eagerly: its first row of cards.
  assign eager_cards = 0
  if section.index == 1
    assign eager_cards = columns_desktop
  endif
-%}

{%- if has_products or request.design_mode -%}
  <div
    class="section featured-collection color-{{ section.settings.color_scheme.id }}"
    style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      <div class="section-header">
        <h2 class="featured-collection__heading display-m">{{ heading }}</h2>
        {%- if section.settings.show_view_all -%}
          <a class="link-arrow featured-collection__view-all" href="{{ view_all_url }}">
            {{- 'home.featured_collection.view_all' | t -}}
            <span class="visually-hidden"> ({{ heading }})</span>
            {%- render 'icon', name: 'chevron-forward', size: 16 -%}
          </a>
        {%- endif -%}
      </div>

      <ul
        class="grid featured-collection__grid{% if use_scroller %} featured-collection__grid--scroll{% endif %}"
        role="list"
        style="--grid-cols: {{ columns_mobile }}; --grid-cols-tablet: {{ columns_tablet }}; --grid-cols-desktop: {{ columns_desktop }};"
      >
        {%- if has_products -%}
          {%- for product in featured.products limit: product_limit -%}
            {%- liquid
              assign card_loading = 'lazy'
              if forloop.index <= eager_cards
                assign card_loading = 'eager'
              endif
            -%}
            <li class="featured-collection__item">
              {%- render 'product-card', product: product, sizes: card_sizes, loading: card_loading -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for index in (1..product_limit) -%}
            <li class="featured-collection__item">
              {%- render 'product-card', product: null -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .featured-collection__heading {
    min-inline-size: 0;
    overflow-wrap: break-word;
  }

  .featured-collection__view-all {
    flex-shrink: 0;
  }

  /* Optional mobile layout: one swipeable row that runs to the screen edges, with a peek of the next card.
     Two classes to win over the list reset (ul[role='list'] { padding: 0 }). */
  .featured-collection__grid.featured-collection__grid--scroll {
    display: flex;
    gap: var(--grid-gap);
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--space-1) var(--gutter);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      display: grid;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }

  .featured-collection__grid--scroll .featured-collection__item {
    flex: 0 0 calc((100vw - 2 * var(--gutter) - (var(--grid-cols) - 1) * var(--grid-gap)) / (var(--grid-cols) + 0.25));
    scroll-snap-align: start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:sections.featured_collection.settings.heading.info"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:settings.products_to_show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:settings.columns_desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        { "value": "1", "label": "t:options.columns.one" },
        { "value": "2", "label": "t:options.columns.two" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "mobile_scroller",
      "label": "t:sections.featured_collection.settings.mobile_scroller.label",
      "info": "t:sections.featured_collection.settings.mobile_scroller.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:settings.show_view_all",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.name"
    }
  ]
}
{% endschema %}
