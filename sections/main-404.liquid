{%- comment -%}
  404 page. The page must say at once that the address leads nowhere, so it opens with a giant "404"
  printed on the back of a shirt that hangs on a hanger, with "Offside" as the name above the number
  (decorative, and it sways gently unless the visitor prefers reduced motion). Next to it, in reading
  order: "Error 404", the template's <h1> ("Page not found"), a short explanation, a store search form,
  links to all products and the home page, and the top links of a menu as chips. The background is the
  dark night scheme with faint pitch markings.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = 'not_found.heading' | t
  endif
  assign intro = section.settings.text | escape
  if intro == blank
    assign intro = 'not_found.text' | t
  endif
  assign jersey_name = section.settings.jersey_name
  if jersey_name == blank
    assign jersey_name = 'not_found.jersey_name' | t
  endif
  assign search_id = 'NotFoundSearch-' | append: section.id
  assign chips_id = 'NotFoundLinks-' | append: section.id
  assign chip_menu = linklists[section.settings.menu]
-%}
<div
  class="section not-found color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="not-found__pitch" aria-hidden="true"></div>
  <div class="page-width not-found__grid">
    <div class="not-found__visual" aria-hidden="true">
      <div class="not-found__jersey">
        <svg class="not-found__shirt" viewBox="0 -72 420 532" focusable="false" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="NotFoundFabric-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
              <stop class="not-found__fabric-top" offset="0"/>
              <stop class="not-found__fabric-bottom" offset="1"/>
            </linearGradient>
          </defs>
          <path class="not-found__hanger" d="M210 -2V-22c0-8 20-14 20-30 0-11-9-18-20-18s-20 7-20 18" />
          <path class="not-found__hanger" d="M66 44L210 -4L354 44" />
          <path
            class="not-found__body"
            fill="url(#NotFoundFabric-{{ section.id }})"
            d="M146 14C166 36 254 36 274 14L352 40L414 120L362 172L342 152V446C342 452 338 456 332 456H88C82 456 78 452 78 446V152L58 172L6 120L68 40Z"
          />
          <path class="not-found__trim" d="M146 14C166 36 254 36 274 14" />
          <path class="not-found__trim" d="M22 104L50 132M398 104L370 132" />
          <path class="not-found__seam" d="M78 158V446M342 158V446" />
        </svg>
        <span class="not-found__name">{{ jersey_name | escape }}</span>
        <span class="not-found__number">{{ 'not_found.code' | t }}</span>
      </div>
    </div>

    <div class="not-found__content">
      <p class="eyebrow not-found__eyebrow">{{ 'not_found.eyebrow' | t }}</p>
      <h1 class="display-l not-found__heading">{{ heading }}</h1>
      <p class="not-found__text">{{ intro }}</p>

      {%- if section.settings.show_search -%}
        {%- comment -%} <sw-search-form> (assets/predictive-search.js) sends the query normalized like the header's. {%- endcomment -%}
        <sw-search-form class="not-found__search-wrapper">
          <form
            class="not-found__search"
            action="{{ routes.search_url }}"
            method="get"
            role="search"
            aria-label="{{ 'not_found.search_label' | t }}"
          >
            <label class="visually-hidden" for="{{ search_id }}">{{ 'not_found.search_label' | t }}</label>
            <input
              class="field__input not-found__search-input"
              type="search"
              id="{{ search_id }}"
              name="q"
              placeholder="{{ 'not_found.search_placeholder' | t }}"
              autocomplete="off"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button class="button button--primary not-found__search-button" type="submit">
              {%- render 'icon', name: 'search', size: 20 -%}
              <span>{{ 'not_found.search_submit' | t }}</span>
            </button>
          </form>
        </sw-search-form>
        <script type="module" src="{{ 'predictive-search.js' | asset_url }}"></script>
      {%- endif -%}

      <div class="not-found__actions">
        <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
          <span>{{ 'not_found.all_products' | t }}</span>
          {%- render 'icon', name: 'arrow-forward', size: 20 -%}
        </a>
        <a class="button button--secondary" href="{{ routes.root_url }}">
          {{- 'not_found.home' | t -}}
        </a>
      </div>

      {%- if chip_menu != blank and chip_menu.links.size > 0 -%}
        <nav class="not-found__links" aria-labelledby="{{ chips_id }}">
          <p class="not-found__links-label" id="{{ chips_id }}">{{ 'not_found.popular' | t }}</p>
          <ul class="not-found__chips" role="list">
            {%- for link in chip_menu.links limit: 6 -%}
              <li>
                <a class="chip" href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .not-found {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  /* Faint pitch markings: the halfway line and the centre circle, lit from above. */
  .not-found__pitch {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 55% at 50% 0%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 70%),
      radial-gradient(
        circle at 50% 58%,
        transparent 0 139px,
        color-mix(in srgb, var(--color-text) 9%, transparent) 140px 141.5px,
        transparent 142.5px
      ),
      linear-gradient(
        to right,
        transparent calc(50% - 0.75px),
        color-mix(in srgb, var(--color-text) 9%, transparent) calc(50% - 0.75px) calc(50% + 0.75px),
        transparent calc(50% + 0.75px)
      );
    pointer-events: none;

    @media screen and (min-width: 990px) {
      background:
        radial-gradient(60% 55% at 50% 0%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 70%),
        radial-gradient(
          circle at 50% 50%,
          transparent 0 219px,
          color-mix(in srgb, var(--color-text) 9%, transparent) 220px 221.5px,
          transparent 222.5px
        ),
        linear-gradient(
          to right,
          transparent calc(50% - 0.75px),
          color-mix(in srgb, var(--color-text) 9%, transparent) calc(50% - 0.75px) calc(50% + 0.75px),
          transparent calc(50% + 0.75px)
        );
    }
  }

  .not-found__grid {
    display: grid;
    align-items: center;
    gap: var(--space-8);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-12);
    }
  }

  .not-found__visual {
    display: grid;
    justify-items: center;

    @media screen and (min-width: 990px) {
      order: 2;
    }
  }

  /* The shirt on its hanger. The name and number sit on its back like printed lettering. */
  .not-found__jersey {
    position: relative;
    container-type: inline-size;
    inline-size: min(68vw, 280px);
    aspect-ratio: 420 / 532;
    transform-origin: 50% 2%;
    animation: not-found-sway 7s ease-in-out 3;

    @media screen and (min-width: 990px) {
      inline-size: min(100%, 400px);
    }
  }

  .not-found__shirt {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
    filter: drop-shadow(0 26px 30px rgb(0 0 0 / 0.5));
  }

  .not-found__fabric-top {
    stop-color: var(--color-accent);
  }

  .not-found__fabric-bottom {
    stop-color: color-mix(in oklab, var(--color-accent) 78%, #000);
  }

  .not-found__hanger {
    fill: none;
    stroke: color-mix(in srgb, var(--color-text) 60%, transparent);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .not-found__trim {
    fill: none;
    stroke: #0d0e11;
    stroke-width: 10;
    stroke-linecap: round;
  }

  .not-found__seam {
    fill: none;
    stroke: rgb(13 14 17 / 0.14);
    stroke-width: 3;
  }

  .not-found__name,
  .not-found__number {
    position: absolute;
    inset-inline: 22%;
    color: #0d0e11;
    font-family: var(--font-display);
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .not-found__name {
    inset-block-start: 27%;
    font-size: 11cqi;
    letter-spacing: 0.08em;
  }

  :lang(ar) .not-found__name {
    letter-spacing: 0;
    line-height: 1.3;
  }

  .not-found__number {
    inset-block-start: 41%;
    font-size: 40cqi;
    letter-spacing: -0.01em;
    direction: ltr;
  }

  .not-found__content {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-inline-size: 560px;
    text-align: start;

    @media screen and (max-width: 989px) {
      justify-self: center;
      justify-items: center;
      text-align: center;
    }
  }

  .not-found__eyebrow {
    margin: 0;
    color: var(--color-accent-text);
    font-variant-numeric: tabular-nums;
  }

  .not-found__heading {
    margin: 0;
    text-wrap: balance;
  }

  .not-found__text {
    max-inline-size: 46ch;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .not-found__search-wrapper {
    display: block;
    inline-size: 100%;
  }

  .not-found__search {
    display: flex;
    gap: var(--space-2);
    inline-size: 100%;
    margin-block-start: var(--space-2);
  }

  .not-found__search-input {
    flex: 1 1 auto;
    min-inline-size: 0;
    min-block-size: var(--control-height);
    background: var(--color-surface);
  }

  .not-found__search-button {
    flex-shrink: 0;
    padding-inline: var(--space-4);

    @media screen and (min-width: 750px) {
      padding-inline: var(--space-6);
    }
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    inline-size: 100%;

    & .button {
      flex: 1 1 200px;
    }
  }

  .not-found__links {
    display: grid;
    gap: var(--space-2);
    inline-size: 100%;
    margin-block-start: var(--space-2);
  }

  .not-found__links-label {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .not-found__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;

    @media screen and (max-width: 989px) {
      justify-content: center;
    }
  }

  @keyframes not-found-sway {
    0%,
    100% {
      rotate: -2.5deg;
    }

    50% {
      rotate: 2.5deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__jersey {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_404.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-night"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "jersey_name",
      "label": "t:sections.main_404.settings.jersey_name.label",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.main_404.settings.show_search.label",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.main_404.settings.menu.label",
      "info": "t:sections.main_404.settings.menu.info",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 72
    }
  ]
}
{% endschema %}
