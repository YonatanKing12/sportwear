{%- liquid
  assign scheme = section.settings.color_scheme
  assign on_dark = false
  if scheme.settings.background.lightness < 50
    assign on_dark = true
  endif

  assign item_count = section.blocks.size

  # When every order ships free (see free-shipping-cents), the default delivery text says so.
  capture threshold_cents
    render 'free-shipping-cents'
  endcapture
  assign threshold_cents = threshold_cents | plus: 0
-%}

{%- if item_count > 0 -%}
  <sw-trust-marquee
    data-label-pause="{{ 'home.hero_slideshow.pause' | t }}"
    data-label-play="{{ 'home.hero_slideshow.play' | t }}"
    class="trust-strip color-{{ scheme.id }}{% if on_dark %} trust-strip--on-dark{% endif %}"
  >
    <div
      class="section trust-strip__band"
      style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
    >
      <div class="trust-strip__viewport">
        <div class="trust-strip__track">
          <ul class="trust-strip__list" role="list" dir="{{ request.locale.direction }}">
            {%- for block in section.blocks -%}
              {%- liquid
                # "Automatic" icon and empty text follow the position: delivery, returns, stock in Israel, secure payment.
                assign icon_name = block.settings.icon
                if icon_name == 'auto'
                  case forloop.index
                    when 2
                      assign icon_name = 'return'
                    when 3
                      assign icon_name = 'map-pin'
                    when 4
                      assign icon_name = 'lock'
                    else
                      assign icon_name = 'truck'
                  endcase
                endif

                assign item_text = block.settings.text | escape
                if item_text == blank
                  case forloop.index
                    when 2
                      assign item_text = 'general.trust.returns' | t
                    when 3
                      assign item_text = 'general.trust.stock' | t
                    when 4
                      assign item_text = 'general.trust.secure_payment' | t
                    else
                      if threshold_cents < 0
                        assign item_text = 'general.trust.shipping_free' | t
                      else
                        assign item_text = 'general.trust.shipping' | t
                      endif
                  endcase
                endif
              -%}
              <li class="trust-strip__item" {{ block.shopify_attributes }}>
                {%- render 'icon', name: icon_name, size: 24, class: 'trust-strip__icon' -%}
                <span class="trust-strip__text">{{ item_text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </sw-trust-marquee>
  <script type="module" src="{{ 'trust-marquee.js' | asset_url }}"></script>
{%- endif -%}

{% stylesheet %}
  .trust-strip {
    display: block;
    --trust-accent: var(--color-text);
  }
  .trust-strip--on-dark {
    --trust-accent: var(--color-highlight);
  }
  .trust-strip__band {
    position: relative;
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .trust-strip--on-dark .trust-strip__band {
    background: var(--color-background);
  }
  .trust-strip__viewport {
    direction: ltr;
    overflow: hidden;
  }
  .trust-strip__track {
    inline-size: 100%;
  }
  .trust-strip__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
    gap: 16px 40px;
    margin: 0;
    padding-inline: 24px;
    list-style: none;
  }
  .trust-strip__item {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .trust-strip__icon {
    color: var(--trust-accent);
    inline-size: 20px;
    block-size: 20px;
  }
  .trust-strip__text {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
  }
  .trust-strip[data-animated] .trust-strip__track {
    display: flex;
    direction: ltr;
    inline-size: max-content;
    animation: trust-drift 36s linear infinite;
  }
  .trust-strip[data-animated] .trust-strip__list {
    flex-wrap: nowrap;
    flex: 0 0 auto;
    min-inline-size: 100vw;
    padding-inline: 24px;
    gap: 48px;
  }
  .trust-strip[data-animated] .trust-strip__item::after {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    margin-inline-start: 30px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-text);
  }
  .trust-strip[data-paused] .trust-strip__track,
  .trust-strip:focus-within .trust-strip__track {
    animation-play-state: paused;
  }
  @media (hover: hover) {
    .trust-strip:hover .trust-strip__track {
      animation-play-state: paused;
    }
  }
  @keyframes trust-drift {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trust-strip .trust-strip__track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.trust_strip.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-night"
    },
    {
      "type": "paragraph",
      "content": "t:sections.trust_strip.settings.info.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.trust_strip.blocks.item.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.trust_strip.blocks.item.settings.icon.label",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.auto"
            },
            {
              "value": "shield-check",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.shield_check"
            },
            {
              "value": "truck",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.truck"
            },
            {
              "value": "return",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.return"
            },
            {
              "value": "lock",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.lock"
            },
            {
              "value": "map-pin",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.map_pin"
            },
            {
              "value": "chat",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.chat"
            },
            {
              "value": "tag",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.tag"
            },
            {
              "value": "users",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.users"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text",
          "info": "t:sections.trust_strip.blocks.item.settings.text.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust_strip.name",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
