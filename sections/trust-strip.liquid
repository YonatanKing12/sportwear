{%- liquid
  assign scheme = section.settings.color_scheme
  assign on_dark = false
  if scheme.settings.background.lightness < 50
    assign on_dark = true
  endif

  comment
    Mobile shows compact columns: one per item, except four items, which sit in a 2 × 2 grid.
  endcomment
  assign item_count = section.blocks.size
  assign mobile_columns = item_count
  if item_count == 4
    assign mobile_columns = 2
  endif
-%}

{%- if item_count > 0 -%}
  <div class="trust-strip color-{{ scheme.id }}{% if on_dark %} trust-strip--on-dark{% endif %}">
    <div
      class="section trust-strip__band"
      style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
    >
      <div class="page-width">
        <ul
          class="trust-strip__list"
          role="list"
          style="--trust-columns: {{ mobile_columns }}; --trust-items: {{ item_count }};"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              comment
                "Automatic" icon and empty text follow the position: original, delivery, returns, secure payment.
              endcomment
              assign icon_name = block.settings.icon
              if icon_name == 'auto'
                case forloop.index
                  when 2
                    assign icon_name = 'truck'
                  when 3
                    assign icon_name = 'return'
                  when 4
                    assign icon_name = 'lock'
                  else
                    assign icon_name = 'shield-check'
                endcase
              endif

              assign item_text = block.settings.text | escape
              if item_text == blank
                case forloop.index
                  when 2
                    assign item_text = 'general.trust.shipping' | t
                  when 3
                    assign item_text = 'general.trust.returns' | t
                  when 4
                    assign item_text = 'general.trust.secure_payment' | t
                  else
                    assign item_text = 'general.trust.original' | t
                endcase
              endif
            -%}
            <li class="trust-strip__item" {{ block.shopify_attributes }}>
              {%- render 'icon', name: icon_name, size: 24, class: 'trust-strip__icon' -%}
              <span class="trust-strip__text">{{ item_text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .trust-strip {
    --trust-accent: currentColor;
  }

  .trust-strip--on-dark {
    --trust-accent: var(--color-highlight);
  }

  /* The band uses the scheme's surface tone, framed by hairlines (dark: #16181D on the #0D0E11 shell). */
  .trust-strip__band {
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .trust-strip__list {
    display: grid;
    grid-template-columns: repeat(var(--trust-columns, 3), minmax(0, 1fr));
    gap: var(--space-4) var(--space-2);
  }

  .trust-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-inline-size: 0;
    text-align: center;
  }

  .trust-strip__icon {
    color: var(--trust-accent);
  }

  .trust-strip__text {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  @media screen and (min-width: 750px) {
    .trust-strip__list {
      grid-template-columns: repeat(var(--trust-items, 3), auto);
      justify-content: space-evenly;
      column-gap: var(--space-8);
    }

    .trust-strip__item {
      flex-direction: row;
      gap: 10px;
      text-align: start;
    }

    .trust-strip__text {
      font-size: var(--text-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.trust_strip.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-night"
    },
    {
      "type": "paragraph",
      "content": "t:sections.trust_strip.settings.info.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.trust_strip.blocks.item.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.trust_strip.blocks.item.settings.icon.label",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.auto"
            },
            {
              "value": "shield-check",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.shield_check"
            },
            {
              "value": "truck",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.truck"
            },
            {
              "value": "return",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.return"
            },
            {
              "value": "lock",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.lock"
            },
            {
              "value": "chat",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.chat"
            },
            {
              "value": "tag",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.tag"
            },
            {
              "value": "users",
              "label": "t:sections.trust_strip.blocks.item.settings.icon.options.users"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text",
          "info": "t:sections.trust_strip.blocks.item.settings.text.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust_strip.name",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
