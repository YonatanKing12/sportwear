{%- liquid
  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = 'home.collection_links.heading' | t
  endif
  assign subheading = section.settings.subheading | escape

  # A chip needs a destination (its own link or a collection) and a label (its own or the collection's name).
  # Incomplete chips are skipped on the storefront and shown as placeholders in the theme editor.
  assign chip_count = 0
  for block in section.blocks
    assign chip_collection = block.settings.collection
    if block.settings.link != blank or chip_collection != blank
      if block.settings.label != blank or chip_collection != blank
        assign chip_count = chip_count | plus: 1
      endif
    endif
  endfor
-%}

{%- if chip_count > 0 or request.design_mode -%}
  <div
    class="section collection-links color-{{ section.settings.color_scheme.id }}"
    style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      <div class="collection-links__header">
        <h2 class="collection-links__heading display-m">{{ heading }}</h2>
        {%- if subheading != blank -%}
          <p class="collection-links__subheading">{{ subheading }}</p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="collection-links__list scroller" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign chip_collection = block.settings.collection
              assign chip_url = block.settings.link
              if chip_url == blank and chip_collection != blank
                assign chip_url = chip_collection.url
              endif
              assign chip_label = block.settings.label | escape
              if chip_label == blank and chip_collection != blank
                assign chip_label = chip_collection.title | escape
              endif
            -%}
            {%- if chip_url != blank and chip_label != blank -%}
              <li {{ block.shopify_attributes }}>
                <a class="chip{% if block.settings.featured %} chip--active{% endif %}" href="{{ chip_url }}">
                  {{- chip_label -}}
                </a>
              </li>
            {%- elsif request.design_mode -%}
              <li {{ block.shopify_attributes }}>
                <span class="chip{% if block.settings.featured %} chip--active{% endif %}">
                  {%- if chip_label != blank -%}
                    {{- chip_label -}}
                  {%- else -%}
                    {{- 'home.collection_links.placeholder_label' | t -}}
                  {%- endif -%}
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .collection-links__header {
    display: grid;
    gap: var(--space-2);
  }

  .collection-links__subheading {
    max-inline-size: 40em;
    color: var(--color-muted);
  }

  /* Mobile: one row of chips that scrolls to the screen edges. Wider screens: wrapping rows. */
  .collection-links__list {
    margin-block-start: var(--space-3);
    margin-inline: calc(var(--gutter) * -1);
  }

  /* Two classes to win over the list reset (ul[role='list'] { padding: 0 }). The block padding keeps
     focus rings from being clipped by the scroll container. */
  .collection-links .collection-links__list {
    padding: var(--space-1) var(--gutter);
    scroll-padding-inline: var(--gutter);
  }

  @media screen and (min-width: 750px) {
    .collection-links__list {
      flex-wrap: wrap;
      gap: var(--space-2) 10px;
      margin-block-start: var(--space-5);
      margin-inline: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .collection-links .collection-links__list {
      padding-inline: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_links.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 24,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading",
      "info": "t:sections.collection_links.settings.subheading.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "t:sections.collection_links.blocks.link.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection",
          "info": "t:sections.collection_links.blocks.link.settings.collection.info"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.collection_links.blocks.link.settings.label.label",
          "info": "t:sections.collection_links.blocks.link.settings.label.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link",
          "info": "t:sections.collection_links.blocks.link.settings.link.info"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "t:sections.collection_links.blocks.link.settings.featured.label",
          "info": "t:sections.collection_links.blocks.link.settings.featured.info",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_links.presets.name",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "featured": true
          }
        },
        {
          "type": "link"
        },
        {
          "type": "link"
        },
        {
          "type": "link"
        }
      ]
    }
  ]
}
{% endschema %}
