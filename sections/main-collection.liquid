{%- comment -%}
  Collection page: heading (the page's h1), optional image banner, description and chips menu, then
  storefront filtering (sidebar on desktop, drawer on small screens), sorting, the product grid and
  pagination. Works without JavaScript; assets/facets.js (<sw-facets>) updates results in place
  through the Section Rendering API.
  Chips: the "Related collections menu" setting, or, when it is blank, chips built from the
  main-menu around this collection ("All" first, then its sub-categories or its sister categories).
{%- endcomment -%}
{%- paginate collection.products by section.settings.products_per_page -%}
  {%- liquid
    assign layout = section.settings.filter_layout

    assign show_filters = false
    if section.settings.enable_filtering and collection.filters.size > 0
      assign show_filters = true
    endif

    assign show_sort = false
    if section.settings.enable_sorting and collection.sort_options.size > 0
      assign show_sort = true
    endif

    assign active_count = 0
    for filter in collection.filters
      if filter.type == 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign active_count = active_count | plus: 1
        endif
      else
        assign active_count = active_count | plus: filter.active_values.size
      endif
    endfor

    assign sort_by = collection.sort_by | default: collection.default_sort_by
    assign clear_url = collection.url
    if collection.sort_by != blank
      assign sort_param = collection.sort_by | url_encode
      assign clear_url = clear_url | append: '?sort_by=' | append: sort_param
    endif

    assign layout_class = 'facets-layout'
    assign sidebar_space = 0
    if show_filters
      assign layout_class = layout_class | append: ' facets-layout--filters'
      if layout == 'sidebar'
        assign layout_class = layout_class | append: ' facets-layout--sidebar'
        assign sidebar_space = 304
      endif
    endif

    assign cols_desktop = section.settings.columns_desktop
    assign cols_mobile = section.settings.columns_mobile | plus: 0
    assign desktop_space = cols_desktop | minus: 1 | times: 20 | plus: sidebar_space
    assign mobile_size = 'calc((100vw - 52px) / 2)'
    if cols_mobile == 1
      assign mobile_size = 'calc(100vw - 40px)'
    endif
    assign card_sizes = '(min-width: 990px) calc((min(100vw - 64px, ' | append: settings.page_width | append: 'px) - ' | append: desktop_space | append: 'px) / ' | append: cols_desktop | append: '), (min-width: 750px) calc((100vw - 104px) / 3), ' | append: mobile_size
    assign banner_sizes = '(min-width: 750px) min(100vw - 64px, ' | append: settings.page_width | append: 'px), calc(100vw - 40px)'

    # The banner: the collection's metafield sportwear.banner (a wide picture, kept apart from the
    # collection image, which the menus show as a product tile), else its own image; for a team's or a
    # player's page, the banner of their league (the league of the first product, as in
    # featured-collection's "collection_league"; football leagues without a collection of their own
    # are in other-leagues).
    assign banner = blank
    if section.settings.show_image
      assign banner = collection.metafields.sportwear.banner.value | default: collection.image
      if banner == blank and collection.products_count > 0
        assign first_product = collection.products.first
        assign own_team_tag = 'team:' | append: collection.handle
        assign own_player_tag = 'player:' | append: collection.handle
        if first_product.tags contains own_team_tag or first_product.tags contains own_player_tag
          assign banner_league = first_product.metafields.sportwear.league_handle.value
          if banner_league != blank
            assign banner = collections[banner_league].metafields.sportwear.banner.value
          endif
          if banner == blank and first_product.tags contains 'sport:football'
            assign banner = collections['other-leagues'].metafields.sportwear.banner.value
          endif
        endif
      endif
    endif

    assign banner_loading = 'lazy'
    assign banner_priority = 'auto'
    assign banner_preload = false
    unless section.index > 1
      assign banner_loading = 'eager'
      assign banner_priority = 'high'
      assign banner_preload = true
    endunless

    assign load_more = false
    if section.settings.pagination_style == 'load_more'
      assign load_more = true
    endif
    assign load_more_label = 'pagination.load_more' | t

    assign has_products = true
    if collection.all_products_count == 0
      assign has_products = false
    endif
    assign show_placeholders = false
    if has_products == false and request.design_mode
      assign show_placeholders = true
    endif

    assign results_label = 'collections.product_count' | t: count: collection.products_count
    assign subnav = section.settings.subnav_menu

    # Automatic chips when "Related collections menu" is blank: the main-menu link whose collection is
    # this one (any level; one with sub-links wins). Its sub-links follow an "All" chip for this page;
    # a link without sub-links shows its parent's "All" chip and its sister links instead. Links are
    # matched by their collection's handle, which is the same under every language prefix.
    assign chip_link = null
    assign chip_parent = null
    assign chip_links = null
    assign chip_all_current = false
    assign chip_count = 0
    if subnav == blank
      assign chip_found = false
      assign chip_found_with_children = false
      for level_one in linklists['main-menu'].links
        if level_one.type == 'collection_link' and level_one.object.handle == collection.handle
          if chip_found == false or level_one.links.size > 0 and chip_found_with_children == false
            assign chip_link = level_one
            assign chip_parent = null
            assign chip_found = true
            if level_one.links.size > 0
              assign chip_found_with_children = true
            endif
          endif
        endif
        for level_two in level_one.links
          if level_two.type == 'collection_link' and level_two.object.handle == collection.handle
            if chip_found == false or level_two.links.size > 0 and chip_found_with_children == false
              assign chip_link = level_two
              assign chip_parent = level_one
              assign chip_found = true
              if level_two.links.size > 0
                assign chip_found_with_children = true
              endif
            endif
          endif
          if chip_found == false
            for level_three in level_two.links
              if level_three.type == 'collection_link' and level_three.object.handle == collection.handle
                assign chip_link = level_three
                assign chip_parent = level_two
                assign chip_found = true
                break
              endif
            endfor
          endif
        endfor
      endfor

      if chip_link
        if chip_link.links.size > 0
          assign chip_links = chip_link.links
          assign chip_all_url = collection.url
          assign chip_all_title = collection.title
          assign chip_all_current = true
        elsif chip_parent
          assign chip_links = chip_parent.links
          assign chip_all_url = chip_parent.url
          assign chip_all_title = chip_parent.title
        endif
      endif

      # Chips to show: links to empty collections are left out (never this collection's own link).
      for chip in chip_links
        assign chip_empty = false
        if chip.type == 'collection_link'
          if chip.object.handle != collection.handle and chip.object.all_products_count == 0
            assign chip_empty = true
          endif
        endif
        unless chip_empty
          assign chip_count = chip_count | plus: 1
        endunless
      endfor
    endif
  -%}
  <div
    class="section main-collection color-{{ section.settings.color_scheme.id }}"
    style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      <sw-facets data-section-id="{{ section.id }}" data-layout="{{ layout }}">
        <header class="collection-header{% if banner != blank %} collection-header--banner{% endif %}">
          {%- if banner != blank -%}
            <div class="collection-banner color-scheme-night">
              <div class="collection-banner__media">
                {%- render 'image',
                  image: banner,
                  sizes: banner_sizes,
                  widths: '540, 720, 960, 1280, 1600, 1920, 2400',
                  loading: banner_loading,
                  fetchpriority: banner_priority,
                  preload: banner_preload,
                  alt: '',
                  class: 'collection-banner__image'
                -%}
              </div>
              <div class="collection-banner__content">
                <h1 class="collection-banner__title display-l">{{ collection.title | escape }}</h1>
                {%- if section.settings.show_count and has_products -%}
                  <p class="collection-banner__count">
                    {{- 'collections.product_count' | t: count: collection.all_products_count -}}
                  </p>
                {%- endif -%}
              </div>
            </div>
          {%- else -%}
            <h1 class="collection-header__title display-l">{{ collection.title | escape }}</h1>

            {%- if section.settings.show_count and has_products -%}
              <p class="collection-header__count">
                {{- 'collections.product_count' | t: count: collection.all_products_count -}}
              </p>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.show_description and collection.description != blank -%}
            {%- assign description_length = collection.description | strip_html | size -%}
            <sw-read-more class="read-more{% if description_length > 240 %} read-more--collapsed{% endif %}">
              <div
                id="CollectionDescription-{{ section.id }}"
                class="collection-header__description rte read-more__content"
              >
                {{ collection.description }}
              </div>
              {%- if description_length > 240 -%}
                <button
                  type="button"
                  class="read-more__toggle js-only"
                  aria-expanded="false"
                  aria-controls="CollectionDescription-{{ section.id }}"
                  data-label-more="{{ 'collections.read_more' | t }}"
                  data-label-less="{{ 'collections.read_less' | t }}"
                >
                  {{- 'collections.read_more' | t -}}
                </button>
              {%- endif -%}
            </sw-read-more>
          {%- endif -%}
        </header>

        {%- if subnav != blank and subnav.links.size > 0 -%}
          <nav class="collection-subnav" aria-label="{{ 'collections.subnav_label' | t }}">
            <sw-chip-scroller>
              <ul class="collection-subnav__list scroller" role="list">
                {%- for link in subnav.links -%}
                  <li>
                    <a
                      class="chip{% if link.current %} chip--active{% endif %}"
                      href="{{ link.url }}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </sw-chip-scroller>
          </nav>
        {%- elsif chip_count > 0 -%}
          <nav class="collection-subnav" aria-label="{{ 'collections.subnav_label' | t }}">
            <sw-chip-scroller>
              <ul class="collection-subnav__list scroller" role="list">
                <li>
                  <a
                    class="chip{% if chip_all_current %} chip--active{% endif %}"
                    href="{{ chip_all_url }}"
                    {% if chip_all_current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- 'collections.subnav_all' | t -}}
                    <span class="visually-hidden">: {{ chip_all_title | escape }}</span>
                  </a>
                </li>
                {%- for chip in chip_links -%}
                  {%- liquid
                    assign chip_current = false
                    assign chip_empty = false
                    if chip.type == 'collection_link'
                      if chip.object.handle == collection.handle
                        assign chip_current = true
                      elsif chip.object.all_products_count == 0
                        assign chip_empty = true
                      endif
                    endif
                  -%}
                  {%- unless chip_empty -%}
                    <li>
                      <a
                        class="chip{% if chip_current %} chip--active{% endif %}"
                        href="{{ chip.url }}"
                        {% if chip_current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- chip.title | escape -}}
                      </a>
                    </li>
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
            </sw-chip-scroller>
          </nav>
        {%- endif -%}

        {%- if has_products or show_placeholders -%}
          <div class="{{ layout_class }}">
            {%- render 'facets',
              section_id: section.id,
              filters: collection.filters,
              action: collection.url,
              show_filters: show_filters,
              show_sort: show_sort,
              sort_options: collection.sort_options,
              sort_by: sort_by,
              active_count: active_count,
              clear_url: clear_url,
              results_label: results_label,
              results_count: collection.products_count,
              option_style: section.settings.option_style
            -%}

            <div
              id="FacetsResults-{{ section.id }}"
              class="facets-results"
              data-facets-region="results"
              data-facets-results
            >
              <h2 class="visually-hidden" tabindex="-1" data-facets-focus>
                {{- 'collections.products_heading' | t -}}
              </h2>
              <span hidden data-facets-status>{{ results_label }}</span>

              {%- if collection.products.size > 0 -%}
                <ul
                  class="grid product-grid"
                  role="list"
                  style="--grid-cols: {{ cols_mobile }}; --grid-cols-tablet: 3; --grid-cols-desktop: {{ cols_desktop }};"
                  data-results-list="products"
                >
                  {%- for product in collection.products -%}
                    {%- liquid
                      assign card_loading = 'lazy'
                      if paginate.current_page == 1 and forloop.index <= 4
                        assign card_loading = 'eager'
                      endif
                    -%}
                    <li class="product-grid__item">
                      {%- render 'product-card', product: product, sizes: card_sizes, loading: card_loading -%}
                    </li>
                  {%- endfor -%}
                </ul>
                {%- render 'pagination', paginate: paginate, load_more: load_more, load_more_label: load_more_label -%}
              {%- elsif show_placeholders -%}
                <ul
                  class="grid product-grid"
                  role="list"
                  style="--grid-cols: {{ cols_mobile }}; --grid-cols-tablet: 3; --grid-cols-desktop: {{ cols_desktop }};"
                >
                  {%- for i in (1..8) -%}
                    <li class="product-grid__item">
                      {%- render 'product-card', product: blank, sizes: card_sizes -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- elsif active_count > 0 -%}
                {%- liquid
                  assign empty_title = 'facets.no_results_heading' | t
                  assign empty_text = 'facets.no_results_text' | t
                -%}
                {%- render 'facets-empty', title: empty_title, text: empty_text, clear_url: clear_url -%}
              {%- else -%}
                {%- liquid
                  assign empty_title = 'collections.empty_heading' | t
                  assign empty_text = 'collections.empty_text' | t
                -%}
                {%- render 'facets-empty', title: empty_title, text: empty_text -%}
                {%- render 'pagination', paginate: paginate -%}
              {%- endif -%}
            </div>
          </div>
          {%- if show_filters -%}
            {%- render 'facets-drawer',
              section_id: section.id,
              active_count: active_count,
              clear_url: clear_url,
              results_count: collection.products_count
            -%}
          {%- endif -%}
        {%- else -%}
          {%- liquid
            assign empty_title = 'collections.empty_heading' | t
            assign empty_text = 'collections.empty_text' | t
          -%}
          {%- render 'facets-empty', title: empty_title, text: empty_text, heading_tag: 'h2' -%}
        {%- endif -%}
      </sw-facets>
    </div>
  </div>
{%- endpaginate -%}

<script type="module" src="{{ 'facets.js' | asset_url }}"></script>

{%- if collection.handle != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'products.breadcrumbs.home' | t | json }},
          "item": {{ request.origin | append: routes.root_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ request.origin | append: collection.url | json }}
        }
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .collection-header {
    display: grid;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
  }

  /* Banner: the picture under a dark gradient, the title and count at its foot (scheme-night text). */
  .collection-banner {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-block-size: 150px;
    aspect-ratio: 12 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-background);
    color: var(--color-text);

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--color-background) 88%, transparent),
        color-mix(in srgb, var(--color-background) 30%, transparent) 55%,
        transparent 85%
      );
    }

    @media screen and (min-width: 750px) {
      min-block-size: 240px;
      aspect-ratio: 5 / 1;
    }
  }

  .collection-banner__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .collection-banner__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .collection-banner__content {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);

    @media screen and (min-width: 750px) {
      padding: var(--space-8) var(--space-10);
    }
  }

  .collection-banner__title {
    overflow-wrap: anywhere;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
  }

  .collection-banner__count {
    color: color-mix(in srgb, var(--color-text) 82%, transparent);
    font-size: var(--text-md);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .collection-header__title {
    overflow-wrap: anywhere;
  }

  .collection-header__count {
    color: var(--color-muted);
    font-size: var(--text-md);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .collection-header__description {
    max-inline-size: 72ch;
    color: var(--color-muted);
  }

  sw-read-more,
  sw-chip-scroller {
    display: block;
  }

  .read-more {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
  }

  .js .read-more--collapsed .read-more__content {
    max-block-size: 5.1em;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .read-more__toggle {
    min-block-size: var(--touch-target);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: var(--text-md);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .collection-subnav {
    margin-block-end: var(--space-6);
  }

  /* Edge-to-edge chip scroller aligned with the page gutter. Two classes, so the padding wins over
     the list reset in base.css whatever its specificity. */
  .collection-subnav .collection-subnav__list {
    margin-block: 0;
    margin-inline: calc(var(--gutter) * -1);
    padding-block: 0;
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    list-style: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main_collection.headers.header"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.main_collection.settings.show_image.label",
      "info": "t:sections.main_collection.settings.show_image.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.main_collection.settings.show_description.label",
      "info": "t:sections.main_collection.settings.show_description.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.main_collection.settings.show_count.label",
      "default": true
    },
    {
      "type": "link_list",
      "id": "subnav_menu",
      "label": "t:sections.main_collection.settings.subnav_menu.label",
      "info": "t:sections.main_collection.settings.subnav_menu.info"
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.headers.filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection.settings.enable_filtering.label",
      "info": "t:sections.main_collection.settings.enable_filtering.info",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "t:sections.main_collection.settings.filter_layout.label",
      "options": [
        {
          "value": "sidebar",
          "label": "t:sections.main_collection.settings.filter_layout.options.sidebar"
        },
        {
          "value": "drawer",
          "label": "t:sections.main_collection.settings.filter_layout.options.drawer"
        }
      ],
      "default": "sidebar",
      "visible_if": "{{ section.settings.enable_filtering }}"
    },
    {
      "type": "select",
      "id": "option_style",
      "label": "t:sections.main_collection.settings.option_style.label",
      "info": "t:sections.main_collection.settings.option_style.info",
      "options": [
        {
          "value": "buttons",
          "label": "t:sections.main_collection.settings.option_style.options.buttons"
        },
        {
          "value": "checkboxes",
          "label": "t:sections.main_collection.settings.option_style.options.checkboxes"
        }
      ],
      "default": "buttons",
      "visible_if": "{{ section.settings.enable_filtering }}"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_collection.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.headers.grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "t:sections.main_collection.settings.products_per_page.label",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "t:settings.columns_desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        { "value": "1", "label": "t:options.columns.one" },
        { "value": "2", "label": "t:options.columns.two" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:sections.main_collection.settings.pagination_style.label",
      "options": [
        {
          "value": "load_more",
          "label": "t:sections.main_collection.settings.pagination_style.options.load_more"
        },
        {
          "value": "pages",
          "label": "t:sections.main_collection.settings.pagination_style.options.pages"
        }
      ],
      "default": "load_more"
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.headers.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
