{%- comment -%}
  Password page (rendered inside layout/password.liquid): full-screen dark brand look with the logo,
  the "Opening soon" headline (the template's <h1>), the password message from Online Store >
  Preferences (or a translated default), an email sign-up (customer form, tagged
  "prospect, password page"), social links, and the store owner's password form inside a
  <details> that opens by itself when the password was wrong.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'password.heading' | t
  endif
  assign heading_highlight = section.settings.heading_highlight
  if heading_highlight == blank
    assign heading_highlight = 'password.heading_highlight' | t
  endif

  assign is_dark = false
  if section.settings.color_scheme.settings.background.lightness < 50
    assign is_dark = true
  endif

  assign signup_id = 'PasswordSignup-' | append: section.id
  assign login_id = 'PasswordLogin-' | append: section.id
  assign login_has_errors = false
-%}
{%- capture login_form -%}
  {%- form 'storefront_password', id: login_id, class: 'main-password__login-form' -%}
    {%- liquid
      assign password_error = ''
      if form.errors
        assign login_has_errors = true
        if form.errors contains 'password'
          assign password_error = 'password.login.error' | t
        else
          assign password_error = form.errors.messages['form']
          if password_error == blank
            assign password_error = 'password.login.error' | t
          endif
        endif
      endif
    -%}
    <label class="main-password__label" for="{{ login_id }}-password">{{ 'password.login.label' | t }}</label>
    <div class="main-password__row">
      <input
        class="field__input main-password__input"
        type="password"
        id="{{ login_id }}-password"
        name="password"
        autocomplete="current-password"
        dir="ltr"
        required
        {% if password_error != blank %}
          aria-invalid="true"
          aria-describedby="{{ login_id }}-password-error"
        {% endif %}
      >
      <button class="button button--secondary main-password__button" type="submit">
        {{- 'password.login.submit' | t -}}
      </button>
    </div>
    <p
      class="field__message main-password__error"
      id="{{ login_id }}-password-error"
      {% if password_error == blank %}
        hidden
      {% endif %}
      {% if password_error != blank %}
        role="alert"
        tabindex="-1"
        data-form-status
      {% endif %}
    >
      {%- render 'icon', name: 'alert', size: 16 -%}
      <span data-error-text>{{ password_error }}</span>
    </p>
  {%- endform -%}
{%- endcapture -%}
<div
  class="section main-password color-{{ section.settings.color_scheme.id }}{% if is_dark %} main-password--dark{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width main-password__inner">
    <div class="main-password__brand">
      {%- render 'logo', link: false, class: 'main-password__logo' -%}
    </div>

    <div class="main-password__content">
      <h1 class="display-xl main-password__heading">
        {{ heading }}
        <span class="main-password__highlight">{{ heading_highlight }}</span>
      </h1>
      <div class="main-password__message">
        {%- if shop.password_message != blank -%}
          <p>{{ shop.password_message }}</p>
        {%- elsif section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- else -%}
          <p>{{ 'password.text' | t }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_signup -%}
        <sw-validated-form
          class="main-password__signup"
          data-error-required="{{ 'pages.form.errors.required' | t }}"
          data-error-email="{{ 'pages.form.errors.email' | t }}"
          data-error-invalid="{{ 'pages.form.errors.invalid' | t }}"
        >
          {%- form 'customer', id: signup_id, class: 'main-password__signup-form' -%}
            <input type="hidden" name="contact[tags]" value="prospect,password page">
            {%- liquid
              assign email_error = ''
              if form.errors contains 'email'
                assign email_error = 'pages.form.errors.email' | t
              elsif form.errors
                assign email_error = form.errors.messages.form
                if email_error == blank
                  assign email_error = 'general.errors.generic' | t
                endif
              endif
            -%}
            {%- if form.posted_successfully? -%}
              <p class="main-password__status" role="status" tabindex="-1" data-form-status>
                {%- render 'icon', name: 'check', size: 20 -%}
                <span>{{ 'password.signup.success' | t }}</span>
              </p>
            {%- else -%}
              <label class="main-password__label" for="{{ signup_id }}-email">{{ 'password.signup.label' | t }}</label>
              <div class="main-password__row">
                <input
                  class="field__input main-password__input"
                  type="email"
                  id="{{ signup_id }}-email"
                  name="contact[email]"
                  value="{{ form.email | escape }}"
                  autocomplete="email"
                  dir="ltr"
                  placeholder="{{ 'pages.form.email_placeholder' | t }}"
                  required
                  aria-describedby="{% if email_error != blank %}{{ signup_id }}-email-error {% endif %}{{ signup_id }}-consent"
                  {% if email_error != blank %}
                    aria-invalid="true"
                  {% endif %}
                >
                <button class="button button--primary main-password__button" type="submit">
                  {{- 'password.signup.submit' | t -}}
                </button>
              </div>
              <p
                class="field__message main-password__error"
                id="{{ signup_id }}-email-error"
                {% if email_error == blank %}
                  hidden
                {% endif %}
                {% if email_error != blank %}
                  tabindex="-1"
                  data-form-status
                {% endif %}
              >
                {%- render 'icon', name: 'alert', size: 16 -%}
                <span data-error-text>{{ email_error }}</span>
              </p>
              <p class="main-password__consent" id="{{ signup_id }}-consent">{{ 'footer.newsletter.consent' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </sw-validated-form>
      {%- endif -%}
    </div>

    <div class="main-password__footer">
      {%- if section.settings.show_social -%}
        {%- render 'social-icons', class: 'main-password__social' -%}
      {%- endif -%}

      <details
        class="main-password__login"
        {% if login_has_errors %}
          open
        {% endif %}
      >
        <summary class="main-password__summary">
          {%- render 'icon', name: 'lock', size: 18 -%}
          <span>{{ 'password.login.summary' | t }}</span>
          {%- render 'icon', name: 'chevron-down', size: 18, class: 'main-password__chevron' -%}
        </summary>
        <sw-validated-form
          class="main-password__login-body"
          data-error-required="{{ 'pages.form.errors.required' | t }}"
          data-error-email="{{ 'pages.form.errors.email' | t }}"
          data-error-invalid="{{ 'pages.form.errors.invalid' | t }}"
        >
          {{- login_form -}}
        </sw-validated-form>
      </details>

      {%- render 'localization-switcher', id: 'PasswordLocalization' -%}
    </div>
  </div>
</div>
<script type="module" src="{{ 'content-form.js' | asset_url }}"></script>

{% stylesheet %}
  .main-password {
    --password-input-border: color-mix(in srgb, var(--color-text) 45%, var(--color-background));

    display: flex;
    min-block-size: 100vh;
    min-block-size: 100dvh;
  }

  .main-password__inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-10);
  }

  .main-password__brand {
    display: flex;
    justify-content: center;
  }

  .main-password__logo .wordmark {
    font-size: 34px;
  }

  .main-password__content {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-5);
    max-inline-size: 720px;
    margin-inline: auto;
    text-align: center;
  }

  .main-password__heading {
    overflow-wrap: break-word;
  }

  .main-password__highlight {
    display: inline-block;
    padding-inline: 0.12em;
    background: var(--color-highlight);
    color: var(--color-on-highlight);
  }

  .main-password--dark .main-password__highlight {
    padding-inline: 0;
    background: none;
    color: var(--color-highlight);
  }

  .main-password__message {
    max-inline-size: 52ch;
    color: var(--color-muted);
    font-size: var(--text-lg);

    & > * + * {
      margin-block-start: var(--space-2);
    }
  }

  .main-password__signup {
    inline-size: min(100%, 520px);
  }

  .main-password__signup-form,
  .main-password__login-form {
    display: grid;
    gap: var(--space-2);
    text-align: start;
  }

  .main-password__label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .main-password__row {
    display: flex;
    gap: var(--space-2);
  }

  .main-password__input {
    flex: 1 1 auto;
    min-inline-size: 0;
    min-block-size: var(--control-height);
    border-color: var(--password-input-border);
  }

  .main-password__input[aria-invalid='true'] {
    border-color: color-mix(in srgb, var(--color-error) 65%, var(--color-text));
  }

  [dir='rtl'] .main-password__input[dir='ltr'] {
    text-align: end;
  }

  .main-password__button {
    flex-shrink: 0;
  }

  .main-password__error {
    color: color-mix(in srgb, var(--color-error) 65%, var(--color-text));
    font-weight: 600;
  }

  /* Status and error messages are focused only by script so they are announced; not controls. */
  .main-password__error:focus,
  .main-password__status:focus {
    outline: none;
  }

  .main-password__status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    font-weight: 700;

    & .icon {
      color: color-mix(in srgb, var(--color-success) 65%, var(--color-text));
    }
  }

  .main-password__consent {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .main-password__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-4) var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  .main-password__login {
    inline-size: min(100%, 420px);
  }

  .main-password__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--touch-target);
    padding-inline: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-md);
    font-weight: 700;
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      color: var(--color-text);
    }
  }

  .main-password__chevron {
    transition: transform var(--duration-fast) var(--ease);
  }

  .main-password__login[open] .main-password__chevron {
    transform: rotate(180deg);
  }

  .main-password__login-body {
    display: block;
    padding-block: var(--space-3) var(--space-1);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-night"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "t:sections.main_password.settings.heading_highlight.label",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:sections.main_password.settings.text.info"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "t:sections.main_password.settings.show_signup.label",
      "info": "t:sections.main_password.settings.show_signup.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.main_password.settings.show_social.label",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 32
    }
  ]
}
{% endschema %}
