{%- comment -%}
  Site footer, dark brand shell by default (scheme-night).
  Blocks: brand (logo + short text), menu (link list), contact (phone / email / WhatsApp from
  Theme settings > Business details), newsletter (customer form). Always rendered below the blocks:
  language switcher, social links, store policies, the accessibility statement link, the business
  details line required by Israeli law, payment icons and the copyright.
  Layout: one column on mobile (menu links in two columns, like the approved board), two columns
  on tablet, four on desktop.
{%- endcomment -%}
{%- liquid
  assign whatsapp_digits = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign phone_href = settings.support_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign accessibility_page = section.settings.accessibility_page

  assign has_brand = false
  for block in section.blocks
    if block.type == 'brand'
      assign has_brand = true
    endif
  endfor
  assign wide_brand = false
  if has_brand and section.blocks.size < 4
    assign wide_brand = true
  endif

  assign has_business = false
  if settings.business_name != blank or settings.business_id != blank or settings.business_address != blank
    assign has_business = true
  endif
-%}
<footer
  class="section footer color-{{ section.settings.color_scheme.id }}{% if wide_brand %} footer--wide-brand{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__blocks">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'brand' -%}
              {%- liquid
                assign brand_text = block.settings.text
                if brand_text == blank
                  assign brand_text = 'footer.brand_text' | t
                endif
              -%}
              <div class="footer__block footer__block--brand" {{ block.shopify_attributes }}>
                {%- render 'logo', loading: 'lazy', class: 'footer__logo' -%}
                {%- if block.settings.show_text -%}
                  <p class="footer__text">{{ brand_text }}</p>
                {%- endif -%}
              </div>

            {%- when 'menu' -%}
              {%- liquid
                assign footer_menu = block.settings.menu
                assign menu_heading = block.settings.heading
                if menu_heading == blank
                  assign menu_heading = 'footer.menu_heading' | t
                endif
              -%}
              {%- if footer_menu.links.size > 0 -%}
                <nav
                  class="footer__block footer__block--menu"
                  aria-labelledby="FooterMenuHeading-{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <h2
                    class="footer__heading{% unless block.settings.show_heading %} visually-hidden{% endunless %}"
                    id="FooterMenuHeading-{{ block.id }}"
                  >
                    {{ menu_heading }}
                  </h2>
                  <ul class="footer__links" role="list">
                    {%- for link in footer_menu.links -%}
                      <li>
                        <a
                          class="footer__link"
                          href="{{ link.url }}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              {%- elsif request.design_mode -%}
                <div class="footer__block footer__block--menu" {{ block.shopify_attributes }}>
                  <p class="footer__editor-note">{{ 'footer.editor.no_menu' | t }}</p>
                </div>
              {%- endif -%}

            {%- when 'contact' -%}
              {%- liquid
                assign contact_heading = block.settings.heading
                if contact_heading == blank
                  assign contact_heading = 'footer.contact_heading' | t
                endif
                assign has_channels = false
                if settings.support_phone != blank or settings.support_email != blank or whatsapp_digits != blank
                  assign has_channels = true
                endif
              -%}
              {%- if has_channels or block.settings.text != blank or request.design_mode -%}
                <div class="footer__block footer__block--contact" {{ block.shopify_attributes }}>
                  <h2 class="footer__heading">{{ contact_heading }}</h2>
                  {%- if has_channels -%}
                    <ul class="footer__contact" role="list">
                      {%- if whatsapp_digits != blank -%}
                        <li>
                          <a
                            class="footer__contact-link"
                            href="https://wa.me/{{ whatsapp_digits }}"
                            target="_blank"
                            rel="noopener"
                          >
                            {%- render 'icon', name: 'whatsapp', size: 20 -%}
                            <span>{{ 'footer.whatsapp_link' | t }}</span>
                            <span class="visually-hidden">({{ 'accessibility.new_window' | t }})</span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if settings.support_phone != blank -%}
                        <li>
                          <a class="footer__contact-link" href="tel:{{ phone_href | escape }}">
                            {%- render 'icon', name: 'phone', size: 20 -%}
                            <span class="visually-hidden">{{ 'footer.phone_label' | t }}:</span>
                            <span dir="ltr">{{ settings.support_phone | escape }}</span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if settings.support_email != blank -%}
                        <li>
                          <a class="footer__contact-link" href="mailto:{{ settings.support_email | strip | escape }}">
                            {%- render 'icon', name: 'mail', size: 20 -%}
                            <span class="visually-hidden">{{ 'footer.email_label' | t }}:</span>
                            <span dir="ltr">{{ settings.support_email | strip | escape }}</span>
                          </a>
                        </li>
                      {%- endif -%}
                    </ul>
                  {%- elsif request.design_mode -%}
                    <p class="footer__editor-note">{{ 'footer.editor.no_contact' | t }}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="footer__text footer__hours">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'newsletter' -%}
              {%- liquid
                assign newsletter_heading = block.settings.heading
                if newsletter_heading == blank
                  assign newsletter_heading = 'footer.newsletter.heading' | t
                endif
                assign newsletter_text = block.settings.text
                if newsletter_text == blank
                  assign newsletter_text = 'footer.newsletter.text' | t
                endif
                assign newsletter_consent = block.settings.consent
                if newsletter_consent == blank
                  assign newsletter_consent = 'footer.newsletter.consent' | t
                endif
                assign newsletter_id = 'FooterNewsletter-' | append: block.id
              -%}
              <div class="footer__block footer__block--newsletter" {{ block.shopify_attributes }}>
                <h2 class="footer__heading">{{ newsletter_heading }}</h2>
                <p class="footer__text">{{ newsletter_text }}</p>
                <sw-validated-form
                  data-error-required="{{ 'pages.form.errors.required' | t }}"
                  data-error-email="{{ 'pages.form.errors.email' | t }}"
                  data-error-invalid="{{ 'pages.form.errors.invalid' | t }}"
                >
                  {%- form 'customer', id: newsletter_id, class: 'footer-newsletter' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    {%- liquid
                      assign email_error = ''
                      if form.errors contains 'email'
                        assign email_error = 'pages.form.errors.email' | t
                      elsif form.errors
                        assign email_error = form.errors.messages.form
                        if email_error == blank
                          assign email_error = 'general.errors.generic' | t
                        endif
                      endif
                    -%}
                    {%- if form.posted_successfully? -%}
                      <p class="footer-newsletter__status" role="status" tabindex="-1" data-form-status>
                        {%- render 'icon', name: 'check', size: 18 -%}
                        <span>{{ 'footer.newsletter.success' | t }}</span>
                      </p>
                    {%- endif -%}
                    <label class="footer-newsletter__label" for="{{ newsletter_id }}-email">
                      {{- 'footer.newsletter.email_label' | t -}}
                    </label>
                    <div class="footer-newsletter__row">
                      <input
                        class="field__input footer-newsletter__input"
                        type="email"
                        id="{{ newsletter_id }}-email"
                        name="contact[email]"
                        value="{{ form.email | escape }}"
                        autocomplete="email"
                        dir="ltr"
                        placeholder="{{ 'pages.form.email_placeholder' | t }}"
                        required
                        aria-describedby="{% if email_error != blank %}{{ newsletter_id }}-email-error {% endif %}{{ newsletter_id }}-consent"
                        {% if email_error != blank %}
                          aria-invalid="true"
                        {% endif %}
                      >
                      <button class="button button--primary footer-newsletter__submit" type="submit">
                        {{- 'footer.newsletter.submit' | t -}}
                      </button>
                    </div>
                    <p
                      class="field__message footer-newsletter__error"
                      id="{{ newsletter_id }}-email-error"
                      {% if email_error == blank %}
                        hidden
                      {% endif %}
                    >
                      {%- render 'icon', name: 'alert', size: 16 -%}
                      <span data-error-text>{{ email_error }}</span>
                    </p>
                    <p class="footer-newsletter__consent" id="{{ newsletter_id }}-consent">{{ newsletter_consent }}</p>
                  {%- endform -%}
                </sw-validated-form>
                <script type="module" src="{{ 'content-form.js' | asset_url }}"></script>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      {%- if section.settings.show_language_selector or section.settings.show_social -%}
        <div class="footer__row">
          {%- if section.settings.show_language_selector -%}
            {%- render 'localization-switcher', id: 'FooterLocalization' -%}
          {%- endif -%}
          {%- if section.settings.show_social -%}
            {%- render 'social-icons', class: 'footer__social' -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="footer__row footer__row--legal">
        <div class="footer__legal">
          {%- if shop.policies.size > 0 or accessibility_page != blank -%}
            <nav class="footer__policies" aria-label="{{ 'footer.policies_label' | t }}">
              <ul class="footer__policy-list" role="list">
                {%- if accessibility_page != blank -%}
                  <li>
                    <a
                      class="footer__policy-link"
                      href="{{ accessibility_page.url }}"
                      {% if request.page_type == 'page' and page.id == accessibility_page.id %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- 'footer.accessibility_statement' | t -}}
                    </a>
                  </li>
                {%- endif -%}
                {%- for policy in shop.policies -%}
                  <li>
                    <a class="footer__policy-link" href="{{ policy.url }}">{{ policy.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
          {%- if request.design_mode and accessibility_page == blank -%}
            <p class="footer__editor-note">{{ 'footer.editor.accessibility_page' | t }}</p>
          {%- endif -%}

          {%- if has_business -%}
            <address class="footer__business">
              {%- if settings.business_name != blank -%}
                <span class="footer__business-item">{{ settings.business_name | escape }}</span>
              {%- endif -%}
              {%- if settings.business_id != blank -%}
                <span class="footer__business-item">
                  {{- 'footer.business_id' | t: id: settings.business_id -}}
                </span>
              {%- endif -%}
              {%- if settings.business_address != blank -%}
                <span class="footer__business-item"
                  ><bdi>{{ settings.business_address | escape }}</bdi></span
                >
              {%- endif -%}
            </address>
          {%- endif -%}

          {%- assign copyright_year = 'now' | date: '%Y' -%}
          <p class="footer__copyright">
            &copy; {{ copyright_year }}
            <bdi>{{ shop.name | escape }}</bdi>
          </p>
        </div>

        {%- if section.settings.show_payment_icons -%}
          {%- if shop.enabled_payment_types.size > 0 -%}
            <div class="footer__payments">
              <h2 class="visually-hidden">{{ 'footer.payment_methods' | t }}</h2>
              <ul class="footer__payment-list" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li class="footer__payment-item">{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- else -%}
            <p class="footer__secure">
              {%- render 'icon', name: 'lock', size: 16 -%}
              <span>{{ 'general.trust.secure_payment' | t }}</span>
            </p>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    --footer-link: color-mix(in srgb, var(--color-text) 82%, var(--color-background));
    --footer-input-border: color-mix(in srgb, var(--color-text) 45%, var(--color-background));
  }

  .footer__blocks {
    display: grid;
    gap: var(--space-8) var(--space-6);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-10) var(--space-8);
    }
  }

  .footer__block {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-inline-size: 0;
  }

  .footer__block--brand,
  .footer__block--newsletter {
    gap: var(--space-4);

    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
    }

    @media screen and (min-width: 990px) {
      grid-column: auto;
    }
  }

  .footer--wide-brand .footer__block--brand {
    @media screen and (min-width: 990px) {
      grid-column: span 2;
    }
  }

  .footer__logo {
    justify-self: start;
  }

  .footer__heading {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: var(--leading-tight);
  }

  .footer__text {
    max-inline-size: 42ch;
    color: var(--color-muted);
    font-size: var(--text-md);
  }

  .footer__links,
  .footer__contact,
  .footer__policy-list,
  .footer__payment-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-3);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .footer__link,
  .footer__contact-link {
    display: flex;
    align-items: center;
    min-block-size: var(--touch-target);
    color: var(--footer-link);
    font-size: var(--text-md);
    line-height: var(--leading-tight);
    text-decoration: none;
    text-underline-offset: 3px;

    &:hover {
      color: var(--color-text);
      text-decoration: underline;
    }
  }

  .footer__link[aria-current='page'] {
    color: var(--color-text);
    font-weight: 700;
  }

  .footer__contact-link {
    display: inline-flex;
    gap: var(--space-3);

    & .icon {
      color: var(--color-muted);
    }
  }

  .footer__hours {
    font-size: var(--text-sm);

    & > * + * {
      margin-block-start: var(--space-1);
    }
  }

  .footer-newsletter {
    display: grid;
    gap: var(--space-2);
    max-inline-size: 520px;
  }

  .footer-newsletter__label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .footer-newsletter__row {
    display: flex;
    gap: var(--space-2);
  }

  .footer-newsletter__input {
    flex: 1 1 auto;
    min-inline-size: 0;
    min-block-size: var(--control-height);
    border-color: var(--footer-input-border);
  }

  .footer-newsletter__input[aria-invalid='true'] {
    border-color: color-mix(in srgb, var(--color-error) 65%, var(--color-text));
  }

  [dir='rtl'] .footer-newsletter__input[dir='ltr'] {
    text-align: end;
  }

  .footer-newsletter__submit {
    flex-shrink: 0;
  }

  .footer-newsletter__error {
    color: color-mix(in srgb, var(--color-error) 65%, var(--color-text));
    font-weight: 600;
  }

  .footer-newsletter__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;

    /* Focused only by script so it is announced; not a control. */
    &:focus {
      outline: none;
    }

    & .icon {
      color: color-mix(in srgb, var(--color-success) 65%, var(--color-text));
    }
  }

  .footer-newsletter__consent {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .footer__bottom {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--space-10);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);

    /* Nothing to show (one language, no social links): drop the empty row and its gap. */
    &:not(:has(*)) {
      display: none;
    }
  }

  .footer__row--legal {
    align-items: flex-end;
  }

  .footer__legal {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .footer__policy-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-5);
  }

  .footer__policy-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    color: var(--footer-link);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 3px;

    &:hover {
      color: var(--color-text);
      text-decoration-color: currentColor;
    }

    &[aria-current='page'] {
      color: var(--color-text);
      font-weight: 700;
    }
  }

  .footer__business {
    font-style: normal;
    line-height: 1.7;
  }

  .footer__business-item + .footer__business-item::before {
    content: '·';
    content: '·' / '';
    margin-inline: var(--space-2);
  }

  .footer__copyright {
    font-size: var(--text-xs);
  }

  .footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer__payment-item {
    display: flex;
  }

  .footer__payment-icon {
    inline-size: 38px;
    block-size: 24px;
  }

  .footer__secure {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .footer__editor-note {
    padding: var(--space-3);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "limit": 1,
  "max_blocks": 8,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-night"
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "t:sections.footer.settings.show_language_selector.label",
      "info": "t:sections.footer.settings.show_language_selector.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.footer.settings.show_social.label",
      "info": "t:sections.footer.settings.show_social.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.legal.content"
    },
    {
      "type": "page",
      "id": "accessibility_page",
      "label": "t:sections.footer.settings.accessibility_page.label",
      "info": "t:sections.footer.settings.accessibility_page.info"
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.settings.business_info.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand.settings.logo_info.content"
        },
        {
          "type": "checkbox",
          "id": "show_text",
          "label": "t:sections.footer.blocks.brand.settings.show_text.label",
          "default": true
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:settings.text",
          "info": "t:settings.default_text_info"
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "limit": 3,
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:settings.menu",
          "default": "footer"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "info": "t:settings.default_text_info"
        },
        {
          "type": "checkbox",
          "id": "show_heading",
          "label": "t:sections.footer.blocks.menu.settings.show_heading.label",
          "info": "t:sections.footer.blocks.menu.settings.show_heading.info",
          "default": true
        }
      ]
    },
    {
      "type": "contact",
      "name": "t:sections.footer.blocks.contact.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.contact.settings.info.content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "info": "t:settings.default_text_info"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.contact.settings.text.label",
          "info": "t:sections.footer.blocks.contact.settings.text.info"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.newsletter.settings.info.content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "info": "t:settings.default_text_info"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text",
          "info": "t:settings.default_text_info"
        },
        {
          "type": "inline_richtext",
          "id": "consent",
          "label": "t:sections.footer.blocks.newsletter.settings.consent.label",
          "info": "t:settings.default_text_info"
