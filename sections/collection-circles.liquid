{%- comment -%}
  Player and team cards: a row of big collector cards that link to collections, such as players or teams.
  Each block is a collection. Its card shows:
  - a cut-out jersey: the block's picture, else the collection's metafield sportwear.card_image, else a
    photo of the collection's first adult jersey (or its first product) on a light tile;
  - the card's color (block setting, else sportwear.card_color, else the accent) as a glow on a dark card;
  - a giant outlined number or short code behind the jersey (block setting, else sportwear.card_mark,
    for example 24 or RMA);
  - the collection's own (translated) title and product count on a dark nameplate, with an arrow.
  On computers with a mouse the card tilts toward the pointer (assets/collector-cards.js); with reduced
  motion it stays still. The row scrolls sideways at every width (arrows from tablets up, through
  <sw-carousel> in assets/product-carousel.js). A collection with no products is skipped outside the
  theme editor. The heading, eyebrow, text and link label come from a translated copy set (players,
  teams) unless the owner writes their own.
{%- endcomment -%}
{%- liquid
  # Further down a page (after its third section) this section can wait until the visitor scrolls near
  # it: it renders as an outline (snippets/deferred-section.liquid) and assets/deferred-section.js loads
  # it through the Section Rendering API, where section.index is nil, as in the theme editor, so both
  # render it in full. A long page stays within Shopify's render time this way.
  assign defer_render = false
  if section.settings.lazy_render and section.index > 3
    assign defer_render = true
  endif
-%}
{%- if defer_render -%}
  {%- render 'deferred-section',
    section_id: section.id,
    color_scheme: section.settings.color_scheme.id,
    min_height: 520,
    min_height_desktop: 520,
    shape: 'cards'
  -%}
{%- else -%}
  {%- liquid
    assign copy = section.settings.copy | default: 'none'
    assign eyebrow = section.settings.eyebrow | escape
    assign heading = section.settings.heading | escape
    assign text = section.settings.text | escape
    assign link_label = section.settings.link_label | escape
    if copy != 'none'
      assign copy_key = 'home.collection_circles.copy.' | append: copy
      if eyebrow == blank
        assign eyebrow = copy_key | append: '.eyebrow' | t
      endif
      if heading == blank
        assign heading = copy_key | append: '.heading' | t
      endif
      if text == blank
        assign text = copy_key | append: '.text' | t
      endif
      if link_label == blank
        assign link_label = copy_key | append: '.view_all' | t
      endif
    endif
    if heading == blank
      assign heading = 'home.collection_circles.heading' | t
    endif
    if link_label == blank
      assign link_label = 'general.view_all' | t
    endif

    assign list_id = 'CollectionCards-' | append: section.id
    assign visible_count = 0
    for block in section.blocks
      if block.settings.collection.all_products_count > 0 or request.design_mode
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  -%}
  {%- if visible_count > 0 -%}
    <div
      class="section collection-cards color-{{ section.settings.color_scheme.id }}"
      style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
    >
      <sw-carousel class="collection-cards__carousel">
        <div class="page-width">
          <div class="section-header collection-cards__header">
            <div class="collection-cards__title">
              {%- if eyebrow != blank -%}
                <p class="eyebrow collection-cards__eyebrow">{{ eyebrow }}</p>
              {%- endif -%}
              <h2 class="collection-cards__heading display-m">{{ heading }}</h2>
              {%- if text != blank -%}
                <p class="collection-cards__text">{{ text }}</p>
              {%- endif -%}
            </div>
            <div class="collection-cards__tools">
              {%- if section.settings.link != blank -%}
                <a class="collection-cards__all" href="{{ section.settings.link }}">
                  {{- link_label -}}
                </a>
              {%- endif -%}
              <div class="collection-cards__arrows js-only">
                <button
                  type="button"
                  class="collection-cards__arrow"
                  aria-controls="{{ list_id }}"
                  aria-disabled="true"
                  data-carousel-prev
                >
                  {%- render 'icon', name: 'chevron-back', size: 20 -%}
                  <span class="visually-hidden">{{ 'accessibility.previous' | t }}</span>
                </button>
                <button
                  type="button"
                  class="collection-cards__arrow"
                  aria-controls="{{ list_id }}"
                  aria-disabled="false"
                  data-carousel-next
                >
                  {%- render 'icon', name: 'chevron-forward', size: 20 -%}
                  <span class="visually-hidden">{{ 'accessibility.next' | t }}</span>
                </button>
              </div>
            </div>
          </div>
        </div>
        <sw-collector-cards class="collection-cards__deck">
          <ul id="{{ list_id }}" class="collection-cards__track" role="list" data-carousel-track>
            {%- for block in section.blocks -%}
              {%- liquid
                assign card_collection = block.settings.collection
                if card_collection == blank or card_collection.all_products_count == 0
                  unless request.design_mode
                    continue
                  endunless
                endif

                assign card_cutout = block.settings.image
                assign card_color = block.settings.color
                assign card_mark = block.settings.mark | strip
                assign card_photo = blank
                if card_collection != blank
                  if card_cutout == blank
                    assign card_cutout = card_collection.metafields.sportwear.card_image.value
                  endif
                  if card_color == blank
                    assign card_color = card_collection.metafields.sportwear.card_color.value
                  endif
                  if card_mark == blank
                    assign card_mark = card_collection.metafields.sportwear.card_mark.value | strip
                  endif

                  # No cut-out: the collection's own image, else the photo of its first adult jersey among
                  # its first 6 products (a team's newest product may be its shorts or a kids set), else
                  # its first product's.
                  if card_cutout == blank
                    assign card_photo = card_collection.image
                    if card_photo == blank
                      assign kids_photo = blank
                      for card_product in card_collection.products limit: 6
                        if card_product.type contains 'Jersey'
                          if card_product.tags contains 'audience:kids'
                            if kids_photo == blank
                              assign kids_photo = card_product.featured_media.preview_image
                            endif
                          else
                            assign card_photo = card_product.featured_media.preview_image
                            break
                          endif
                        endif
                      endfor
                      if card_photo == blank
                        assign card_photo = kids_photo
                      endif
                      if card_photo == blank
                        assign card_photo = card_collection.featured_image
                      endif
                    endif
                  endif
                endif

                assign mark_class = ''
                case card_mark.size
                  when 1
                    assign mark_class = ' collector-card__mark--1'
                  when 3
                    assign mark_class = ' collector-card__mark--3'
                  when 4, 5, 6
                    assign mark_class = ' collector-card__mark--4'
                endcase
              -%}
              <li class="collection-cards__item" {{ block.shopify_attributes }}>
                {%- if card_collection != blank -%}
                  <a
                    class="collector-card"
                    href="{{ card_collection.url }}"
                    {% if card_color != blank %}
                      style="--card-color: {{ card_color }};"
                    {% endif %}
                  >
                    <span class="collector-card__dots" aria-hidden="true"></span>
                    {%- if card_mark != blank -%}
                      <span class="collector-card__mark{{ mark_class }}" aria-hidden="true">
                        {{- card_mark | escape -}}
                      </span>
                    {%- endif -%}
                    {%- if card_cutout != blank -%}
                      <span class="collector-card__media">
                        {%- render 'image',
                          image: card_cutout,
                          sizes: '(min-width: 1200px) 202px, (min-width: 750px) 190px, 52vw',
                          widths: '200, 300, 400, 500, 600',
                          alt: '',
                          class: 'collector-card__image'
                        -%}
                      </span>
                    {%- else -%}
                      <span class="collector-card__media collector-card__media--photo">
                        <span class="collector-card__photo">
                          {%- if card_photo != blank -%}
                            {%- render 'image',
                              image: card_photo,
                              sizes: '(min-width: 1200px) 172px, (min-width: 750px) 160px, 44vw',
                              widths: '180, 270, 360, 480',
                              alt: '',
                              class: 'collector-card__image'
                            -%}
                          {%- else -%}
                            {%- render 'icon', name: 'shirt', size: 40 -%}
                          {%- endif -%}
                        </span>
                      </span>
                    {%- endif -%}
                    <span class="collector-card__shine" aria-hidden="true"></span>
                    <span class="collector-card__logo" aria-hidden="true">{%- render 'logo-mark' -%}</span>
                    <span class="collector-card__plate">
                      <span class="collector-card__name">{{ card_collection.title | escape }}</span>
                      <span class="collector-card__meta">
                        {%- if section.settings.show_count -%}
                          <span class="collector-card__count">
                            {{- 'home.featured_collection.count' | t: count: card_collection.all_products_count -}}
                          </span>
                        {%- endif -%}
                        <span class="collector-card__cta" aria-hidden="true">
                          {%- render 'icon', name: 'arrow-forward', size: 18 -%}
                        </span>
                      </span>
                    </span>
                  </a>
                {%- else -%}
                  <span class="collector-card collector-card--placeholder">
                    <span class="collector-card__media collector-card__media--photo">
                      <span class="collector-card__photo">{%- render 'icon', name: 'shirt', size: 40 -%}</span>
                    </span>
                    <span class="collector-card__plate">
                      <span class="collector-card__name">{{ 'home.collection_circles.placeholder' | t }}</span>
                    </span>
                  </span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </sw-collector-cards>
      </sw-carousel>
    </div>
    <script type="module" src="{{ 'product-carousel.js' | asset_url }}"></script>
    <script type="module" src="{{ 'collector-cards.js' | asset_url }}"></script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .collection-cards__carousel,
  .collection-cards__deck {
    display: block;
  }

  .collection-cards__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .collection-cards__eyebrow {
    margin: 0;
    color: var(--color-accent-text);
  }

  .collection-cards__heading {
    margin: 0;
    overflow-wrap: break-word;
  }

  .collection-cards__text {
    max-inline-size: 60ch;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }

  .collection-cards__tools {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-4);
  }

  .collection-cards__all {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
    color: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    white-space: nowrap;

    &:hover {
      text-decoration-color: var(--color-accent-text);
    }
  }

  /* Like the product rows, the section runs across the whole screen: the header and the row start at
     the screen's side (the gutter) and the row runs to the end edge; each card snaps to the start. On
     phones the next card peeks in. */
  .collection-cards {
    --page-width: 100vw;
  }

  .collection-cards__track {
    --card-inline: min(64vw, 260px);
    --cards-start: max(var(--gutter), calc((100% - var(--page-width, 1440px)) / 2));
    display: flex;
    gap: var(--space-3);
    margin: 0;
    /* Room above the cards for the 6px lift plus the focus ring (3px + 3px offset). */
    padding-block: var(--space-4) var(--space-5);
    padding-inline: var(--cards-start) var(--gutter);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: var(--cards-start);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      --card-inline: 236px;
      gap: var(--space-4);
    }

    @media screen and (min-width: 1200px) {
      --card-inline: 252px;
      gap: var(--space-5);
    }
  }

  .collection-cards__item {
    flex: 0 0 var(--card-inline);
    perspective: 900px;
    scroll-snap-align: start;
  }

  /* The card: a dark trading card lit in the collection's color. --px and --py (-1 to 1) follow the
     pointer (assets/collector-cards.js) and tilt the card, the number and the jersey. */
  .collector-card {
    --card-color: var(--color-accent);
    --card-ink: #07080a;
    --card-glow: color-mix(in oklab, var(--card-color) 78%, #fff);
    --px: 0;
    --py: 0;
    --lift: 0px;
    position: relative;
    display: block;
    container-type: inline-size;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-card);
    background:
      radial-gradient(
        75% 58% at 50% 34%,
        color-mix(in oklab, var(--card-glow) 88%, transparent) 0%,
        color-mix(in oklab, var(--card-color) 42%, transparent) 42%,
        transparent 74%
      ),
      linear-gradient(
        168deg,
        color-mix(in oklab, var(--card-color) 46%, var(--card-ink)) 0%,
        color-mix(in oklab, var(--card-color) 16%, var(--card-ink)) 62%,
        var(--card-ink) 100%
      );
    color: #fff;
    text-decoration: none;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.08) inset,
      0 10px 24px -12px rgb(8 9 11 / 0.55);
    transform: rotateY(calc(var(--px) * 7deg)) rotateX(calc(var(--py) * -6deg)) translateY(var(--lift));
    transition:
      transform var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);

    /* The inner frame of a printed card; it lights up in the accent color on hover and focus. */
    &::after {
      content: '';
      position: absolute;
      inset: 7px;
      z-index: 4;
      border: 1px solid rgb(255 255 255 / 0.14);
      border-radius: max(0px, calc(var(--radius-card) - 3px));
      pointer-events: none;
      transition: border-color var(--duration) var(--ease);
    }

    &:is(a):hover,
    &:is(a):focus-visible {
      --lift: -6px;
      box-shadow:
        0 1px 0 rgb(255 255 255 / 0.1) inset,
        0 22px 34px -16px rgb(8 9 11 / 0.6);

      &::after {
        border-color: color-mix(in oklab, var(--color-accent) 75%, transparent);
      }
    }

    &:focus-visible {
      outline: 3px solid var(--color-text);
      outline-offset: 3px;
    }

    &:is(a):active {
      --lift: 0px;
      scale: 0.98;
    }

    &[data-tilting] {
      transition-duration: 90ms;
    }
  }

  /* Halftone dots in the top corner: the print texture of a collector card. */
  .collector-card__dots {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.22) 1px, transparent 1.3px);
    background-size: 7px 7px;
    mask-image: radial-gradient(90% 70% at 100% 0%, #000 0%, transparent 62%);
    opacity: 0.55;
    pointer-events: none;
  }

  /* The giant number or code behind the jersey. Digits and Latin letters read left to right. */
  .collector-card__mark {
    position: absolute;
    inset-block-start: 4%;
    inset-inline: 0;
    z-index: 1;
    color: color-mix(in oklab, var(--card-glow) 16%, transparent);
    font-family: var(--font-display);
    font-size: 86cqi;
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-align: center;
    -webkit-text-stroke: 1.5px color-mix(in oklab, var(--card-glow) 58%, transparent);
    direction: ltr;
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    transform: translate3d(calc(var(--px) * -8px), calc(var(--py) * -8px), 0);
    transition: transform var(--duration) var(--ease);
  }

  .collector-card__mark--1 {
    font-size: 104cqi;
  }

  .collector-card__mark--3 {
    inset-block-start: 9%;
    font-size: 50cqi;
  }

  .collector-card__mark--4 {
    inset-block-start: 11%;
    font-size: 38cqi;
  }

  .collector-card__media {
    position: absolute;
    inset-block: 6% 34%;
    inset-inline: 10%;
    z-index: 2;
    display: grid;
    place-items: center;
    transform: translate3d(calc(var(--px) * 6px), calc(var(--py) * 6px), 0);
    transition: transform var(--duration) var(--ease);
  }

  .collector-card__image {
    max-inline-size: 100%;
    max-block-size: 100%;
    inline-size: auto;
    block-size: 100%;
    object-fit: contain;
    filter: drop-shadow(0 16px 18px rgb(0 0 0 / 0.45));
    transition: transform var(--duration) var(--ease);
  }

  /* No cut-out picture: the product photo on its light tile, framed like a card's photo window. */
  .collector-card__media--photo {
    inset-block: 9% 36%;
    inset-inline: 17%;
  }

  .collector-card__photo {
    display: grid;
    place-items: center;
    inline-size: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-tile);
    color: #5b616e;
    box-shadow: 0 14px 22px -10px rgb(0 0 0 / 0.55);

    .collector-card__image {
      inline-size: 88%;
      block-size: 88%;
      filter: none;
    }
  }

  .collector-card:is(a):hover .collector-card__image {
    transform: translateY(-4px) scale(1.05);
  }

  /* A sweep of light across the card on hover, like foil, with a glare that follows the pointer. */
  .collector-card__shine {
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      radial-gradient(
        circle at calc(50% + var(--px) * 50%) calc(50% + var(--py) * 50%),
        rgb(255 255 255 / 0.16),
        transparent 42%
      ),
      linear-gradient(
        112deg,
        transparent 38%,
        rgb(255 255 255 / 0.16) 47%,
        rgb(255 255 255 / 0.04) 53%,
        transparent 60%
      );
    background-position:
      0 0,
      115% 0;
    background-size:
      100% 100%,
      260% 100%;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration) var(--ease),
      background-position 900ms var(--ease);
  }

  .collector-card:is(a):hover .collector-card__shine {
    background-position:
      0 0,
      -15% 0;
    opacity: 1;
  }

  .collector-card__logo {
    position: absolute;
    inset-block-start: 15px;
    inset-inline-end: 15px;
    z-index: 4;
    display: block;
    inline-size: 22px;
    color: rgb(255 255 255 / 0.62);

    .logo-mark {
      display: block;
      inline-size: 100%;
      block-size: auto;
    }
  }

  .collector-card__plate {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 16% var(--space-4) var(--space-4);
    background: linear-gradient(to top, rgb(7 8 10 / 0.96) 0%, rgb(7 8 10 / 0.86) 52%, transparent 100%);
  }

  .collector-card__name {
    display: -webkit-box;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: clamp(22px, 11cqi, 30px);
    line-height: 1.02;
    text-transform: uppercase;
    overflow-wrap: break-word;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :lang(ar) .collector-card__name {
    line-height: 1.25;
  }

  .collector-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-block-size: 36px;
  }

  .collector-card__count {
    color: rgb(255 255 255 / 0.74);
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .collector-card__cta {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    margin-inline-start: auto;
    border-radius: 50%;
    background: var(--color-accent);
    color: #0d0e11;
    transition: translate var(--duration) var(--ease);
  }

  .collector-card:is(a):hover .collector-card__cta {
    translate: 3px 0;
  }

  .collector-card:is(a):hover .collector-card__cta:dir(rtl) {
    translate: -3px 0;
  }

  .collection-cards__arrows {
    display: none;
    flex-shrink: 0;
    gap: var(--space-2);

    @media screen and (min-width: 750px) {
      display: flex;
    }
  }

  .collection-cards__arrow {
    display: inline-grid;
    place-items: center;
    inline-size: var(--touch-target);
    block-size: var(--touch-target);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-text);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);

    &:hover:not([aria-disabled='true']) {
      border-color: var(--color-text);
      background: var(--color-text);
      color: var(--color-background);
    }

    &[aria-disabled='true'] {
      opacity: 0.35;
      cursor: default;
    }
  }

  /* Everything fits: no arrows. */
  sw-carousel:not([data-scrollable]) .collection-cards__arrows {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .collector-card,
    .collector-card__mark,
    .collector-card__media,
    .collector-card__image,
    .collector-card__shine,
    .collector-card__cta {
      transition: none;
    }

    .collector-card,
    .collector-card__mark,
    .collector-card__media {
      transform: none;
    }

    .collector-card:is(a):hover .collector-card__image {
      transform: none;
    }

    .collector-card:is(a):hover .collector-card__cta {
      translate: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_circles.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-day"
    },
    {
      "type": "checkbox",
      "id": "lazy_render",
      "label": "t:sections.featured_collection.settings.lazy_render.label",
      "info": "t:sections.featured_collection.settings.lazy_render.info",
      "default": true
    },
    {
      "type": "select",
      "id": "copy",
      "label": "t:sections.collection_circles.settings.copy.label",
      "info": "t:sections.collection_circles.settings.copy.info",
      "options": [
        { "value": "none", "label": "t:sections.collection_circles.settings.copy.options.none" },
        { "value": "players", "label": "t:sections.collection_circles.settings.copy.options.players" },
