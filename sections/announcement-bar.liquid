{%- comment -%}
  Announcement bar (header group). One to five short messages, each with an optional link and icon.
  A blank message shows the translated default: free shipping from the theme setting
  "free_shipping_threshold" plus the 3-business-day delivery promise.
  With more than one message it becomes a calm carousel (assets/header.js, <sw-announcement-bar>):
  it rotates every few seconds, pauses on hover and focus, has previous / next / pause buttons and
  never starts on its own for visitors who prefer reduced motion. Without JavaScript the first
  message is shown and the controls are hidden.
{%- endcomment -%}
{%- liquid
  assign slide_count = section.blocks.size
  assign rotating = false
  if slide_count > 1
    assign rotating = true
  endif

  # Free shipping exists for Israel only; visitors from elsewhere see the delivery promise alone.
  capture threshold_cents
    render 'free-shipping-cents'
  endcapture
  assign threshold_cents = threshold_cents | plus: 0
  if threshold_cents > 0
    # Unicode isolates (U+2068/U+2069) keep the amount's direction inside RTL text.
    assign threshold_amount = threshold_cents | money_without_trailing_zeros | prepend: '⁨' | append: '⁩'
    assign default_message = 'header.announcement.free_shipping' | t: amount: threshold_amount
  else
    assign default_message = 'header.announcement.delivery' | t
  endif
-%}
{%- if slide_count > 0 -%}
  <sw-announcement-bar
    class="announcement-bar color-{{ section.settings.color_scheme.id }}"
    {% if rotating %}
      data-autoplay="{{ section.settings.autorotate }}"
      data-interval="{{ section.settings.autorotate_speed }}"
    {% endif %}
  >
    <div
      class="announcement-bar__inner"
      role="region"
      aria-label="{{ 'header.announcement.label' | t }}"
      {% if rotating %}
        aria-roledescription="{{ 'header.announcement.carousel' | t }}"
      {% endif %}
    >
      <div
        id="AnnouncementSlides-{{ section.id }}"
        class="announcement-bar__slides"
        {% if rotating %}
          aria-live="off" data-announcement-slides
        {% endif %}
      >
        {%- for block in section.blocks -%}
          {%- liquid
            if block.settings.text != blank
              assign message = block.settings.text | escape
            else
              assign message = default_message
            endif
          -%}
          <div
            class="announcement-bar__slide{% if forloop.first %} announcement-bar__slide--active{% endif %}"
            {% if rotating %}
              role="group"
              aria-roledescription="{{ 'header.announcement.slide' | t }}"
              aria-label="{{ 'header.announcement.slide_label' | t: index: forloop.index, count: forloop.length }}"
              data-announcement-slide
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a
                class="announcement-bar__message announcement-bar__message--link"
                href="{{ block.settings.link }}"
              >
                <span class="announcement-bar__text">
                  {%- unless block.settings.icon == 'none' -%}
                    {%- render 'icon', name: block.settings.icon, size: 17, class: 'announcement-bar__icon' -%}
                  {%- endunless -%}
                  {{- message -}}
                </span>
              </a>
            {%- else -%}
              <p class="announcement-bar__message">
                <span class="announcement-bar__text">
                  {%- unless block.settings.icon == 'none' -%}
                    {%- render 'icon', name: block.settings.icon, size: 17, class: 'announcement-bar__icon' -%}
                  {%- endunless -%}
                  {{- message -}}
                </span>
              </p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if rotating -%}
        <div class="announcement-bar__controls js-only">
          <button
            type="button"
            class="announcement-bar__button"
            aria-controls="AnnouncementSlides-{{ section.id }}"
            data-announcement-prev
          >
            {%- render 'icon', name: 'chevron-back', size: 18 -%}
            <span class="visually-hidden">{{ 'header.announcement.previous' | t }}</span>
          </button>
          {%- if section.settings.autorotate -%}
            <button
              type="button"
              class="announcement-bar__button announcement-bar__toggle"
              aria-controls="AnnouncementSlides-{{ section.id }}"
              data-announcement-toggle
              data-state="playing"
              data-label-pause="{{ 'header.announcement.pause' | t }}"
              data-label-play="{{ 'header.announcement.play' | t }}"
            >
              {%- comment -%} Media icons keep their direction in RTL, so they are not mirrored. {%- endcomment -%}
              <svg
                class="icon announcement-bar__pause-icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
              >
                <path d="M8.5 5.5v13M15.5 5.5v13"/>
              </svg>
              <svg
                class="icon announcement-bar__play-icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
                fill="currentColor"
              >
                <path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l10.6-6.8a.8.8 0 0 0 0-1.4L9.2 4.5a.8.8 0 0 0-1.2.7z"/>
              </svg>
              <span class="visually-hidden" data-announcement-toggle-label>
                {{- 'header.announcement.pause' | t -}}
              </span>
            </button>
          {%- endif -%}
          <button
            type="button"
            class="announcement-bar__button"
            aria-controls="AnnouncementSlides-{{ section.id }}"
            data-announcement-next
          >
            {%- render 'icon', name: 'chevron-forward', size: 18 -%}
            <span class="visually-hidden">{{ 'header.announcement.next' | t }}</span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </sw-announcement-bar>

  {%- if rotating -%}
    <script type="module" src="{{ 'header.js' | asset_url }}"></script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    display: block;
    font-size: calc(12.5px * var(--body-scale, 1));
    font-weight: 700;
    line-height: 1.3;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    min-block-size: 36px;
    max-inline-size: calc(var(--page-width, 1440px) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--space-2);

    @media screen and (min-width: 990px) {
      padding-inline: var(--gutter);
    }
  }

  .announcement-bar__slides {
    display: grid;
    flex: 1;
    min-inline-size: 0;
  }

  .announcement-bar__slide {
    display: flex;
    align-items: center;
    justify-content: center;
    grid-area: 1 / 1;
    min-inline-size: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-fast) var(--ease),
      visibility var(--duration-fast);
  }

  .announcement-bar__slide--active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--duration) var(--ease) var(--duration-fast),
      visibility 0s;
  }

  .announcement-bar__message {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 0;
    padding-block: var(--space-2);
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .announcement-bar__text {
    text-wrap: balance;
  }

  /* Inline, so on a wrapped message the icon stays next to the first word. */
  .announcement-bar__icon {
    display: inline-block;
    margin-inline-end: var(--space-2);
    vertical-align: -4px;
  }

  .announcement-bar__message--link {
    min-block-size: var(--touch-target);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;

    &:hover {
      text-decoration-thickness: 2px;
    }
  }

  .announcement-bar__controls {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  .announcement-bar__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--touch-target);
    block-size: var(--touch-target);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;

    &:hover {
      background: color-mix(in srgb, currentColor 12%, transparent);
    }
  }

  .announcement-bar__toggle[data-state='playing'] .announcement-bar__play-icon,
  .announcement-bar__toggle[data-state='paused'] .announcement-bar__pause-icon {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "div",
  "limit": 1,
  "max_blocks": 5,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-accent"
    },
    {
      "type": "checkbox",
      "id": "autorotate",
      "label": "t:sections.announcement_bar.settings.autorotate.label",
      "info": "t:sections.announcement_bar.settings.autorotate.info",
      "default": true
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "label": "t:sections.announcement_bar.settings.autorotate_speed.label",
      "min": 5,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autorotate }}"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text",
          "info": "t:settings.default_text_info"
        },
        {
          "type": "paragraph",
          "content": "t:sections.announcement_bar.blocks.message.settings.default_text.content"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.announcement_bar.blocks.message.settings.icon.label",
          "default": "truck",
          "options": [
            {
              "value": "truck",
              "label": "t:sections.announcement_bar.blocks.message.settings.icon.options.truck"
            },
            {
              "value": "shield-check",
              "label": "t:sections.announcement_bar.blocks.message.settings.icon.options.shield_check"
            },
            {
              "value": "return",
              "label": "t:sections.announcement_bar.blocks.message.settings.icon.options.return"
            },
            {
              "value": "tag",
              "label": "t:sections.announcement_bar.blocks.message.settings.icon.options.tag"
            },
            {
              "value": "none",
              "label": "t:sections.announcement_bar.blocks.message.settings.icon.options.none"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name",
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  ]
}
{% endschema %}
