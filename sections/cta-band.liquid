{%- liquid
  assign scheme = section.settings.color_scheme
  assign scheme_class = 'color-' | append: scheme.id
  assign full_width = section.settings.full_width
  assign icon_name = section.settings.icon

  assign on_dark = false
  if scheme.settings.background.lightness < 50
    assign on_dark = true
  endif

  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = 'home.cta_band.heading' | t
  endif

  assign text = section.settings.text
  if text == blank
    assign text = 'home.cta_band.text' | t
  endif

  # Button: the owner's link, else a WhatsApp chat (Theme settings > Business details) with a prefilled
  # message, else no button at all.
  assign button_link = section.settings.button_link
  assign is_whatsapp = false
  if button_link == blank
    capture whatsapp_digits
      render 'whatsapp-digits'
    endcapture
    if whatsapp_digits != blank
      assign whatsapp_message = 'home.cta_band.whatsapp_message' | t | url_encode | replace: '+', '%20'
      assign button_link = 'https://wa.me/' | append: whatsapp_digits | append: '?text=' | append: whatsapp_message
      assign is_whatsapp = true
    endif
  endif

  assign button_label = section.settings.button_label | escape
  if button_label == blank
    if is_whatsapp
      assign button_label = 'home.cta_band.whatsapp_label' | t
    else
      assign button_label = 'home.cta_band.button_label' | t
    endif
  endif
-%}

<div
  class="section cta-band{% if full_width %} cta-band--full {{ scheme_class }}{% endif %}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="cta-band__panel{% unless full_width %} {{ scheme_class }}{% endunless %}{% if on_dark %} cta-band__panel--on-dark{% endif %}{% if icon_name == 'none' %} cta-band__panel--no-icon{% endif %}">
      {%- unless icon_name == 'none' -%}
        {%- render 'icon', name: icon_name, size: 30, class: 'cta-band__icon' -%}
      {%- endunless -%}
      <h2 class="cta-band__heading display-l">{{ heading }}</h2>
      <p class="cta-band__text">{{ text }}</p>
      {%- if button_link != blank -%}
        <a
          class="button button--primary cta-band__button"
          href="{{ button_link }}"
          {% if is_whatsapp %}
            target="_blank" rel="noopener"
          {% endif %}
        >
          {{- button_label -}}
          {%- if is_whatsapp -%}
            <span class="visually-hidden"> ({{ 'accessibility.new_window' | t }})</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  /* Accent is text only on dark schemes. Declared on the panel, where the scheme's variables resolve. */
  .cta-band__panel {
    --cta-accent: currentColor;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'icon' 'heading' 'text' 'button';
    justify-items: start;
    row-gap: 10px;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-card);
  }

  .cta-band__panel--on-dark {
    --cta-accent: var(--color-highlight);
  }

  .cta-band__panel--no-icon {
    grid-template-areas: 'heading' 'text' 'button';
  }

  .cta-band--full .cta-band__panel {
    padding-inline: 0;
    border-radius: 0;
  }

  .cta-band__icon {
    grid-area: icon;
    color: var(--cta-accent);
  }

  .cta-band__heading {
    grid-area: heading;
    overflow-wrap: break-word;

    @media screen and (max-width: 749px) {
      font-size: var(--display-m);
    }
  }

  .cta-band__text {
    grid-area: text;
    max-inline-size: 40em;
    color: var(--color-muted);
    font-size: var(--text-md);
  }

  .cta-band__button {
    grid-area: button;
    justify-self: stretch;
    margin-block-start: 6px;
  }

  @media screen and (min-width: 750px) {
    .cta-band__panel {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'icon heading button' 'icon text button';
      align-items: center;
      column-gap: var(--space-8);
      row-gap: var(--space-2);
      padding: var(--space-10) var(--space-12);
    }

    .cta-band__panel--no-icon {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'heading button' 'text button';
    }

    .cta-band__icon {
      inline-size: 48px;
      block-size: 48px;
    }

    .cta-band__heading {
      align-self: end;
    }

    .cta-band__text {
      align-self: start;
      font-size: var(--text-base);
    }

    .cta-band__button {
      justify-self: end;
      min-inline-size: 240px;
      margin-block-start: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.cta_band.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-night"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width",
      "default": false
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:sections.cta_band.settings.icon.label",
      "default": "chat",
      "options": [
        {
          "value": "chat",
          "label": "t:sections.cta_band.settings.icon.options.chat"
        },
        {
          "value": "users",
          "label": "t:sections.cta_band.settings.icon.options.users"
        },
        {
          "value": "shirt",
          "label": "t:sections.cta_band.settings.icon.options.shirt"
        },
        {
          "value": "whatsapp",
          "label": "t:sections.cta_band.settings.icon.options.whatsapp"
        },
        {
          "value": "none",
          "label": "t:sections.cta_band.settings.icon.options.none"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.button_link",
      "info": "t:sections.cta_band.settings.button_link.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:sections.cta_band.presets.name"
    }
  ]
}
{% endschema %}
