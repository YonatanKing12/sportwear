{%- comment -%}
  Kids sizes: a compact strip with the kids' sizes by age and each size's approximate height, plus
  links to the kids collection and to the size guide. Each tile is a "size" block (label + height in cm).
  Phones stack everything, tablets put the text and links on one row above the tiles, and desktop puts
  all three on one row.
{%- endcomment -%}
{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme.id

  assign eyebrow = section.settings.eyebrow | escape
  if eyebrow == blank
    assign eyebrow = 'home.kids_sizes.eyebrow' | t
  endif

  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = 'home.kids_sizes.heading' | t
  endif

  assign text = section.settings.text | escape
  if text == blank
    assign text = 'home.kids_sizes.text' | t
  endif

  # An empty link goes to the "kids" collection once it exists, and to all products until then.
  assign button_label = section.settings.button_label | escape
  if button_label == blank
    assign button_label = 'home.kids_sizes.button_label' | t
  endif
  assign button_link = section.settings.button_link
  if button_link == blank
    assign button_link = collections.kids.url
  endif
  if button_link == blank
    assign button_link = routes.all_products_collection_url
  endif

  # An empty link opens the kids' tab of the "size-guide" page (#size-guide-kids); without that page
  # the link is hidden.
  assign secondary_label = section.settings.secondary_label | escape
  if secondary_label == blank
    assign secondary_label = 'home.kids_sizes.secondary_label' | t
  endif
  assign secondary_link = section.settings.secondary_link
  if secondary_link == blank
    assign size_guide_url = pages['size-guide'].url
    if size_guide_url != blank
      assign secondary_link = size_guide_url | append: '#size-guide-kids'
    endif
  endif

  # A tile without a size label is skipped, except in the theme editor, where it stays selectable.
  assign tile_count = 0
  for block in section.blocks
    if block.settings.label != blank or request.design_mode
      assign tile_count = tile_count | plus: 1
    endif
  endfor
-%}

<div
  class="section kids-sizes"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div
      class="kids-sizes__panel {{ scheme_class }}{% if secondary_link != blank %} kids-sizes__panel--guide{% endif %}"
      style="--kids-sizes-count: {{ tile_count }};"
    >
      <div class="kids-sizes__intro">
        {%- if section.settings.show_eyebrow -%}
          <p class="kids-sizes__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        <h2 class="kids-sizes__heading display-s">{{ heading }}</h2>
        <p class="kids-sizes__text">{{ text }}</p>
      </div>

      {%- if tile_count > 0 -%}
        <ul class="kids-sizes__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank or request.design_mode -%}
              {%- liquid
                assign size_label = block.settings.label | strip | escape
                # "Years" agrees with the label's last number (Arabic: 5-6 سنوات, but 11-12 سنة).
                assign age = size_label | replace: '–', '-' | split: '-' | last | strip | plus: 0
                assign height = block.settings.height
              -%}
              <li class="kids-sizes__tile" {{ block.shopify_attributes }}>
                <span class="kids-sizes__age">
                  <span class="kids-sizes__size"
                    ><bdi>{{ size_label | default: '–' }}</bdi></span
                  >
                  {%- if age > 0 -%}
                    <span class="kids-sizes__years">{{ 'home.kids_sizes.years' | t: count: age }}</span>
                  {%- endif -%}
                </span>
                {%- if height != blank -%}
                  <span class="kids-sizes__height">
                    <span class="visually-hidden">{{ 'home.kids_sizes.height_label' | t }}</span>
                    <bdi>{{ height }}</bdi>
                    {{ 'home.kids_sizes.height_unit' | t -}}
                  </span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="kids-sizes__actions">
        <a class="button button--primary kids-sizes__button" href="{{ button_link }}">{{ button_label }}</a>
        {%- if secondary_link != blank -%}
          <a class="link kids-sizes__guide" href="{{ secondary_link }}">
            {%- render 'icon', name: 'ruler', size: 18 -%}
            <span>{{ secondary_label }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .kids-sizes__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'intro' 'sizes' 'actions';
    row-gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  /* Phones: the size-guide link's 44px target already leaves room under its text (the rest keeps its
     focus ring clear of the panel's clipped edge). */
  .kids-sizes__panel--guide {
    padding-block-end: var(--space-2);
  }

  .kids-sizes__intro {
    grid-area: intro;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  .kids-sizes__eyebrow {
    display: inline-flex;
    align-items: center;
    min-block-size: 24px;
    padding-inline: 10px;
    border-radius: var(--radius-chip);
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    font-size: var(--text-xs);
    font-weight: 800;
    line-height: 1.2;
  }

  .kids-sizes__heading {
    max-inline-size: 100%;
    overflow-wrap: break-word;
  }

  .kids-sizes__text {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* Equal columns that always fit the row (no sideways scrolling). Each tile is a size container, so
     its numbers scale with the tile's own width. */
  .kids-sizes__list {
    grid-area: sizes;
    display: grid;
    grid-template-columns: repeat(var(--kids-sizes-count, 5), minmax(0, 1fr));
    gap: 6px;
  }

  /* The age sits at the top and the height row at the bottom, so height rows line up across tiles
     even when a tile has no "years" line. */
  .kids-sizes__tile {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-inline-size: 0;
    padding: 10px 2px 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .kids-sizes__age {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block-end: var(--space-2);
  }

  .kids-sizes__size {
    --kids-sizes-size-max: 24px;
    font-family: var(--font-display);
    font-size: clamp(15px, 32cqi, var(--kids-sizes-size-max));
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .kids-sizes__years {
    margin-block-start: 2px;
    font-size: clamp(10px, 18cqi, 12.5px);
    font-weight: 700;
    line-height: 1.3;
  }

  .kids-sizes__height {
    padding-block: 5px 6px;
    border-block-start: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: clamp(10px, 19cqi, 13px);
    font-weight: 600;
    line-height: 1.3;
  }

  /* The gap keeps the link's focus ring off the dark button. */
  .kids-sizes__actions {
    grid-area: actions;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
  }

  .kids-sizes__guide {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    align-self: center;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-2);
    font-size: var(--text-md);
  }

  /* Tablet: the text and links on one row, the tiles on a second row. */
  @media screen and (min-width: 750px) {
    .kids-sizes__panel {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'intro actions' 'sizes sizes';
      align-items: center;
      column-gap: var(--space-8);
      row-gap: var(--space-5);
      padding: var(--space-6) var(--space-8);
    }

    .kids-sizes__text {
      font-size: var(--text-md);
    }

    .kids-sizes__list {
      gap: var(--space-2);
    }

    .kids-sizes__size {
      --kids-sizes-size-max: 30px;
    }

    .kids-sizes__button {
      min-inline-size: 220px;
    }
  }

  /* Desktop: one row, text on the start side, tiles in the middle, links on the end side. The text
     column is as wide as its text (capped, it wraps below that), the tiles always keep at least 60px
     each, and the tile row is centered in the space between the text and the links. */
  @media screen and (min-width: 990px) {
    .kids-sizes__panel {
      grid-template-columns:
        minmax(0, max-content)
        minmax(calc(var(--kids-sizes-count, 5) * 60px), 1fr)
        max-content;
      grid-template-areas: 'intro sizes actions';
      column-gap: clamp(24px, 2.5vw, 48px);
      padding: var(--space-8) clamp(32px, 3vw, 48px);
    }

    .kids-sizes__intro {
      max-inline-size: 400px;
    }

    /* Grows from the small display size at 990px to 45px at 1440px, so it leads the tile numbers
       while the longer Arabic heading still fits on one line next to the tiles. */
    .kids-sizes .kids-sizes__heading {
      font-size: calc(clamp(30px, 8px + 2.55vw, 45px) * var(--heading-scale, 1) * var(--display-lang-scale));
    }

    .kids-sizes__list {
      justify-self: center;
      inline-size: 100%;
      max-inline-size: calc(var(--kids-sizes-count, 5) * 112px);
      gap: clamp(8px, 0.7vw, 10px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.kids_sizes.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-soft"
    },
    {
      "type": "header",
      "content": "t:sections.kids_sizes.headers.content"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "t:sections.kids_sizes.settings.show_eyebrow.label",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "info": "t:settings.default_text_info",
      "visible_if": "{{ section.settings.show_eyebrow }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "header",
      "content": "t:sections.kids_sizes.headers.links"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.button_link",
      "info": "t:sections.kids_sizes.settings.button_link.info"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.kids_sizes.settings.secondary_label.label",
      "info": "t:settings.default_text_info"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:sections.kids_sizes.settings.secondary_link.label",
      "info": "t:sections.kids_sizes.settings.secondary_link.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "t:sections.kids_sizes.blocks.size.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.kids_sizes.blocks.size.settings.label.label",
          "info": "t:sections.kids_sizes.blocks.size.settings.label.info",
          "placeholder": "9-10"
        },
        {
          "type": "number",
          "id": "height",
          "label": "t:sections.kids_sizes.blocks.size.settings.height.label",
          "info": "t:sections.kids_sizes.blocks.size.settings.height.info",
          "placeholder": "140"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.kids_sizes.name",
      "blocks": [
        {
          "type": "size",
          "settings": {
            "label": "5-6",
            "height": 116
          }
        },
        {
          "type": "size",
          "settings": {
            "label": "7-8",
            "height": 128
          }
        },
        {
          "type": "size",
          "settings": {
            "label": "9-10",
            "height": 140
          }
        },
        {
          "type": "size",
          "settings": {
            "label": "11-12",
            "height": 152
          }
        },
        {
          "type": "size",
          "settings": {
            "label": "13-14",
            "height": 164
          }
        }
      ]
    }
  ]
}
{% endschema %}
