{%- doc -%}
  Button, used as a static block.

  @param {string} [label] - Label passed by the parent through content_for 'block'
{%- enddoc -%}
{%- assign button_label = label | default: block.settings.label -%}
<a
  class="smoke-button"
  href="{{ block.settings.link | default: routes.all_products_collection_url }}"
  {{ block.shopify_attributes }}
>
  {{- button_label -}}
</a>

{% schema %}
{
  "name": "Button",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Button" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
