    "social": {
      "name": "Social media",
      "settings": {
        "instagram": {
          "label": "Instagram"
        },
        "tiktok": {
          "label": "TikTok"
        },
        "facebook": {
          "label": "Facebook"
        },
        "youtube": {
          "label": "YouTube"
        }
      }
    },
    "search": {
      "name": "Search",
      "settings": {
        "predictive_search": {
          "label": "Show suggestions while typing"
        }
      }
    }
