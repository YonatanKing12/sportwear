            "team": "Team",
            "vendor": "Brand",
            "none": "None"
          }
        },
        "card_image_ratio": {
          "label": "Image shape",
          "options": {
            "square": "Square",
            "portrait": "Portrait (4:5)",
            "tall": "Tall (3:4)"
          }
        },
        "card_image_fit": {
          "label": "Image fit",
          "info": "\"Fit\" shows the whole product on a light background. \"Fill\" crops to fill the tile.",
          "options": {
            "contain": "Fit",
            "cover": "Fill"
          }
        },
        "card_secondary_image": {
          "label": "Show second image on hover"
        },
        "card_show_sale_badge": {
          "label": "Show sale badge"
        },
        "card_new_tag": {
          "label": "Tag for the \"New\" badge",
          "info": "Products with this tag get the \"New\" badge."
        }
      }
    },
    "cart": {
      "name": "Cart",
      "settings": {
        "cart_type": {
          "label": "Cart type",
          "options": {
            "drawer": "Drawer",
            "page": "Page"
          }
        },
