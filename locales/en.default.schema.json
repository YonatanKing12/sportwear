        "header_color_scheme": {
          "label": "Header color scheme"
        },
        "upsell_color_scheme": {
          "label": "\"Complete the set\" color scheme"
        },
        "empty_collection": {
          "label": "Empty cart button link",
          "info": "Pick a collection. Leave empty to link to all products."
        }
      }
    },
    "main_cart": {
      "name": "Cart page",
      "settings": {
        "info": {
          "content": "Free shipping, set suggestions and order notes are in Theme settings > Cart."
        },
