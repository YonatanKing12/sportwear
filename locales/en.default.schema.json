            "narrow": "Narrow (1200 px)",
            "normal": "Normal (1440 px)",
            "wide": "Wide (1680 px)"
          }
        },
        "radius_card": {
          "label": "Card corner radius"
        },
        "radius_button": {
          "label": "Button corner radius"
        }
