        },
        "share_image": {
          "label": "Social sharing image",
          "info": "Shown when a page without its own image is shared. 1200 × 628 px recommended."
        }
      }
    },
    "colors": {
      "name": "Colors",
      "settings": {
        "background": {
          "label": "Background"
        },
