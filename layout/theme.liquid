<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.browser_theme_color }}">
    {%- if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif %}

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script type="importmap">
      {
        "imports": {
          "@theme/core": "{{ 'core.js' | asset_url }}"
        }
      }
    </script>
    <link rel="modulepreload" href="{{ 'core.js' | asset_url }}">
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.theme = {
        designMode: {{ request.design_mode | json }},
        cartType: {{ settings.cart_type | json }},
        locale: {{ request.locale.iso_code | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart_url: {{ routes.cart_url | json }},
          cart_add_url: {{ routes.cart_add_url | json }},
          cart_change_url: {{ routes.cart_change_url | json }},
          cart_update_url: {{ routes.cart_update_url | json }},
          search_url: {{ routes.search_url | json }},
          predictive_search_url: {{ routes.predictive_search_url | json }}
        },
        strings: {
          cartError: {{ 'general.errors.cart' | t | json }},
          genericError: {{ 'general.errors.generic' | t | json }},
          addedToCart: {{ 'general.cart.added' | t | json }}
        }
      };
    </script>
    <script type="module" src="{{ 'core.js' | asset_url }}"></script>

    {{ content_for_header }}
  </head>

  <body class="color-{{ settings.body_color_scheme.id }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <div id="SwLiveRegion" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>
