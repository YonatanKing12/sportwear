      "new": { "background": "#0D0E11", "text": "accent" },
      "sale": { "background": "#FF5A36", "text": "#0D0E11" },
      "original": { "background": "#0D0E11", "text": "accent" }
    }
  },
  "typography": {
    "display": {
      "stack": "'Anton', 'Karantina', 'Changa', sans-serif",
      "faces": {
        "latin": { "family": "Anton", "weights": [400] },
