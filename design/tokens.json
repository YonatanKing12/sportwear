        "button_secondary": { "border": "#F4F5F7", "text": "#F4F5F7" },
        "sale_text": "#FF5A36"
      },
      "day": {
        "role": "Where people shop and read: product grids, product page body, cart body, content pages",
        "background": "#FFFFFF",
        "surface": "#F1F2F4",
        "surface_2": "#F6F7F8",
        "line": "#E3E5E8",
