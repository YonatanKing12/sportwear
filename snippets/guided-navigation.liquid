{%- doc -%}
  Shared focused navigation for header panels and collection entry pages. Collection objects keep
  titles/URLs localized. The full existing menu directory is available on demand on hub pages.

  @param {string} kind - football, basketball, nfl, kids or all
  @param {string} [mode] - page enables the complete directory; menu shows only starting choices
{%- enddoc -%}
{%- liquid
  assign team_handles = ''
  assign type_handles = 'football,basketball,basketball-shorts,nfl,kids'
  case kind
    when 'football'
      assign team_handles = 'real-madrid,barcelona,arsenal,manchester-city,manchester-united,paris-saint-germain'
      assign type_handles = 'national-teams,kids-football,israeli-premier-league'
    when 'basketball'
      assign team_handles = 'los-angeles-lakers,chicago-bulls,golden-state-warriors,boston-celtics,dallas-mavericks,miami-heat'
      assign type_handles = 'basketball-shorts,kids-basketball,retro,city-edition,college-and-wnba'
    when 'players'
      assign team_handles = 'kobe-bryant,michael-jordan,lebron-james,stephen-curry,luka-doncic,shaquille-oneal'
      assign type_handles = 'basketball,kids-basketball,retro,city-edition'
    when 'nfl'
      assign team_handles = 'kansas-city-chiefs,dallas-cowboys,san-francisco-49ers,philadelphia-eagles,las-vegas-raiders,baltimore-ravens'
      assign type_handles = 'nfl-jerseys-kids,nfl-hoodies-men,nfl-hoodies-women,nfl-hoodies-kids'
    when 'kids'
      assign type_handles = 'kids-football,kids-basketball,nfl-jerseys-kids,nfl-hoodies-kids'
  endcase
  assign teams = team_handles | split: ','
  assign types = type_handles | split: ','
  assign root_link = blank
  assign root_handle = kind
  if kind == 'players'
    assign root_handle = 'basketball'
  endif
  for candidate in linklists['main-menu'].links
    if candidate.object.handle == root_handle
      assign root_link = candidate
      break
    endif
  endfor
-%}
<div class="guided-nav{% if mode == 'page' %} guided-nav--page{% endif %}">
  {%- if team_handles != blank -%}
    <div class="guided-nav__group">
      <p class="guided-nav__label">
        {% if kind == 'players' -%}
          {{- 'navigation.guide.by_player' | t -}}
        {%- else -%}
          {{- 'navigation.guide.by_team' | t -}}
        {%- endif %}
      </p>
      <ul class="guided-nav__choices guided-nav__teams" role="list">
        {%- for handle in teams -%}
          {%- assign target = collections[handle] -%}
          {%- if target != blank and target.all_products_count > 0 -%}
            <li>
              {% render 'guided-team-strip', handle: handle, target: target, kind: kind %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
  <div class="guided-nav__group">
    <p class="guided-nav__label">{{ 'navigation.guide.by_type' | t }}</p>
    <ul class="guided-nav__choices" role="list">
      {%- for handle in types -%}
        {%- assign target = collections[handle] -%}
        {%- if target != blank and target.all_products_count > 0 -%}
          <li>
            <a class="guided-nav__choice" href="{{ target.url }}">
              {{- target.title | escape }}
              {%- render 'icon', name: 'chevron-forward', size: 16 -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
  {%- if mode == 'page' and root_link.links.size > 0 and team_handles != blank -%}
    <details class="guided-nav__directory">
      <summary>
        {{ 'navigation.guide.directory' | t }}
        {%- render 'icon', name: 'plus', size: 18 -%}
      </summary>
      <div class="guided-nav__directory-grid">
        {%- for child in root_link.links -%}
          {%- if child.links.size > 0 -%}
            <details>
              <summary>
                {{ child.title | escape }}
                {%- render 'icon', name: 'chevron-down', size: 16 -%}
              </summary>
              <ul role="list">
                {%- for item in child.links -%}
                  {%- if item.type != 'collection_link' or item.object.all_products_count > 0 -%}
                    <li>
                      <a href="{{ item.object.url | default: item.url }}">{{ item.title | escape }}</a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </details>
          {%- elsif child.object.all_products_count > 0 -%}
            <a class="guided-nav__choice" href="{{ child.object.url | default: child.url }}">
              {{- child.title | escape -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </details>
  {%- elsif mode != 'page' and root_link != blank -%}
    <a class="guided-nav__more" href="{{ root_link.object.url | default: root_link.url }}">
      {{- 'navigation.guide.more_choices' | t }}
      {%- render 'icon', name: 'arrow-forward', size: 18 -%}
    </a>
  {%- endif -%}
  {%- assign picks = collections['our-picks'] -%}
  {%- if picks != blank and picks.all_products_count > 0 -%}
    <a class="guided-nav__recommend" href="{{ picks.url }}"
      ><strong>{{ 'navigation.guide.not_sure' | t }}</strong
      ><span>
        {{- 'navigation.guide.picks' | t }}
        {%- render 'icon', name: 'arrow-forward', size: 18 -%}
      </span></a
    >
  {%- endif -%}
</div>
{% stylesheet %}
  .guided-nav__team-card {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 16px;
    min-block-size: 76px;
    padding: 10px 18px;
    overflow: hidden;
    border: 1px solid var(--team-accent);
    border-inline-start: 4px solid var(--team-accent);
    border-radius: 8px;
    background: var(--team-color);
    color: #fff;
    text-decoration: none;
  }
  .guided-nav__team-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      repeating-linear-gradient(115deg, transparent 0 22px, rgb(255 255 255 / 5%) 22px 24px),
      linear-gradient(100deg, transparent 35%, rgb(255 255 255 / 10%));
    pointer-events: none;
  }
  .guided-nav__team-image {
    inline-size: 56px;
    block-size: 56px;
    flex: 0 0 56px;
    object-fit: contain;
    filter: drop-shadow(0 3px 5px rgb(0 0 0 / 25%));
  }
  .guided-nav__team-name {
    flex: 1;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.35;
  }
  .guided-nav__team-card > .icon {
    flex-shrink: 0;
    color: var(--team-accent);
  }
  .guided-nav__player-mark {
    font-size: 20px;
    font-style: italic;
    font-weight: 900;
    color: var(--team-accent);
  }
  .guided-nav__team-card:hover {
    box-shadow: inset 0 0 0 1px var(--team-accent);
  }
  @media (max-width: 749px) {
    .guided-nav__teams li:nth-child(n + 5) {
      display: none;
    }
  }

  .guided-nav {
    display: grid;
    gap: 24px;
  }
  .guided-nav__label {
    margin-block-end: 10px;
    font-weight: 800;
    font-size: 14px;
  }
  .guided-nav__choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .guided-nav__choices.guided-nav__teams {
    grid-template-columns: minmax(0, 1fr);
  }
  .guided-nav__choice {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-block-size: 48px;
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    background: var(--color-background);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
  .guided-nav__choice:hover {
    border-color: currentColor;
    background: var(--color-surface);
  }
  .guided-nav__choice .icon {
    flex-shrink: 0;
  }
  .guided-nav__more {
    display: flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    font-weight: 700;
    color: inherit;
  }
  .guided-nav__recommend {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border-radius: 6px;
    background: #0d0e11;
    color: #f4f5f7;
    text-decoration: none;
  }
  .guided-nav__recommend span {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-accent);
    font-size: 14px;
  }
  .guided-nav__directory {
    grid-column: 1 / -1;
    border-block-start: 1px solid var(--color-border);
  }
  .guided-nav__directory summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-block: 14px;
    min-block-size: 48px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .guided-nav__directory summary::-webkit-details-marker {
    display: none;
  }
  .guided-nav__directory-grid {
    display: grid;
    gap: 8px 24px;
  }
  .guided-nav__directory ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .guided-nav__directory li a {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    color: inherit;
  }
  .guided-hub {
    padding-block: 28px 40px;
  }
  .guided-hub__header {
    max-inline-size: 44rem;
    margin-block-end: 28px;
  }
  .guided-hub__header p {
    margin-block-start: 12px;
    color: var(--color-muted);
  }
  .guided-hub__back {
    display: inline-flex;
    min-block-size: 44px;
    align-items: center;
    margin-block-end: 8px;
    color: inherit;
  }
  .guided-hub__catalog {
    margin-block-start: 28px;
    font-size: 14px;
  }
  .guided-hub__catalog summary {
    cursor: pointer;
    min-block-size: 44px;
    display: flex;
    align-items: center;
    color: var(--color-muted);
  }
  .guided-hub__catalog a {
    display: inline-flex;
    min-block-size: 44px;
    align-items: center;
    color: inherit;
  }
  .menu-drawer__guided {
    padding: 16px;
  }
  .menu-drawer__start {
    padding: 16px;
    border-block-end: 1px solid var(--color-border);
  }
  .menu-drawer__start p {
    font-size: 14px;
    color: var(--color-muted);
    margin-block-end: 8px;
  }
  .menu-drawer__start a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: inherit;
    font-weight: 700;
  }
  @media (min-width: 750px) {
    .guided-nav--page {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .guided-nav--page > .guided-nav__recommend {
      grid-column: 1 / -1;
    }
    .guided-nav__directory-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .header-mega .guided-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .header-mega .guided-nav__more {
      align-self: start;
    }
  }
{% endstylesheet %}
