{%- doc -%}
  One product of a "complete the set" block (sections/promo-banner.liquid): its role ("Jersey"), its
  title as a link, its price and a size choice. The size radios post the variant id as
  items[<index>][id] with the set's cart form, so the set also works without JavaScript; sold-out sizes
  stay visible but are disabled, struck through and announced as sold out. The shorts (index 1) have a
  note that assets/set-builder.js fills when it picks the jersey's size for them too.

  @param {product} product - The product
  @param {number} index - 0 for the jersey, 1 for the shorts (the cart form's items index)
  @param {string} role - The visible role label, e.g. "Jersey"
  @param {string} legend - The size group's name, e.g. "Jersey size"
  @param {string} id_prefix - Unique prefix for the input ids
  @param {string} [note_template] - The shorts note, with [size] where the size goes

  @example
  {% render 'set-item', product: jersey, index: 0, role: jersey_label, legend: jersey_legend, id_prefix: 'Set-abc-0' %}
{%- enddoc -%}
<div class="set-item" data-set-item="{{ index }}">
  <div class="set-item__head">
    <p class="set-item__role">{{ role }}</p>
    <a class="set-item__title" href="{{ product.url }}">{% render 'product-title', title: product.title %}</a>
    {%- render 'price', product: product, class: 'set-item__price' -%}
  </div>
  <fieldset class="set-item__sizes">
    <legend class="visually-hidden">{{ legend }}</legend>
    {%- for variant in product.variants -%}
      {%- capture input_id -%}{{ id_prefix }}-{{ forloop.index }}{%- endcapture -%}
      <input
        type="radio"
        class="set-item__input visually-hidden"
        id="{{ input_id }}"
        name="items[{{ index }}][id]"
        value="{{ variant.id }}"
        data-size="{{ variant.option1 | escape }}"
        autocomplete="off"
        {% if forloop.first %}
          required
        {% endif %}
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
      <label
        class="set-item__size{% unless variant.available %} set-item__size--unavailable{% endunless %}"
        for="{{ input_id }}"
      >
        <bdi dir="ltr">{{ variant.option1 | escape }}</bdi>
        {%- unless variant.available -%}
          <span class="visually-hidden">, {{ 'products.variant_picker.sold_out' | t }}</span>
        {%- endunless -%}
      </label>
    {%- endfor -%}
  </fieldset>
  <input type="hidden" name="items[{{ index }}][quantity]" value="1">
  {%- if note_template != blank -%}
    <p class="set-item__note" data-set-note data-template="{{ note_template | escape }}" hidden></p>
  {%- endif -%}
</div>

{% stylesheet %}
  .set-item {
    display: grid;
    gap: var(--space-2);
  }

  /* Role over the title and the price: the title keeps to two lines, the price to the end of the first. */
  .set-item__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: var(--space-3);
  }

  .set-item__role {
    grid-column: 1 / -1;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .set-item__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    color: inherit;
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .set-item__price {
    font-size: var(--text-md);
    font-weight: 800;
    white-space: nowrap;
  }

  .set-item__sizes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .set-item__size {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--touch-target);
    border: 1.5px solid color-mix(in srgb, var(--color-text) 18%, var(--color-background));
    border-radius: var(--radius-button);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: 800;
    line-height: 1.1;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);

    &:hover {
      border-color: var(--color-text);
    }
  }

  .set-item__input:checked + .set-item__size {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-background);
  }

  .set-item__input:focus-visible + .set-item__size {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .set-item__size--unavailable {
    color: var(--color-muted);
    text-decoration: line-through;
    cursor: not-allowed;

    &:hover {
      border-color: color-mix(in srgb, var(--color-text) 18%, var(--color-background));
    }
  }

  .set-item__note {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }
{% endstylesheet %}
