{%- doc -%}
  Prints the WhatsApp number from theme settings as the digits wa.me expects: no +, spaces, dashes,
  dots or brackets, and an Israeli local number (050…) turned into international form (97250…).
  Capture it: {% capture whatsapp_digits %}{% render 'whatsapp-digits' %}{% endcapture %}
{%- enddoc -%}
{%- liquid
  assign digits = settings.whatsapp_number | strip | remove: '+' | remove: ' ' | remove: '-' | remove: '.' | remove: '(' | remove: ')'
  assign first_digit = digits | slice: 0
  if first_digit == '0'
    assign local_part = digits | slice: 1, 20
    assign digits = '972' | append: local_part
  endif
  echo digits
-%}
