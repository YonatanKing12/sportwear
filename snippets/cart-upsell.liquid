{%- doc -%}
  "Complete the set" for the cart drawer and the cart page: up to two products from the
  sportwear.complements metafield of the products in the cart (for example the shorts that match a
  basketball jersey), skipping products that are already in the cart or sold out. The size of the
  cart line is preselected when the suggestion has it in stock. Each suggestion is a real product
  form, so it works without JavaScript; assets/cart.js adds it through CartAPI and re-renders.
  When adding the cheapest variant would reach the free-shipping threshold, the card says so.

  @param {object} cart - The cart object
  @param {string} id_prefix - Unique prefix for element ids, e.g. 'CartDrawer' or 'MainCart'
  @param {string} [heading_tag] - Heading element for the panel title: 'h2' or 'h3' (default 'h3')
  @param {string} [color_scheme] - Color scheme id for the panel (default 'scheme-accent')

  @example
  {% render 'cart-upsell', cart: cart, id_prefix: 'CartDrawer', color_scheme: section.settings.upsell_color_scheme.id %}
{%- enddoc -%}
{%- liquid
  assign upsell_heading = heading_tag | default: 'h3'
  assign upsell_scheme = color_scheme | default: 'scheme-accent'
  assign max_suggestions = 2
  assign suggestion_count = 0
  assign in_cart_ids = cart.items | map: 'product_id' | join: ','
  assign in_cart_ids = ',' | append: in_cart_ids | append: ','
  assign shown_ids = ','

  capture threshold_cents
    render 'free-shipping-cents'
  endcapture
  assign threshold_cents = threshold_cents | plus: 0
  assign check_free_shipping = false
  if threshold_cents > 0 and cart.total_price < threshold_cents
    assign check_free_shipping = true
  endif
-%}
{%- capture suggestions -%}
  {%- for item in cart.items -%}
    {%- if suggestion_count >= max_suggestions -%}
      {%- break -%}
    {%- endif -%}
    {%- assign complements = item.product.metafields.sportwear.complements.value -%}
    {%- if complements == blank -%}
      {%- continue -%}
    {%- endif -%}

    {%- for complement in complements -%}
      {%- if suggestion_count >= max_suggestions -%}
        {%- break -%}
      {%- endif -%}
      {%- if complement == blank or complement.available == false -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign needle = ',' | append: complement.id | append: ',' -%}
      {%- if in_cart_ids contains needle or shown_ids contains needle -%}
        {%- continue -%}
      {%- endif -%}

      {%- liquid
        assign shown_ids = shown_ids | append: complement.id | append: ','
        assign suggestion_count = suggestion_count | plus: 1

        assign selected_variant = complement.selected_or_first_available_variant
        for variant in complement.variants
          if variant.available and variant.title == item.variant.title
            assign selected_variant = variant
            break
          endif
        endfor

        assign unlocks_free_shipping = false
        if check_free_shipping
          assign total_with_suggestion = cart.total_price | plus: complement.price
          if total_with_suggestion >= threshold_cents
            assign unlocks_free_shipping = true
          endif
        endif

        assign suggestion_id = id_prefix | append: '-Upsell-' | append: complement.id
        assign name_id = suggestion_id | append: '-Name'
        assign select_id = suggestion_id | append: '-Option'
        assign has_choice = false
        if complement.variants.size > 1
          assign has_choice = true
        endif
      -%}
      <li class="cart-upsell__item{% unless has_choice %} cart-upsell__item--single{% endunless %}">
        <a class="cart-upsell__media media-tile" href="{{ complement.url }}" tabindex="-1" aria-hidden="true">
          {%- render 'image',
            image: complement.featured_media.preview_image,
            sizes: '64px',
            widths: '64, 128, 192',
            alt: ''
          -%}
        </a>

        <div class="cart-upsell__info">
          <p class="cart-upsell__name" id="{{ name_id }}">
            <a class="cart-upsell__link" href="{{ complement.url }}">{{ complement.title | escape }}</a>
          </p>
          <div class="cart-upsell__price">
            {%- render 'price', product: complement, class: 'cart-upsell__amount' -%}
            {%- if unlocks_free_shipping -%}
              <span class="cart-upsell__perk">
                <span aria-hidden="true">·</span>
                {{ 'cart.upsell.unlocks_free_shipping' | t }}
              </span>
            {%- endif -%}
          </div>
        </div>

        {%- form 'product', complement, id: suggestion_id, class: 'cart-upsell__form', data-cart-upsell: 'true' -%}
          <input type="hidden" name="quantity" value="1">
          {%- if has_choice -%}
            {%- liquid
              # The option's name in the shopper's language, already escaped (as the title is): hence the
              # _html key.
              capture option_name
                render 'option-name', name: complement.options.first
              endcapture
              assign complement_title = complement.title | escape
            -%}
            <label class="visually-hidden" for="{{ select_id }}">
              {{- 'cart.upsell.option_label_html' | t: option: option_name, title: complement_title -}}
            </label>
            <select
              class="field__select cart-upsell__select"
              id="{{ select_id }}"
              name="id"
              data-cart-focus="upsell-{{ complement.id }}:option"
            >
              {%- for variant in complement.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant.id == selected_variant.id %}
                    selected
                  {% endif %}
                  {% unless variant.available %}
                    disabled
                  {% endunless %}
                >
                  {{- variant.title | escape -}}
                  {%- unless variant.available %} – {{ 'general.badges.sold_out' | t }}{% endunless -%}
                </option>
              {%- endfor -%}
            </select>
          {%- else -%}
            <input type="hidden" name="id" value="{{ selected_variant.id }}">
          {%- endif -%}
          <button
            type="submit"
            class="button button--primary button--small cart-upsell__add"
            aria-describedby="{{ name_id }}"
            data-cart-focus="upsell-{{ complement.id }}:add"
          >
            <span class="cart-upsell__add-label">{{ 'cart.upsell.add' | t }}</span>
            <span class="spinner cart-upsell__spinner" aria-hidden="true"></span>
          </button>
        {%- endform -%}
        <p class="cart-upsell__error" data-cart-upsell-error hidden></p>
      </li>
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if suggestion_count > 0 -%}
  <section class="cart-upsell color-{{ upsell_scheme }}" aria-labelledby="{{ id_prefix }}-UpsellHeading">
    <{{ upsell_heading }} class="cart-upsell__heading" id="{{ id_prefix }}-UpsellHeading">
      {{- 'cart.upsell.heading' | t -}}
    </{{ upsell_heading }}>
    <ul class="cart-upsell__list" role="list">
      {{- suggestions -}}
    </ul>
  </section>
{%- endif -%}
