{%- doc -%}
  Category tile for the desktop mega panels and the mobile menu drawer: a light image tile for one
  menu link, its title under it and, for a collection, its product count. The image is the
  collection's featured image (its own image, or else its first product's), shown whole
  (object-fit: contain) because these are product shots; the title next to it names it, so the
  image is decorative (alt=""). A link without an image shows its title in the display font instead.

  @param {link} link - The menu link
  @param {string} sizes - The sizes attribute for the image, matching the tile's rendered width
  @param {string} [class] - Extra classes for the tile

  @example
  {% render 'header-tile', link: child, sizes: '(min-width: 1200px) 188px, 150px' %}
{%- enddoc -%}
{%- liquid
  assign tile_image = null
  assign tile_count = 0
  case link.type
    when 'collection_link'
      assign tile_image = link.object.featured_image
      assign tile_count = link.object.all_products_count
    when 'product_link'
      assign tile_image = link.object.featured_media.preview_image
  endcase
-%}
<a
  class="header-tile{% if class != blank %} {{ class }}{% endif %}"
  href="{{ link.url }}"
  {% if link.current %}
    aria-current="page"
  {% endif %}
>
  <span class="header-tile__media">
    {%- if tile_image -%}
      {%- render 'image',
        image: tile_image,
        sizes: sizes,
        widths: '150, 190, 300, 380, 480, 570',
        alt: '',
        class: 'header-tile__image'
      -%}
    {%- else -%}
      <span class="header-tile__monogram" aria-hidden="true">{{ link.title | escape }}</span>
    {%- endif -%}
  </span>
  <span class="header-tile__name">{{ link.title | escape }}</span>
  {%- if tile_count > 0 -%}
    <span class="header-tile__count">
      <span class="visually-hidden">, </span>
      {{- 'header.mega.product_count' | t: count: tile_count -}}
    </span>
  {%- endif -%}
</a>

{% stylesheet %}
  .header-tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-inline-size: 0;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);

    &:focus-visible {
      outline-offset: 4px;
    }
  }

  .header-tile__media {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    aspect-ratio: 1;
    margin-block-end: var(--space-2);
    border-radius: var(--radius-card);
    background: var(--color-tile);
    color: #0d0e11;
    transition: background-color var(--duration) var(--ease);
  }

  .header-tile__image {
    inline-size: 100%;
    block-size: 100%;
    padding: 8%;
    object-fit: contain;
    transition: scale 300ms var(--ease);
  }

  .header-tile__monogram {
    display: -webkit-box;
    overflow: hidden;
    padding: var(--space-3);
    font-family: var(--font-display);
    font-size: calc(28px * var(--heading-scale, 1) * var(--display-lang-scale, 1));
    font-weight: 700;
    line-height: var(--leading-display);
    text-align: center;
    text-wrap: balance;
    opacity: 0.8;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  :lang(en) .header-tile__monogram {
    text-transform: var(--latin-heading-transform, uppercase);
  }

  :lang(ar) .header-tile__monogram {
    line-height: 1.25;
  }

  .header-tile__name {
    font-size: var(--text-md);
    font-weight: 800;
    line-height: 1.3;
    overflow-wrap: anywhere;
    text-underline-offset: 3px;
  }

  .header-tile__count {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .header-tile[aria-current='page'] .header-tile__name {
    text-decoration-line: underline;
  }

  @media (hover: hover) {
    .header-tile:hover .header-tile__media {
      background: color-mix(in srgb, var(--color-tile) 93%, #0d0e11);
    }

    .header-tile:hover .header-tile__name {
      text-decoration-line: underline;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .header-tile:hover .header-tile__image {
      scale: 1.06;
    }
  }
{% endstylesheet %}
