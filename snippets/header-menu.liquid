{%- doc -%}
  Desktop main navigation (990px and up), rendered inside the header. Top-level links sit inline;
  a link with sub-links becomes a disclosure (details/summary, so it works without JavaScript) that
  opens a dropdown, or a full-width panel with one column per sub-link when the menu has a third
  level. assets/header.js keeps one dropdown open at a time and closes it on Escape (focus returns
  to its toggle), on an outside click and when focus leaves it.

  @param {linklist} menu - The menu to show (the header's "Menu" setting)

  @example
  {% render 'header-menu', menu: section.settings.menu %}
{%- enddoc -%}
<nav class="header-menu" aria-label="{{ 'header.menu.nav_label' | t }}">
  <ul class="header-menu__list" role="list">
    {%- for link in menu.links -%}
      {%- liquid
        assign is_mega = false
        if link.levels > 1
          assign is_mega = true
        endif
        assign has_view_all = false
        if link.url != blank and link.url != '#'
          assign has_view_all = true
        endif
      -%}
      <li class="header-menu__item{% if is_mega %} header-menu__item--mega{% endif %}">
        {%- if link.links.size > 0 -%}
          <details class="header-menu__details" name="HeaderMenu">
            <summary class="header-menu__link{% if link.child_active %} header-menu__link--active{% endif %}">
              <span>{{ link.title | escape }}</span>
              {%- render 'icon', name: 'chevron-down', size: 16, class: 'header-menu__chevron' -%}
            </summary>

            {%- if is_mega -%}
              <div class="header-menu__panel header-menu__panel--mega">
                <div class="header-menu__mega page-width">
                  {%- if has_view_all -%}
                    <a class="link-arrow" href="{{ link.url }}">
                      {{- 'general.view_all' | t -}}
                      <span class="visually-hidden">: {{ link.title | escape }}</span>
                      {%- render 'icon', name: 'arrow-forward', size: 18 -%}
                    </a>
                  {%- endif -%}
                  <ul class="header-menu__columns" role="list">
                    {%- for child in link.links -%}
                      <li>
                        <a
                          class="header-menu__heading"
                          href="{{ child.url }}"
                          {% if child.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- child.title | escape -}}
                        </a>
                        {%- if child.links.size > 0 -%}
                          <ul class="header-menu__sublist" role="list">
                            {%- for grandchild in child.links -%}
                              <li>
                                <a
                                  class="header-menu__sublink header-menu__sublink--quiet"
                                  href="{{ grandchild.url }}"
                                  {% if grandchild.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{- grandchild.title | escape -}}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- else -%}
              <div class="header-menu__panel">
                <ul class="header-menu__sublist" role="list">
                  {%- if has_view_all -%}
                    <li>
                      <a class="header-menu__sublink header-menu__sublink--strong" href="{{ link.url }}">
                        {{- 'general.view_all' | t -}}
                        <span class="visually-hidden">: {{ link.title | escape }}</span>
                      </a>
                    </li>
                  {%- endif -%}
                  {%- for child in link.links -%}
                    <li>
                      <a
                        class="header-menu__sublink"
                        href="{{ child.url }}"
                        {% if child.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- child.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </details>
        {%- else -%}
          <a
            class="header-menu__link"
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title | escape -}}
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

{% stylesheet %}
  .header-menu__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-menu__item {
    position: relative;
  }

  .header-menu__item--mega {
    position: static;
  }

  .header-menu__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-3);
    border-radius: var(--radius-button);
    color: inherit;
    font-size: calc(15px * var(--body-scale, 1));
    font-weight: 700;
    text-decoration: none;
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
    white-space: nowrap;
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover,
    &[aria-current='page'] {
      text-decoration-line: underline;
    }
  }

  .header-menu__link--active,
  .header-menu__details[open] > .header-menu__link {
    text-decoration-line: underline;
  }

  .header-menu__chevron {
    transition: transform var(--duration-fast) var(--ease);
  }

  .header-menu__details[open] .header-menu__chevron {
    transform: rotate(180deg);
  }

  .header-menu__panel {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-start: 0;
    z-index: 1;
    min-inline-size: 240px;
    max-block-size: min(70vh, 640px);
    overflow-y: auto;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-background);
    color: var(--color-text);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.28);
  }

  .header-menu__panel--mega {
    inset-block-start: 100%;
    inset-inline: 0;
    max-block-size: min(75vh, 720px);
    padding: 0;
    border-inline: 0;
    border-block-end: 0;
    border-radius: 0;
  }

  .header-menu__mega {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-8);
  }

  .header-menu__columns {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-6) var(--space-8);
    inline-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-menu__heading {
    display: flex;
    align-items: center;
    min-block-size: var(--touch-target);
    color: inherit;
    font-size: var(--text-base);
    font-weight: 800;
    text-decoration: none;
    text-underline-offset: 4px;

    &:hover,
    &[aria-current='page'] {
      text-decoration-line: underline;
    }
  }

  .header-menu__sublist {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-menu__sublink {
    display: flex;
    align-items: center;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-3);
    border-radius: var(--radius-button);
    color: inherit;
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
    text-underline-offset: 4px;

    &:hover {
      background: var(--color-surface);
    }

    &[aria-current='page'] {
      text-decoration-line: underline;
    }
  }

  .header-menu__sublink--strong {
    font-weight: 800;
  }

  .header-menu__sublink--quiet {
    padding-inline: 0;
    color: var(--color-muted);
    font-weight: 500;

    &:hover,
    &[aria-current='page'] {
      background: none;
      color: var(--color-text);
      text-decoration-line: underline;
    }
  }
{% endstylesheet %}
