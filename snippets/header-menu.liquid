{%- doc -%}
  Desktop main navigation (1200px and up), rendered inside the header bar. Top-level links fill the
  height of the bar, with an accent indicator for hover, open and the current section; a link to the
  "sale" collection gets the sale color. A link with sub-links is a disclosure (details/summary, so it
  works without JavaScript) that opens a full-width mega panel (snippets/header-mega-panel).
  assets/header.js adds hover intent for mouse users, keeps one panel open at a time and closes it on
  Escape (focus returns to its toggle), on an outside click, when focus leaves it and when the header
  hides.

  @param {linklist} menu - The menu to show (the header's "Menu" setting)
  @param {string} [hidden_links] - Positions of links to leave out, e.g. ',4,1-3,' (see sections/header.liquid)
  @param {string} [mega_scheme] - Color scheme id for the mega panels (default 'scheme-day')
  @param {boolean} [show_featured] - Show the first products of a collection in its panel (default true)
  @param {block[]} [promos] - The header's blocks: a "mega_promo" block shows in the panel of its collection

  @example
  {% render 'header-menu', menu: section.settings.menu, hidden_links: hidden_links, promos: section.blocks %}
{%- enddoc -%}
{%- liquid
  assign hidden = hidden_links | default: ','
  assign panel_scheme = mega_scheme | default: 'scheme-day'
  assign featured = true
  if show_featured == false
    assign featured = false
  endif
-%}
<nav class="header-menu" aria-label="{{ 'header.menu.nav_label' | t }}">
  <ul class="header-menu__list" role="list">
    {%- for link in menu.links -%}
      {%- liquid
        assign link_index = forloop.index
        assign link_key = ',' | append: link_index | append: ','

        assign visible_children = 0
        for child in link.links
          assign child_key = ',' | append: link_index | append: '-' | append: forloop.index | append: ','
          unless hidden contains child_key
            assign visible_children = visible_children | plus: 1
          endunless
        endfor

        assign link_class = 'header-menu__link'
        if link.active or link.child_active
          assign link_class = link_class | append: ' header-menu__link--active'
        endif
        if link.type == 'collection_link' and link.object.handle == 'sale'
          assign link_class = link_class | append: ' header-menu__link--sale'
        endif

        assign promo = null
        if visible_children > 0 and link.type == 'collection_link'
          for block in promos
            if block.type == 'mega_promo' and block.settings.collection != blank
              if block.settings.collection.handle == link.object.handle
                assign promo = block
                break
              endif
            endif
          endfor
        endif
      -%}
      {%- unless hidden contains link_key -%}
        <li class="header-menu__item">
          {%- if visible_children > 0 -%}
            <details class="header-menu__details" name="HeaderMenu" data-mega>
              <summary class="{{ link_class }}">
                <span>{{ link.title | escape }}</span>
                {%- render 'icon', name: 'chevron-down', size: 14, class: 'header-menu__chevron' -%}
              </summary>
              {%- render 'header-mega-panel',
                link: link,
                link_index: link_index,
                hidden_links: hidden,
                scheme: panel_scheme,
                show_featured: featured,
                promo: promo
              -%}
            </details>
          {%- else -%}
            <a
              class="{{ link_class }}"
              href="{{ link.url }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          {%- endif -%}
        </li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</nav>

{% stylesheet %}
  .header-menu {
    display: flex;
    min-inline-size: 0;
  }

  .header-menu__list {
    display: flex;
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-menu__item {
    display: flex;
    flex-shrink: 0;
  }

  .header-menu__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    min-block-size: var(--header-bar-height, 72px);
    padding-inline: 10px;
    color: inherit;
    font-size: calc(15px * var(--body-scale, 1));
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }

    /* The indicator sits on the bottom edge of the bar, over its border. */
    &::after {
      content: '';
      position: absolute;
      inset-inline: 10px;
      inset-block-end: -1px;
      block-size: 3px;
      border-radius: 3px 3px 0 0;
      background: var(--color-accent);
      scale: 0 1;
      transition: scale var(--duration-fast) var(--ease);
    }

    &:hover::after,
    &[aria-current='page']::after {
      scale: 1 1;
    }

    &:focus-visible {
      outline-offset: -6px;
      border-radius: calc(var(--radius-button) + 4px);
    }

    @media screen and (min-width: 1200px) {
      padding-inline: 12px;

      &::after {
        inset-inline: 12px;
      }
    }

    @media screen and (min-width: 1400px) {
      padding-inline: 14px;
      font-size: calc(16px * var(--body-scale, 1));

      &::after {
        inset-inline: 14px;
      }
    }
  }

  .header-menu__link--active::after,
  .header-menu__details[open] > .header-menu__link::after {
    scale: 1 1;
  }

  .header-menu__link--sale {
    color: var(--color-sale);

    &::after {
      background: currentColor;
    }
  }

  .header-menu__chevron {
    opacity: 0.75;
    transition: rotate var(--duration-fast) var(--ease);
  }

  .header-menu__details[open] .header-menu__chevron {
    rotate: 180deg;
  }
{% endstylesheet %}
