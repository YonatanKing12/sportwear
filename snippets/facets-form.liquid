{%- doc -%}
  The storefront filter form for collection and search results: a GET form that works without
  JavaScript (a submit button shows when JavaScript is off). Every filter from collection.filters or
  search.filters becomes a collapsible group:
  - list and boolean filters: checkboxes with result counts, color swatches or images when the
    filter's presentation asks for them; product option filters (such as size) can show as buttons.
    Values without results are disabled unless selected. Long lists show 10 values and a
    "Show more" toggle.
  - price_range filters: two labelled number inputs in the store currency.
  Names come from snippets/facet-label.liquid (SportWear's own filters in the shopper's language).
  SportWear's filters list their values by name, or in the catalog's order for short lists (kit,
  audience, style, product type); other filters keep Shopify's order. A list filter that cannot narrow
  the results is left out while nothing in it is selected: no value has products, or every value has
  all of them (the team filter on a team's page, availability while everything is in stock).
  The first three groups shown start open. assets/facets.js submits the form on change and moves it
  into the filter drawer on small screens.

  @param {string} section_id - The section id, for unique element ids
  @param {string} form_id - Id of the form element (the sort select points to it)
  @param {string} action - The form action: collection.url or routes.search_url
  @param {filter[]} filters - collection.filters or search.filters
  @param {boolean} show_filters - Render the filter groups (false keeps only the hidden inputs)
  @param {number} [results_count] - Products in the current results; without it only filters with no products at all are left out
  @param {string} [option_style] - 'buttons' (default) or 'checkboxes' for product option filters
  @param {string} [search_terms] - Search terms, kept as a hidden input (search page)
  @param {string} [search_types] - Comma-separated search types (search page)

  @example
  {% render 'facets-form', section_id: section.id, form_id: form_id, action: collection.url, filters: collection.filters, show_filters: true, results_count: collection.products_count %}
{%- enddoc -%}
{%- liquid
  assign visible_limit = 10
  assign currency_symbol = cart.currency.symbol
  assign names = shop.metafields.sportwear.filter_names.value
  assign shown_groups = 0
-%}
<form
  id="{{ form_id }}"
  class="facets-form"
  action="{{ action }}"
  method="get"
  aria-label="{{ 'facets.heading' | t }}"
  data-facets-form
>
  {%- if search_terms != blank -%}
    <input type="hidden" name="q" value="{{ search_terms | escape }}">
    <input type="hidden" name="options[prefix]" value="last">
    {%- if search_types != blank -%}
      <input type="hidden" name="type" value="{{ search_types | escape }}">
    {%- endif -%}
  {%- endif -%}

  {%- if show_filters -%}
    {%- for filter in filters -%}
      {%- liquid
        assign group_index = forloop.index
        assign group_id = 'FacetGroup-' | append: section_id | append: '-' | append: group_index
        assign selected = 0
        if filter.type == 'price_range'
          if filter.min_value.value != null or filter.max_value.value != null
            assign selected = 1
          endif
        else
          assign selected = filter.active_values.size
        endif

        # A list filter earns its place only when choosing one of its values changes the results.
        assign show_group = true
        if filter.type != 'price_range' and selected == 0
          assign narrows = false
          for value in filter.values
            if value.count > 0
              if results_count == blank or value.count < results_count
                assign narrows = true
                break
              endif
            endif
          endfor
          assign show_group = narrows
        endif
      -%}
      {%- unless show_group -%}
        {%- continue -%}
      {%- endunless -%}
      {%- liquid
        assign shown_groups = shown_groups | plus: 1

        # The key of SportWear's own filters in the names dictionary (see snippets/facet-label.liquid).
        assign filter_key = blank
        if filter.param_name contains 'filter.p.m.sportwear.'
          assign filter_key = filter.param_name | remove_first: 'filter.p.m.sportwear.'
        elsif filter.param_name == 'filter.p.product_type'
          assign filter_key = 'product_type'
        endif

        capture filter_label
          render 'facet-label', filter: filter
        endcapture
      -%}
      <details
        id="{{ group_id }}"
        class="facets-group"
        {% if selected > 0 or shown_groups <= 3 %}
          open
        {% endif %}
      >
        <summary id="{{ group_id }}-summary" class="facets-group__summary">
          <span class="facets-group__label">{{ filter_label }}</span>
          {%- if selected > 0 and filter.type != 'price_range' -%}
            <span class="facets-group__selected" aria-hidden="true">{{ selected }}</span>
            <span class="visually-hidden"> ({{ 'facets.selected_count' | t: count: selected }})</span>
          {%- endif -%}
          {%- render 'icon', name: 'plus', size: 18, class: 'facets-group__icon facets-group__icon--plus' -%}
          {%- render 'icon', name: 'minus', size: 18, class: 'facets-group__icon facets-group__icon--minus' -%}
        </summary>

        {%- if filter.type == 'price_range' -%}
          {%- liquid
            assign price_id = 'Filter-' | append: section_id | append: '-' | append: group_index
            assign range_max = filter.range_max | money_without_currency | replace: ',', '' | remove: '.00'
            assign min_value = ''
            if filter.min_value.value != null
              assign min_value = filter.min_value.value | money_without_currency | replace: ',', '' | remove: '.00'
            endif
            assign max_value = ''
            if filter.max_value.value != null
              assign max_value = filter.max_value.value | money_without_currency | replace: ',', '' | remove: '.00'
            endif
          -%}
          <fieldset class="facets-group__body facets-price" data-price-range>
            <legend class="visually-hidden">{{ filter.label | escape }} ({{ currency_symbol }})</legend>
            <div class="facets-price__field">
              <label class="facets-price__label" for="{{ price_id }}-min">{{ 'facets.price_min' | t }}</label>
              <div class="facets-price__control" dir="ltr">
                <span class="facets-price__currency" aria-hidden="true">{{ currency_symbol }}</span>
                <input
                  class="facets-price__input"
                  type="number"
                  id="{{ price_id }}-min"
                  name="{{ filter.min_value.param_name }}"
                  value="{{ min_value }}"
                  placeholder="0"
                  min="0"
                  step="any"
                  data-price="min"
                >
              </div>
            </div>
            <span class="facets-price__dash" aria-hidden="true">–</span>
            <div class="facets-price__field">
              <label class="facets-price__label" for="{{ price_id }}-max">{{ 'facets.price_max' | t }}</label>
              <div class="facets-price__control" dir="ltr">
                <span class="facets-price__currency" aria-hidden="true">{{ currency_symbol }}</span>
                <input
                  class="facets-price__input"
                  type="number"
                  id="{{ price_id }}-max"
                  name="{{ filter.max_value.param_name }}"
                  value="{{ max_value }}"
                  {% if filter.range_max > 0 %}
                    placeholder="{{ range_max }}"
                  {% endif %}
                  min="0"
                  step="any"
                  data-price="max"
                >
              </div>
            </div>
          </fieldset>
        {%- else -%}
          {%- liquid
            assign as_buttons = false
            if option_style != 'checkboxes' and filter.param_name contains 'filter.v.option.'
              assign as_buttons = true
            endif
            if filter.presentation == 'swatch' or filter.presentation == 'image'
              assign as_buttons = false
            endif

            # Display order, as "sort key§value index§name" entries: SportWear's filters sort by the
            # catalog's order when their names have one ("order"), else by name; others keep Shopify's.
            assign entries = ''
            for value in filter.values
              capture value_label
                render 'facet-label', filter: filter, value: value, names: names
              endcapture
              assign sort_key = ''
              if filter_key != blank
                assign rank = names[filter_key][value.value].order
                if rank != blank
                  assign sort_key = rank | plus: 1000 | append: ''
                else
                  assign sort_key = value_label | strip
                endif
              endif
              assign entries = entries | append: sort_key | append: '§' | append: forloop.index0 | append: '§' | append: value_label | append: '¶'
            endfor
            assign entries = entries | split: '¶'
            if filter_key != blank
              assign entries = entries | sort_natural
            endif

            assign list_id = 'FacetValues-' | append: section_id | append: '-' | append: group_index
            assign collapsible = false
            assign extra_selected = false
            if as_buttons == false and entries.size > visible_limit
              assign collapsible = true
              for entry in entries offset: visible_limit
                assign parts = entry | split: '§'
                assign value_index = parts[1] | plus: 0
                if filter.values[value_index].active
                  assign extra_selected = true
                  break
                endif
              endfor
            endif
          -%}
          <fieldset class="facets-group__body">
            <legend class="visually-hidden">{{ filter_label }}</legend>
            <ul
              id="{{ list_id }}"
              class="facets-values{% if as_buttons %} facets-values--buttons{% endif %}{% if collapsible and extra_selected == false %} facets-values--collapsed{% endif %}"
              role="list"
            >
              {%- for entry in entries -%}
                {%- liquid
                  assign parts = entry | split: '§'
                  assign value_index = parts[1] | plus: 0
                  assign value = filter.values[value_index]
                  assign value_label = parts[2]
                  assign input_id = 'Filter-' | append: section_id | append: '-' | append: group_index | append: '-' | append: forloop.index
                  assign value_disabled = false
                  if value.count == 0 and value.active == false
                    assign value_disabled = true
                  endif
                -%}
                <li class="facets-values__item{% if collapsible and forloop.index > visible_limit %} facets-values__item--extra{% endif %}">
                  <input
                    class="facets-values__input visually-hidden"
                    type="checkbox"
                    id="{{ input_id }}"
                    name="{{ value.param_name | escape }}"
                    value="{{ value.value | escape }}"
                    {% if value.active %}
                      checked
                    {% endif %}
                    {% if value_disabled %}
                      disabled
                    {% endif %}
                  >
                  <label class="facets-value{% if as_buttons %} facets-value--button{% endif %}" for="{{ input_id }}">
                    {%- unless as_buttons -%}
                      <span class="facets-value__box" aria-hidden="true">
                        {%- render 'icon', name: 'check', size: 14, class: 'facets-value__check' -%}
                      </span>
                      {%- if filter.presentation == 'swatch' -%}
                        <span
                          class="facets-value__swatch"
                          aria-hidden="true"
                          {% if value.swatch.color != blank %}
                            style="--swatch-color: {{ value.swatch.color }};"
                          {% endif %}
                        >
                          {%- if value.swatch.image != blank -%}
                            {{
                              value.swatch.image
                              | image_url: width: 48
                              | image_tag: alt: '', loading: 'lazy', width: 24, height: 24
                            }}
                          {%- endif -%}
                        </span>
                      {%- elsif filter.presentation == 'image' and value.image != blank -%}
                        <span class="facets-value__image" aria-hidden="true">
                          {{-
                            value.image
                            | image_url: width: 80
                            | image_tag: alt: '', loading: 'lazy', width: 40, height: 40
                          -}}
                        </span>
                      {%- endif -%}
                    {%- endunless -%}
                    <bdi class="facets-value__label">{{ value_label }}</bdi>
                    {%- unless as_buttons -%}
                      <span class="facets-value__count" aria-hidden="true">{{ value.count }}</span>
                    {%- endunless -%}
                    <span class="visually-hidden"> ({{ 'collections.product_count' | t: count: value.count }})</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
            {%- if collapsible -%}
              <button
                type="button"
                id="{{ list_id }}-more"
                class="facets-values__more js-only"
                aria-controls="{{ list_id }}"
                aria-expanded="{{ extra_selected }}"
                data-facets-more
                data-label-more="{{ 'facets.show_more' | t }}"
                data-label-less="{{ 'facets.show_less' | t }}"
              >
                {%- if extra_selected -%}
                  {{- 'facets.show_less' | t -}}
                {%- else -%}
                  {{- 'facets.show_more' | t -}}
                {%- endif -%}
              </button>
            {%- endif -%}
          </fieldset>
        {%- endif -%}
      </details>
    {%- endfor -%}

    <div class="facets-form__submit no-js-only">
      <button type="submit" class="button button--primary button--full">{{ 'facets.apply' | t }}</button>
    </div>
  {%- endif -%}
</form>
