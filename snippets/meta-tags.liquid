{%- doc -%}
  Page title, meta description, canonical URL, Open Graph and Twitter tags.
  hreflang tags are added by Shopify through content_for_header (do not add them here).
  The home page falls back to a translated title and description while Online Store > Preferences
  has none. A product page without an SEO description in its language gets one rebuilt from the
  product description (snippets/product-meta-description.liquid). The link-preview image is the page's own (product, collection, article, or the one set
  in Online Store > Preferences), then the theme's share image setting, then SportWear's share image
  in the page's language (Content > Files: sw-share-he.jpg, sw-share-en.jpg, sw-share-ar.jpg,
  1200x630 with the logo; see design/share/README.md).
{%- enddoc -%}
{%- liquid
  assign meta_title = page_title
  assign meta_description = page_description
  if request.page_type == 'product' and product != blank
    # With no SEO title, Shopify's page title is the product title cut at 70 characters, often
    # mid-word ("… Beige J"). Use the whole title then, the detail after " | " read as ", detail".
    # page_title is HTML-escaped ("Kids&#39;"): compared decoded.
    assign page_title_plain = page_title | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&amp;', '&'
    assign title_length = page_title_plain | size
    assign title_start = product.title | slice: 0, title_length
    if title_start == page_title_plain
      assign title_comma = 'general.comma' | t | append: ' '
      assign meta_title = product.title | replace: ' | ', title_comma
    endif

    # With no SEO description in the page's language, Shopify's is the product description with its
    # paragraphs glued together: rebuilt as sentences (snippets/product-meta-description.liquid).
    # Compared with entities decoded ("Kids&#39;" = "Kids'").
    assign body_start = product.description | strip_html | replace: '&#39;', "'" | replace: '&quot;', '"'
    assign body_start = body_start | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | strip_newlines | strip | slice: 0, 40
    assign description_start = page_description | replace: '&#39;', "'" | replace: '&quot;', '"'
    assign description_start = description_start | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | strip_newlines | strip
    assign description_start = description_start | slice: 0, 40
    if body_start != blank and description_start == body_start
      capture meta_description
        render 'product-meta-description', product: product
      endcapture
    endif
  endif
  if request.page_type == 'index'
    if page_title == blank or page_title == shop.name
      assign meta_title = 'general.meta.home_title' | t: shop: shop.name
    endif
    if meta_description == blank
      assign meta_description = 'general.meta.home_description' | t
    endif
  endif

  assign og_title = meta_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = meta_description | default: shop.description | default: shop.name
  assign og_image = page_image | default: settings.share_image
  if og_image == blank
    # SportWear's share image (logo, tagline, three shirts) in the page's language, else the Hebrew one.
    assign share_file = 'sw-share-' | append: request.locale.iso_code | append: '.jpg'
    assign og_image = images[share_file] | default: images['sw-share-he.jpg']
  endif
  if og_image == blank
    assign og_image = images['sw-v3-s1.jpg']
  endif
  # Image alt texts are stored in Hebrew: other languages describe the picture with the page's title.
  assign og_image_alt = og_image.alt | default: og_title | replace: ' | ', ', '
  unless request.locale.primary
    assign og_image_alt = og_title
  endunless

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}
<title>
  {{- meta_title | escape -}}
  {%- if current_tags -%}
    {%- assign tags_joined = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tagged' | t: tags: tags_joined -}}
  {%- endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless meta_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>
{%- if meta_description != blank %}
  <meta name="description" content="{{ meta_description | escape }}">
{%- endif %}
<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if og_image != blank %}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ og_image_alt | escape }}">
{%- endif %}
{%- if request.page_type == 'product' %}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
