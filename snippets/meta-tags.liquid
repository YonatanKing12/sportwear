{%- doc -%}
  Page title, meta description, canonical URL, Open Graph and Twitter tags.
  hreflang tags are added by Shopify through content_for_header (do not add them here).
  The home page falls back to a translated title and description while Online Store > Preferences
  has none, and every page falls back to the first hero photo when no share image is set.
{%- enddoc -%}
{%- liquid
  assign meta_title = page_title
  assign meta_description = page_description
  if request.page_type == 'index'
    if page_title == blank or page_title == shop.name
      assign meta_title = 'general.meta.home_title' | t: shop: shop.name
    endif
    if meta_description == blank
      assign meta_description = 'general.meta.home_description' | t
    endif
  endif

  assign og_title = meta_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = meta_description | default: shop.description | default: shop.name
  assign og_image = page_image | default: settings.share_image
  if og_image == blank
    # The home page's first hero photo (Content > Files), until a share image is set in the theme settings.
    assign og_image = images['sw-v3-s1.jpg']
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}
<title>
  {{- meta_title -}}
  {%- if current_tags -%}
    {%- assign tags_joined = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tagged' | t: tags: tags_joined -}}
  {%- endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless meta_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>
{%- if meta_description != blank %}
  <meta name="description" content="{{ meta_description | escape }}">
{%- endif %}
<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if og_image != blank %}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
{%- endif %}
{%- if request.page_type == 'product' %}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
