{%- doc -%}
  Free shipping in the cart drawer and on the cart page. When every order ships free (the
  free_shipping_threshold theme setting is 0, so free-shipping-cents prints -1), a short line says
  so, with the delivery time (up to 10 business days). With a positive threshold (₪), a progress bar
  shows how much is left before the order ships free, or a confirmation once it does (the cart total
  after discounts is compared with the threshold). Renders nothing when the setting is empty, when the
  cart is empty, or when no free-shipping promise applies to the visitor (see free-shipping-cents).
  The bar is decorative (aria-hidden): the text carries the information.

  @param {object} cart - The cart object
  @param {string} [class] - Extra classes on the wrapper

  @example
  {% render 'free-shipping-bar', cart: cart %}
{%- enddoc -%}
{%- liquid
  capture threshold_cents
    render 'free-shipping-cents'
  endcapture
  assign threshold_cents = threshold_cents | plus: 0
  assign free_all = false
  assign show_bar = false
  if cart.item_count > 0
    if threshold_cents < 0
      assign free_all = true
    elsif threshold_cents > 0
      assign show_bar = true
      assign remaining = threshold_cents | minus: cart.total_price
      if remaining > 0
        assign progress = cart.total_price | times: 100 | divided_by: threshold_cents
      else
        assign progress = 100
      endif
    endif
  endif
-%}
{%- if free_all -%}
  {%- comment -%}
    The same on every render, so it is not part of the cart's screen reader announcement
    (no data-free-shipping-message).
  {%- endcomment -%}
  <div class="free-shipping free-shipping--all{% if class != blank %} {{ class }}{% endif %}">
    <p class="free-shipping__message">
      <span class="free-shipping__check">{% render 'icon', name: 'check', size: 14 %}</span>
      <span class="free-shipping__text">
        {{- 'cart.free_shipping.all' | t -}}
        &ensp;<span class="free-shipping__delivery">{{ 'products.shipping_note.delivery_short' | t }}</span>
      </span>
    </p>
  </div>
{%- elsif show_bar -%}
  <div class="free-shipping{% if remaining <= 0 %} free-shipping--unlocked{% endif %}{% if class != blank %} {{ class }}{% endif %}">
    <p class="free-shipping__message" data-free-shipping-message>
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money_without_trailing_zeros -%}
        {%- assign remaining_html = '<bdi>' | append: remaining_money | append: '</bdi>' -%}
        {{- 'cart.free_shipping.remaining_html' | t: amount: remaining_html -}}
      {%- else -%}
        <span class="free-shipping__check">{% render 'icon', name: 'check', size: 14 %}</span>
        {{- 'cart.free_shipping.unlocked' | t -}}
      {%- endif -%}
    </p>
    <div class="free-shipping__track" aria-hidden="true">
      <span class="free-shipping__fill" style="--free-shipping-progress: {{ progress }}%;"></span>
    </div>
  </div>
{%- endif -%}
