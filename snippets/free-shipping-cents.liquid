{%- doc -%}
  Prints the free-shipping threshold in cents, or 0 when no free-shipping promise applies:
  the theme setting is empty, the visitor is outside Israel (the only zone with a free rate in
  admin), or the cart is in another currency than the store's. Every free-shipping message
  (announcement bar, product page, cart bar, set and upsell notes, empty cart) goes through here.

  @example
  {% capture threshold_cents %}{% render 'free-shipping-cents' %}{% endcapture %}
  {% assign threshold_cents = threshold_cents | plus: 0 %}
{%- enddoc -%}
{%- liquid
  assign cents = 0
  if settings.free_shipping_threshold != blank and settings.free_shipping_threshold > 0
    if localization.country.iso_code == 'IL' and cart.currency.iso_code == shop.currency
      assign cents = settings.free_shipping_threshold | times: 100 | round
    endif
  endif
  echo cents
-%}
