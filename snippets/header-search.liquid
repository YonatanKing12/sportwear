{%- doc -%}
  Search sheet (<sw-drawer id="SearchModal">): a dialog that slides down from the top with the store
  search form. The header's search link opens it, and goes to the search page when JavaScript is
  off. With "Show suggestions while typing" on (Theme settings > Search), the input is a combobox
  and assets/predictive-search.js (<sw-predictive-search>) lists products, collections and query
  suggestions rendered by sections/predictive-search.liquid.

  @example
  {% render 'header-search' %}
{%- enddoc -%}
{%- assign predictive = settings.predictive_search -%}
<sw-drawer id="SearchModal">
  <dialog
    id="SearchModalDialog"
    class="search-modal color-{{ settings.drawer_color_scheme.id }}"
    aria-labelledby="SearchModalTitle"
  >
    <h2 id="SearchModalTitle" class="visually-hidden">{{ 'header.search.title' | t }}</h2>
    <sw-predictive-search class="search-modal__content">
      <div class="search-modal__bar">
        <search class="search-modal__search">
          <form action="{{ routes.search_url }}" method="get" class="search-modal__form">
            <label class="visually-hidden" for="SearchModalInput">{{ 'header.search.label' | t }}</label>
            <input
              id="SearchModalInput"
              class="search-modal__input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'header.search.placeholder' | t }}"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              autofocus
              {% if predictive %}
                autocomplete="off"
                role="combobox"
                aria-expanded="false"
                aria-controls="PredictiveSearchListbox"
                aria-autocomplete="list"
              {% endif %}
            >
            <input type="hidden" name="options[prefix]" value="last">
            {%- if predictive -%}
              <span class="search-modal__spinner spinner" aria-hidden="true"></span>
            {%- endif -%}
            <button type="submit" class="header__icon">
              {%- render 'icon', name: 'search', size: 22 -%}
              <span class="visually-hidden">{{ 'header.search.submit' | t }}</span>
            </button>
          </form>
        </search>
        <button type="button" class="header__icon" data-drawer-close>
          {%- render 'icon', name: 'close', size: 24 -%}
          <span class="visually-hidden">{{ 'header.search.close' | t }}</span>
        </button>
      </div>

      {%- if predictive -%}
        <div class="search-modal__results" data-predictive-search-results hidden></div>
        {%- comment -%}
          The page's own live region (announce() in @theme/core) sits outside this modal dialog, where
          it is inert while the dialog is open, so result counts are announced from in here.
        {%- endcomment -%}
        <div
          class="visually-hidden"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          data-predictive-search-live
        ></div>
      {%- endif -%}
    </sw-predictive-search>
  </dialog>
</sw-drawer>

{%- if predictive -%}
  <script type="module" src="{{ 'predictive-search.js' | asset_url }}"></script>
{%- endif -%}

{% stylesheet %}
  .search-modal {
    position: fixed;
    inset-block: 0 auto;
    inset-inline: 0;
    inline-size: 100%;
    max-inline-size: none;
    block-size: auto;
    max-block-size: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-background);
    color: var(--color-text);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.3);
    transform: translateY(-100%);
    transition:
      transform var(--duration) var(--ease),
      overlay var(--duration) allow-discrete,
      display var(--duration) allow-discrete;

    &:not([open]) {
      display: none;
    }

    &[open] {
      display: flex;
      flex-direction: column;
      transform: translateY(0);

      @starting-style {
        transform: translateY(-100%);
      }
    }

    &::backdrop {
      background: var(--color-overlay);
      opacity: 0;
      transition:
        opacity var(--duration) var(--ease),
        overlay var(--duration) allow-discrete,
        display var(--duration) allow-discrete;
    }

    &[open]::backdrop {
      opacity: 1;

      @starting-style {
        opacity: 0;
      }
    }
  }

  .search-modal__content {
    display: flex;
    flex-direction: column;
    min-block-size: 0;
    max-block-size: 100dvh;
  }

  .search-modal__bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    inline-size: 100%;
    max-inline-size: calc(var(--page-width, 1440px) + var(--gutter) * 2);
    margin-inline: auto;
    padding: var(--space-3) var(--space-3) var(--space-4);

    @media screen and (min-width: 990px) {
      padding: var(--space-5) var(--gutter) var(--space-6);
    }
  }

  .search-modal__search {
    flex: 1;
    min-inline-size: 0;
  }

  .search-modal__form {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--control-height);
    border-block-end: 2px solid var(--color-text);

    &:focus-within {
      box-shadow: 0 2px 0 0 var(--color-text);
    }
  }

  .search-modal__input {
    flex: 1;
    min-inline-size: 0;
    block-size: 48px;
    padding: 0 var(--space-1);
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-size: calc(18px * var(--body-scale, 1));
    font-weight: 600;
    -webkit-appearance: none;
    appearance: none;

    @media screen and (min-width: 750px) {
      font-size: calc(22px * var(--body-scale, 1));
    }

    &::placeholder {
      color: var(--color-muted);
      font-weight: 500;
      opacity: 1;
    }

    &:focus-visible {
      outline: none; /* the form's thicker underline (:focus-within) is the focus indicator */
    }

    &::-webkit-search-decoration,
    &::-webkit-search-cancel-button {
      -webkit-appearance: none;
      appearance: none;
    }
  }

  .search-modal__spinner {
    display: none;
  }

  .search-modal__content[data-loading] .search-modal__spinner {
    display: block;
  }

  .search-modal__results {
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-block-start: 1px solid var(--color-border);
  }
{% endstylesheet %}
