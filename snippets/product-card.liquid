{%- doc -%}
  Product card used in every product grid (collections, search, home, recommendations, cart upsell).
  The image tile is always light (supplier photos are shot on white). The whole card is clickable
  through one link on the title, so screen readers hear a single, meaningful link.

  @param {product} product - The product; blank renders a placeholder card (theme editor only)
  @param {string} [sizes] - sizes attribute for the image (default fits a 2/3/4-column grid)
  @param {string} [loading] - 'lazy' (default) or 'eager' for cards in the first row of the page
  @param {string} [heading_tag] - 'h3' (default) or 'h2'
  @param {string} [class] - Extra classes on the card

  @example
  {% render 'product-card', product: product, loading: 'eager' %}
{%- enddoc -%}
{%- liquid
  assign card_sizes = sizes | default: '(min-width: 990px) calc((min(100vw, 1440px) - 64px) / 4), (min-width: 750px) calc((100vw - 64px) / 3), calc((100vw - 52px) / 2)'
  assign card_heading = heading_tag | default: 'h3'
  assign card_loading = loading | default: 'lazy'

  assign subtitle = ''
  if product != blank
    case settings.card_subtitle
      when 'team'
        assign team = product.metafields.sportwear.team.value
        if team != blank
          assign subtitle = team.name.value
        endif
      when 'vendor'
        assign subtitle = product.vendor
    endcase

    assign on_sale = false
    if product.compare_at_price_min > product.price_min
      assign on_sale = true
    endif

    assign is_new = false
    if settings.card_new_tag != blank and product.tags contains settings.card_new_tag
      assign is_new = true
    endif

    # The hover photo is the second studio view (the back). The supplier's fabric close-ups (files
    # sw-detail-*) stay on the product page, so a grid keeps one look.
    assign secondary_image = null
    if settings.card_secondary_image and product.media.size > 1
      assign second_media = product.media[1]
      unless second_media.preview_image.src contains 'sw-detail-'
        assign secondary_image = second_media.preview_image
      endunless
    endif
  endif
-%}
<article class="product-card{% if class != blank %} {{ class }}{% endif %}">
  <div class="product-card__media media-tile">
    {%- if product != blank -%}
      {%- render 'image',
        image: product.featured_media.preview_image,
        sizes: card_sizes,
        widths: '240, 360, 480, 720, 960',
        loading: card_loading,
        alt: '',
        class: 'product-card__image'
      -%}
      {%- if secondary_image != blank -%}
        {%- render 'image',
          image: secondary_image,
          sizes: card_sizes,
          widths: '240, 360, 480, 720, 960',
          loading: 'lazy',
          alt: '',
          class: 'product-card__image product-card__image--secondary'
        -%}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg product-card__image' }}
    {%- endif -%}

    {%- if product != blank -%}
      <div class="product-card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--sold-out">{{ 'general.badges.sold_out' | t }}</span>
        {%- elsif on_sale and settings.card_show_sale_badge -%}
          <span class="badge badge--sale">{{ 'general.badges.sale' | t }}</span>
        {%- elsif is_new -%}
          <span class="badge badge--new">{{ 'general.badges.new' | t }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if subtitle != blank -%}
      <p class="product-card__subtitle">{{ subtitle | escape }}</p>
    {%- endif -%}
    <{{ card_heading }} class="product-card__title">
      {%- if product != blank -%}
        {%- comment -%}
          A title's ending after a dash stays together ("26/27 – Kids" never starts a line with the dash
          or leaves "Kids" alone on one): no-break spaces around the dash, plus a word joiner (U+2060)
          after it, since a line may otherwise break right after a dash.
        {%- endcomment -%}
        {%- liquid
          # A detail after " | " (it tells look-alike products apart) reads as a quieter ending.
          assign card_title_main = product.title | split: ' | ' | first
          assign card_title_detail = ''
          if product.title contains ' | '
            assign card_title_detail = product.title | remove_first: card_title_main | remove_first: ' | '
          endif
        -%}
        <a class="product-card__link" href="{{ product.url }}">
          {{- card_title_main | escape | replace: ' – ', '&nbsp;–&#8288;&nbsp;' -}}
          {%- if card_title_detail != blank -%}
            <span class="product-card__title-detail"> · {{ card_title_detail | escape }}</span>
          {%- endif -%}
        </a>
      {%- else -%}
        {{ 'general.placeholders.product_title' | t }}
      {%- endif -%}
    </{{ card_heading }}>
    {%- if product != blank -%}
      {%- render 'price', product: product, class: 'product-card__price' -%}
    {%- endif -%}
  </div>
</article>
