{%- doc -%}
  Product media gallery of the main product section.
  - Every width: a horizontal scroll-snap slider, one media at a time, announced politely ("image 2
    of 4"), with previous/next buttons for mouse users (always shown from 990px).
  - Phones: dots under the image. From 750px: a thumbnail strip instead (below the image on tablets,
    a vertical column beside it on desktop); the thumbnails need JavaScript, the slider does not.
  Media sit on the light tile, contained. The selected variant's media (else the featured media) comes
  first and is the LCP image. Images open a full-screen zoom dialog (sw-drawer + dialog.modal) that
  lists every image large. Behaviour: assets/product-gallery.js (<sw-product-gallery>).

  @param {product} product - The product
  @param {variant} [variant] - The selected variant; its media is shown first
  @param {string} section_id - The section id, used for unique element ids
  @param {string} [ratio] - Tile shape: 'square' (default) or 'portrait'
  @param {boolean} [lcp] - The gallery holds the page's LCP image (first section on the page)
  @param {boolean} [zoom] - Enable the zoom dialog for images (default true)
  @param {string} [badge_text] - Text of a badge over the media; empty shows no badge

  @example
  {% render 'product-gallery', product: product, variant: product.selected_or_first_available_variant, section_id: section.id, lcp: true %}
{%- enddoc -%}
{%- liquid
  assign featured = variant.featured_media
  if featured == blank
    assign featured = product.featured_media
  endif

  assign media_count = product.media.size
  assign image_count = product.media | where: 'media_type', 'image' | size
  assign zoom_enabled = true
  if zoom == false or image_count == 0
    assign zoom_enabled = false
  endif
  assign zoom_id = 'ProductZoom-' | append: section_id
  assign zoom_target = ''
  if zoom_enabled
    assign zoom_target = zoom_id
  endif
  assign list_id = 'ProductGallery-' | append: section_id

  if ratio == 'portrait'
    assign media_ratio = '4 / 5'
  else
    assign media_ratio = '1 / 1'
  endif

  assign badge_label = badge_text | strip | escape

  assign status_template = 'products.gallery.image_status' | t: index: '[index]', count: '[count]'

  # Every slide takes the media column (less the thumbnail column on desktop).
  assign sizes_first = '(min-width: 990px) calc((min(100vw, 1440px) - 112px) * 0.55 - 88px), (min-width: 750px) calc(100vw - 64px), 100vw'
  assign sizes_rest = sizes_first

  assign position = 0
  assign zoom_position = 0
-%}
<sw-product-gallery
  class="product-gallery"
  data-section-id="{{ section_id }}"
  data-zoom-id="{{ zoom_id }}"
  style="--media-ratio: {{ media_ratio }};"
>
  <div class="product-gallery__viewport">
    <ul
      id="{{ list_id }}"
      class="product-gallery__list"
      role="list"
      aria-label="{{ 'products.gallery.label' | t }}"
      data-gallery-list
    >
      {%- if featured != blank -%}
        {%- assign position = position | plus: 1 -%}
        <li class="product-gallery__item" data-gallery-item data-media-id="{{ featured.id }}">
          {%- render 'product-media',
            media: featured,
            product: product,
            position: position,
            count: media_count,
            sizes: sizes_first,
            lcp: lcp,
            zoom_id: zoom_target,
            zoom_index: zoom_position
          -%}
        </li>
        {%- if featured.media_type == 'image' -%}
          {%- assign zoom_position = zoom_position | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
      {%- for media in product.media -%}
        {%- if media.id == featured.id -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign position = position | plus: 1 -%}
        <li class="product-gallery__item" data-gallery-item data-media-id="{{ media.id }}">
          {%- render 'product-media',
            media: media,
            product: product,
            position: position,
            count: media_count,
            sizes: sizes_rest,
            lcp: false,
            zoom_id: zoom_target,
            zoom_index: zoom_position
          -%}
        </li>
        {%- if media.media_type == 'image' -%}
          {%- assign zoom_position = zoom_position | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if media_count == 0 -%}
        <li class="product-gallery__item">
          <div class="product-media media-tile">
            {%- render 'image', image: product.featured_image, sizes: sizes_first, alt: '' -%}
          </div>
        </li>
      {%- endif -%}
    </ul>

    {%- if badge_label != blank -%}
      <p class="product-gallery__badge">
        <span>{{ badge_label }}</span>
      </p>
    {%- endif -%}

    {%- if media_count > 1 -%}
      <div class="product-gallery__arrows js-only">
        <button
          type="button"
          class="product-gallery__arrow product-gallery__arrow--prev"
          aria-controls="{{ list_id }}"
          aria-disabled="true"
          data-gallery-prev
        >
          {%- render 'icon', name: 'chevron-back', size: 22 -%}
          <span class="visually-hidden">{{ 'products.gallery.previous' | t }}</span>
        </button>
        <button
          type="button"
          class="product-gallery__arrow product-gallery__arrow--next"
          aria-controls="{{ list_id }}"
          aria-disabled="false"
          data-gallery-next
        >
          {%- render 'icon', name: 'chevron-forward', size: 22 -%}
          <span class="visually-hidden">{{ 'products.gallery.next' | t }}</span>
        </button>
      </div>
      <div class="product-gallery__dots" aria-hidden="true">
        {%- for i in (1..media_count) -%}
          <span class="product-gallery__dot{% if forloop.first %} is-active{% endif %}" data-gallery-dot></span>
        {%- endfor -%}
      </div>
      <p class="product-gallery__counter" dir="ltr" aria-hidden="true">
        <span data-gallery-current>1</span> / {{ media_count }}
      </p>
      <p
        class="visually-hidden"
        aria-live="polite"
        aria-atomic="true"
        data-gallery-status
        data-template="{{ status_template }}"
      ></p>
    {%- endif -%}
  </div>

  {%- if media_count > 1 -%}
    <ul class="product-gallery__thumbs js-only" role="list" aria-label="{{ 'products.gallery.thumbnails_label' | t }}">
      {%- assign thumb_index = 0 -%}
      {%- if featured != blank -%}
        <li>
          <button
            type="button"
            class="product-gallery__thumb media-tile"
            aria-controls="{{ list_id }}"
            aria-current="true"
            data-gallery-thumb="0"
          >
            {{-
              featured.preview_image
              | image_url: width: 160
              | image_tag: loading: 'lazy', alt: '', class: 'product-gallery__thumb-image'
            -}}
            <span class="visually-hidden">{{ 'products.gallery.show_image' | t: index: 1, count: media_count }}</span>
          </button>
        </li>
        {%- assign thumb_index = 1 -%}
      {%- endif -%}
      {%- for media in product.media -%}
        {%- if media.id == featured.id -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign thumb_number = thumb_index | plus: 1 -%}
        <li>
          <button
            type="button"
            class="product-gallery__thumb media-tile"
            aria-controls="{{ list_id }}"
            aria-current="false"
            data-gallery-thumb="{{ thumb_index }}"
          >
            {{-
              media.preview_image
              | image_url: width: 160
              | image_tag: loading: 'lazy', alt: '', class: 'product-gallery__thumb-image'
            -}}
            <span class="visually-hidden">
              {{- 'products.gallery.show_image' | t: index: thumb_number, count: media_count -}}
            </span>
          </button>
        </li>
        {%- assign thumb_index = thumb_index | plus: 1 -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if zoom_enabled -%}
    <sw-drawer id="{{ zoom_id }}">
      <dialog
        class="modal product-zoom color-{{ settings.drawer_color_scheme.id }}"
        aria-labelledby="{{ zoom_id }}-title"
      >
        <div class="product-modal__header">
          <h2 id="{{ zoom_id }}-title" class="product-modal__title">{{ product.title | escape }}</h2>
          <button type="button" class="button button--icon" data-drawer-close>
            {%- render 'icon', name: 'close' -%}
            <span class="visually-hidden">{{ 'general.close' | t }}</span>
          </button>
        </div>
        <ul class="product-zoom__list" role="list">
          {%- if featured.media_type == 'image' -%}
            {%- assign zoom_alt = featured.alt | default: product.title -%}
            <li class="product-zoom__item" data-zoom-item>
              {%- render 'image',
                image: featured.preview_image,
                sizes: '(min-width: 1180px) 1100px, 100vw',
                widths: '720, 1080, 1440, 1920',
                alt: zoom_alt,
                class: 'product-zoom__image'
              -%}
            </li>
          {%- endif -%}
          {%- for media in product.media -%}
            {%- if media.id == featured.id or media.media_type != 'image' -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign zoom_alt = media.alt | default: product.title -%}
            <li class="product-zoom__item" data-zoom-item>
              {%- render 'image',
                image: media.preview_image,
                sizes: '(min-width: 1180px) 1100px, 100vw',
                widths: '720, 1080, 1440, 1920',
                alt: zoom_alt,
                class: 'product-zoom__image'
              -%}
            </li>
          {%- endfor -%}
        </ul>
      </dialog>
    </sw-drawer>
  {%- endif -%}
</sw-product-gallery>

{% stylesheet %}
  .product-gallery {
    /* The image tile is light in every color scheme, so the controls on it use fixed dark ink. */
    --gallery-ink: #0d0e11;
    --gallery-dot: #a3a8b2;
    --gallery-chip: rgb(255 255 255 / 0.92);
    /* Always show the whole product, whatever the product card image fit is set to. */
    --media-fit: contain;

    position: relative;
    display: block;
  }

  .product-gallery__viewport {
    position: relative;

    & :focus-visible {
      outline-color: var(--gallery-ink);
    }
  }

  .product-gallery__list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .product-gallery__item {
    flex: 0 0 100%;
    min-inline-size: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .product-gallery .media-tile {
    border-radius: 0;

    @media screen and (min-width: 750px) {
      border-radius: var(--radius-card);
    }
  }

  .product-gallery__badge {
    position: absolute;
    inset-block-start: 14px;
    inset-inline-start: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: 30px;
    padding-inline: 10px;
    border-radius: var(--radius-badge);
    background: var(--gallery-ink);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: 1.1;
    pointer-events: none;
  }

  .product-gallery__dots {
    position: absolute;
    inset-block-end: 16px;
    inset-inline: 0;
    display: flex;
    justify-content: center;
    gap: 6px;
    pointer-events: none;

    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .product-gallery__dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 3px;
    background: var(--gallery-dot);
    transition: background-color var(--duration-fast) var(--ease);

    &.is-active {
      inline-size: 22px;
      background: var(--gallery-ink);
    }
  }

  .product-gallery__counter {
    position: absolute;
    inset-block-end: 10px;
    inset-inline-end: 12px;
    padding: 2px 8px;
    border-radius: var(--radius-chip);
    background: var(--gallery-chip);
    color: var(--gallery-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    /* The approved board shows only the badge and the dots on phones; the count stays for scripts. */
    display: none;
  }

  .product-gallery__arrows {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-gallery__arrows {
      display: block;
    }
  }

  @media screen and (min-width: 990px) {
    .product-gallery__arrows {
      display: block;
    }
  }

  /* Thumbnails: hidden on phones (the dots show the position there), a row under the image on
     tablets, a column beside it on desktop. The current one is outlined. */
  .product-gallery__thumbs {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      display: flex;
      gap: var(--space-2);
      margin-block-start: var(--space-3);
      overflow-x: auto;
    }
  }

  .product-gallery__thumb {
    --thumb-ring: transparent;
    display: block;
    inline-size: 76px;
    aspect-ratio: var(--media-ratio);
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    box-shadow: inset 0 0 0 2px var(--thumb-ring);
    cursor: pointer;
    transition: box-shadow var(--duration-fast) var(--ease);

    &:hover {
      --thumb-ring: color-mix(in srgb, var(--gallery-ink) 35%, transparent);
    }

    &[aria-current='true'] {
      --thumb-ring: var(--gallery-ink);
    }
  }

  .product-gallery__thumb-image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  @media screen and (min-width: 990px) {
    .product-gallery:has(.product-gallery__thumbs) {
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      align-items: start;
      gap: var(--space-3);
    }

    .product-gallery__thumbs {
      grid-row: 1;
      grid-column: 1;
      flex-direction: column;
      max-block-size: calc(100vh - var(--header-height, 0px) - 48px);
      margin: 0;
      overflow-x: hidden;
      overflow-y: auto;
    }

    .product-gallery__viewport {
      grid-row: 1;
      grid-column: 2;
    }

    /* The closed zoom dialog's wrapper takes no grid cell. */
    .product-gallery > sw-drawer {
      position: absolute;
    }
  }

  .product-gallery__arrow {
    position: absolute;
    inset-block-start: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    inline-size: var(--touch-target);
    block-size: var(--touch-target);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--gallery-chip);
    color: var(--gallery-ink);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.14);
    cursor: pointer;
    transform: translateY(-50%);

    &[aria-disabled='true'] {
      opacity: 0.35;
      cursor: default;
    }
  }

  .product-gallery__arrow--prev {
    inset-inline-start: 12px;
  }

  .product-gallery__arrow--next {
    inset-inline-end: 12px;
  }

  .modal.product-zoom {
    inline-size: 100%;
    max-inline-size: 100%;
    block-size: 100%;
    max-block-size: 100%;
    margin: 0;
    border-radius: 0;
  }

  .product-zoom .product-modal__title {
    min-inline-size: 0;
    overflow: hidden;
    font-size: var(--text-base);
    text-overflow: ellipsis;
    white-space: nowrap;

    @media screen and (min-width: 750px) {
      font-size: var(--text-xl);
    }
  }

  .product-zoom__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2);
    list-style: none;
  }

  .product-zoom__item {
    inline-size: 100%;
    max-inline-size: 1100px;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-tile);
    scroll-margin-block-start: 72px;
  }

  .product-zoom__image {
    inline-size: 100%;
  }
{% endstylesheet %}
