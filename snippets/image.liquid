{%- doc -%}
  Responsive image: srcset + sizes, intrinsic width/height (no layout shift), placeholder when blank.
  Use eager + fetchpriority 'high' + preload only for the one above-the-fold LCP image.

  @param {image} image - Image, or media.preview_image; blank renders a placeholder illustration
  @param {string} [sizes] - The sizes attribute (default '100vw'). Always pass a real value.
  @param {string} [widths] - Comma-separated srcset widths (default '360, 540, 720, 1080, 1440, 1920')
  @param {string} [loading] - 'lazy' (default) or 'eager'
  @param {string} [fetchpriority] - 'auto' (default) or 'high'
  @param {boolean} [preload] - Send a preload Link header (LCP image only)
  @param {string} [alt] - Alt text override; pass '' for decorative images. Defaults to the image alt.
  @param {string} [class] - Classes for the img element
  @param {string} [placeholder] - placeholder_svg_tag name (default 'product-apparel-1')

  @example
  {% render 'image', image: product.featured_media.preview_image, sizes: '(min-width: 990px) 25vw, 50vw' %}
{%- enddoc -%}
{%- liquid
  assign img_sizes = sizes | default: '100vw'
  assign img_widths = widths | default: '360, 540, 720, 1080, 1440, 1920'
  assign img_loading = loading | default: 'lazy'
  assign img_priority = fetchpriority | default: 'auto'
  assign img_class = class | default: ''

  if image == blank
    assign placeholder_name = placeholder | default: 'product-apparel-1'
    assign placeholder_class = 'placeholder-svg ' | append: img_class
    echo placeholder_name | placeholder_svg_tag: placeholder_class
  else
    if alt == null
      assign img_alt = image.alt
    else
      assign img_alt = alt
    endif
    if preload
      echo image | image_url: width: 1920 | image_tag: widths: img_widths, sizes: img_sizes, loading: img_loading, fetchpriority: img_priority, alt: img_alt, class: img_class, preload: true
    else
      echo image | image_url: width: 1920 | image_tag: widths: img_widths, sizes: img_sizes, loading: img_loading, fetchpriority: img_priority, alt: img_alt, class: img_class
    endif
  endif
-%}
