{%- doc -%}
  Pagination for product grids and lists: an accessible nav with previous/next and page numbers
  (aria-current on the current page) that always works as plain links. With load_more, it also
  renders a "Load more" button with a progress line; assets/facets.js appends the next page in place
  and, while the visitor started on page 1, hides the page numbers.

  @param {paginate} paginate - The paginate object from the enclosing paginate tag
  @param {boolean} [load_more] - Render the progressive "Load more" button (needs <sw-facets>)
  @param {string} [load_more_label] - Translated button label, e.g. 'pagination.load_more' | t

  @example
  {% render 'pagination', paginate: paginate, load_more: true, load_more_label: load_more_label %}
{%- enddoc -%}
{%- liquid
  assign current_title = paginate.current_page | append: ''
  assign shown = paginate.current_offset | plus: paginate.page_size | at_most: paginate.items
  assign progress = 100
  if paginate.items > 0
    assign progress = shown | times: 100 | divided_by: paginate.items
  endif
-%}
<div
  class="pagination{% if load_more and paginate.current_page == 1 %} pagination--load-more{% endif %}"
  data-pagination
  {% if paginate.pages < 2 %}
    hidden
  {% endif %}
>
  {%- if paginate.pages > 1 -%}
    {%- if load_more -%}
      <div class="pagination__more js-only">
        <p class="pagination__status" data-pagination-status>
          {{- 'pagination.progress' | t: shown: shown, total: paginate.items -}}
        </p>
        <span class="pagination__bar" aria-hidden="true">
          <span class="pagination__bar-fill" style="--pagination-progress: {{ progress }}%;"></span>
        </span>
        {%- if paginate.next.is_link -%}
          <button
            type="button"
            class="button button--secondary pagination__button"
            data-load-more
            data-next-url="{{ paginate.next.url }}"
          >
            <span>{{ load_more_label }}</span>
            <span class="spinner pagination__spinner" aria-hidden="true"></span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    <nav class="pagination__nav" aria-label="{{ 'pagination.label' | t }}">
      <ul class="pagination__list" role="list">
        {%- if paginate.previous.is_link -%}
          <li>
            <a class="pagination__link" href="{{ paginate.previous.url }}" rel="prev" data-pagination-link>
              {%- render 'icon', name: 'chevron-back', size: 20 -%}
              <span class="visually-hidden">{{ 'pagination.previous' | t }}</span>
            </a>
          </li>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          <li>
            {%- if part.is_link -%}
              <a class="pagination__link" href="{{ part.url }}" data-pagination-link>
                <span class="visually-hidden">{{ 'pagination.page' | t: page: part.title }}</span>
                <span aria-hidden="true">{{ part.title }}</span>
              </a>
            {%- elsif part.title == current_title -%}
              <span class="pagination__link pagination__link--current" aria-current="page">
                <span class="visually-hidden">{{ 'pagination.page' | t: page: part.title }}</span>
                <span aria-hidden="true">{{ part.title }}</span>
              </span>
            {%- else -%}
              <span class="pagination__gap" aria-hidden="true">…</span>
            {%- endif -%}
          </li>
        {%- endfor -%}

        {%- if paginate.next.is_link -%}
          <li>
            <a class="pagination__link" href="{{ paginate.next.url }}" rel="next" data-pagination-link>
              <span class="visually-hidden">{{ 'pagination.next' | t }}</span>
              {%- render 'icon', name: 'chevron-forward', size: 20 -%}
            </a>
          </li>
        {%- endif -%}
      </ul>
    </nav>
  {%- endif -%}
</div>
