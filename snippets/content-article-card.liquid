{%- doc -%}
  Blog article card: featured image, date and author, title and excerpt. The title link is the
  card's only link (one tab stop) and is stretched over the whole card, so the image is decorative.

  @param {article} article - The article to show
  @param {boolean} [show_image] - Show the featured image (default true)
  @param {boolean} [show_date] - Show the publication date (default true)
  @param {boolean} [show_author] - Show the author (default false)
  @param {boolean} [show_excerpt] - Show the excerpt (default true)
  @param {string} [loading] - Image loading: 'lazy' (default) or 'eager' for the first card at the top of the page
  @param {string} [fetchpriority] - Image fetch priority: 'auto' (default) or 'high'

  @example
  {% render 'content-article-card', article: article, show_author: true %}
{%- enddoc -%}
{%- liquid
  assign card_image = false
  if article.image != blank and show_image != false
    assign card_image = true
  endif
  assign card_date = true
  if show_date == false
    assign card_date = false
  endif
  assign card_author = false
  if show_author and article.author != blank
    assign card_author = true
  endif
  assign card_excerpt = true
  if show_excerpt == false
    assign card_excerpt = false
  endif
-%}
<article class="article-card{% if card_image %} article-card--with-image{% endif %}">
  {%- if card_image -%}
    <div class="media-tile article-card__media">
      {%- render 'image',
        image: article.image,
        sizes: '(min-width: 1600px) 470px, (min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
        widths: '360, 540, 720, 900, 1080',
        loading: loading,
        fetchpriority: fetchpriority,
        alt: ''
      -%}
    </div>
  {%- endif -%}
  <div class="article-card__body">
    {%- if card_date or card_author -%}
      <p class="article-card__meta">
        {%- if card_date -%}
          {{- article.published_at | time_tag: format: 'date' -}}
        {%- endif -%}
        {%- if card_date and card_author -%}
          <span class="article-card__separator" aria-hidden="true">·</span>
        {%- endif -%}
        {%- if card_author -%}
          <span>{{ 'blogs.by_author' | t: author: article.author }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}
    <h2 class="article-card__title">
      <a class="article-card__link" href="{{ article.url }}">{{ article.title | escape }}</a>
    </h2>
    {%- if card_excerpt -%}
      {%- # A space before every tag keeps words of adjacent paragraphs apart once the tags are stripped. -%}
      {%- assign card_text = article.excerpt_or_content
        | replace: '<', ' <'
        | strip_html
        | strip
        | truncatewords: 26
      -%}
      {%- if card_text != blank -%}
        <p class="article-card__excerpt">{{ card_text }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .article-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    block-size: 100%;
  }

  .article-card__media {
    --media-ratio: 3 / 2;
    --media-fit: cover;
  }

  .article-card__body {
    display: grid;
    gap: var(--space-2);
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .article-card__title {
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: var(--leading-tight);
    overflow-wrap: break-word;
  }

  .article-card__link {
    color: inherit;
    text-decoration: none;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-card);
    }

    &:focus-visible {
      outline: none;
    }

    &:focus-visible::after {
      outline: 2px solid var(--color-text);
      outline-offset: 4px;
    }
  }

  .article-card:hover .article-card__link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-card__excerpt {
    color: var(--color-muted);
    font-size: var(--text-md);
  }
{% endstylesheet %}
