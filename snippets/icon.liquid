{%- doc -%}
  Inline SVG icon. Decorative by default (aria-hidden); give the parent control an accessible name.
  Directional icons (chevrons, arrows, truck, return) mirror automatically in right-to-left languages.
  Stroke icons use currentColor lines; brand icons (instagram, tiktok, facebook, whatsapp, youtube, x)
  are filled and come from Simple Icons (CC0).

  @param {string} name - Icon name, e.g. 'bag', 'search', 'chevron-forward', 'pause', 'play', 'whatsapp'
  @param {number} [size] - Width and height in px (default 24)
  @param {string} [class] - Extra classes

  @example
  {% render 'icon', name: 'bag', size: 22 %}
{%- enddoc -%}
{%- liquid
  assign icon_size = size | default: 24
  assign kind = 'stroke'
  case name
    when 'instagram', 'tiktok', 'facebook', 'whatsapp', 'youtube', 'x'
      assign kind = 'brand'
  endcase
  assign directional = false
  case name
    when 'truck', 'return', 'chevron-forward', 'chevron-back', 'arrow-forward', 'arrow-back'
      assign directional = true
  endcase
-%}
<svg
  class="icon icon--{{ name }}{% if directional %} icon--directional{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  {% if kind == 'brand' %}
    fill="currentColor"
  {% else %}
    fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
  {% endif %}
>
