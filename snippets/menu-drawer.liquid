{%- doc -%}
  Mobile menu drawer (<sw-drawer id="MenuDrawer">), opened by the header's menu button below 1200px.
  A calm text menu on a light shopping surface (the drawer color scheme) under a brand strip in the
  header's colors:
  - Level 1: the top-level links as large text rows with thin dividers; a row with sub-links shows a
    chevron and opens its panel. The "sale" row takes the sale color while that collection has
    products.
  - Every link with sub-links opens its own panel (level 2, and level 3 such as NBA > teams or
    players > player), which slides over the list (<sw-drill-menu> in assets/header.js). A panel has
    a top bar with a back button and its title, a first row "Shop all <title>" to the link's own
    page, then every sub-link as a text row (no cap: the full team list is in its panel).
    Opening a panel moves focus to its back button; back (or Escape) closes it and returns focus to
    its row. Without JavaScript the same markup works as nested accordions.
  - Under the menu, a quieter area: account, language and the WhatsApp team-orders link.
  Links to collections without products are left out, as in the desktop menu (hidden_links).

  @param {linklist} [menu] - The menu to show (the header's "Menu" setting)
  @param {string} [hidden_links] - Positions of links to leave out, e.g. ',4,1-3,2-5-1,' (see sections/header.liquid)
  @param {number} [visible_links] - How many top-level links are left to show (default: all of them)
  @param {string} color_scheme - Color scheme id of the brand strip at the top (the header's), e.g. 'scheme-night'

  @example
  {% render 'menu-drawer', menu: section.settings.menu, hidden_links: hidden_links, color_scheme: section.settings.color_scheme.id %}
{%- enddoc -%}
{%- liquid
  assign hidden = hidden_links | default: ','
  assign link_total = visible_links | default: menu.links.size
  assign body_scheme = settings.drawer_color_scheme.id | default: 'scheme-day'

  capture whatsapp_digits
    render 'whatsapp-digits'
  endcapture
  if whatsapp_digits != blank
    assign whatsapp_text = 'header.menu.whatsapp_message' | t | url_encode | replace: '+', '%20'
  endif
-%}
<sw-drawer id="MenuDrawer">
  <dialog
    id="MenuDrawerDialog"
    class="drawer drawer--start menu-drawer color-{{ body_scheme }}"
    aria-labelledby="MenuDrawerTitle"
  >
    <div class="menu-drawer__header color-{{ color_scheme }}">
      <h2 id="MenuDrawerTitle" class="menu-drawer__title display-s">{{ 'header.menu.title' | t }}</h2>
      <button
        type="button"
        class="header__icon"
        data-drawer-close
        commandfor="MenuDrawerDialog"
        command="close"
      >
        {%- render 'icon', name: 'close', size: 24 -%}
        <span class="visually-hidden">{{ 'header.menu.close' | t }}</span>
      </button>
    </div>

    <sw-drill-menu class="menu-drawer__body">
      <div class="menu-drawer__main">
        {%- if menu.links.size > 0 and link_total > 0 -%}
          <nav class="menu-drawer__nav" aria-label="{{ 'header.menu.nav_label' | t }}">
            <ul class="menu-drawer__list" role="list">
              {%- for link in menu.links -%}
                {%- liquid
                  assign link_index = forloop.index
                  assign link_key = ',' | append: link_index | append: ','

                  assign visible_children = 0
                  for child in link.links
                    assign child_key = ',' | append: link_index | append: '-' | append: forloop.index | append: ','
                    unless hidden contains child_key
                      assign visible_children = visible_children | plus: 1
                    endunless
                  endfor

                  assign row_class = 'menu-drawer__row menu-drawer__row--top'
                  if link.type == 'collection_link' and link.object.handle == 'sale'
                    if link.object.all_products_count > 0
                      assign row_class = row_class | append: ' menu-drawer__row--sale'
                    endif
                  endif
                -%}
                {%- unless hidden contains link_key -%}
                  <li class="menu-drawer__item">
                    {%- if visible_children > 0 -%}
                      <details class="menu-drawer__details" data-drill>
                        <summary class="{{ row_class }}">
                          <span class="menu-drawer__label">{{ link.title | escape }}</span>
                          {%- render 'icon', name: 'chevron-forward', size: 20, class: 'menu-drawer__chevron' -%}
                        </summary>

                        <div class="menu-drawer__panel">
                          <div class="menu-drawer__bar">
                            <button type="button" class="menu-drawer__back" data-drill-back>
                              {%- render 'icon', name: 'chevron-back', size: 22 -%}
                              <span class="visually-hidden">{{ 'header.menu.back' | t }}</span>
                            </button>
                            <p class="menu-drawer__panel-title">{{ link.title | escape }}</p>
                          </div>

                          <div class="menu-drawer__panel-body">
                            <ul class="menu-drawer__list" role="list">
                              {%- if link.url != blank and link.url != '#' -%}
                                <li class="menu-drawer__item">
                                  <a
                                    class="menu-drawer__row menu-drawer__row--all"
                                    href="{{ link.url }}"
                                    {% if link.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    <span class="menu-drawer__label">
                                      {{- 'header.menu.shop_all_title' | t: title: link.title -}}
                                    </span>
                                    {%- render 'icon', name: 'arrow-forward', size: 18, class: 'menu-drawer__arrow' -%}
                                  </a>
                                </li>
                              {%- endif -%}

                              {%- for child in link.links -%}
                                {%- liquid
                                  assign child_index = forloop.index
                                  assign child_key = ',' | append: link_index | append: '-' | append: child_index | append: ','
                                  assign grandchild_prefix = ',' | append: link_index | append: '-' | append: child_index | append: '-'

                                  assign visible_grandchildren = 0
                                  for grandchild in child.links
                                    assign grandchild_key = grandchild_prefix | append: forloop.index | append: ','
                                    unless hidden contains grandchild_key
                                      assign visible_grandchildren = visible_grandchildren | plus: 1
                                    endunless
                                  endfor
                                -%}
                                {%- unless hidden contains child_key -%}
                                  <li class="menu-drawer__item">
                                    {%- if visible_grandchildren > 0 -%}
                                      <details class="menu-drawer__details" data-drill>
                                        <summary class="menu-drawer__row">
                                          <span class="menu-drawer__label">{{ child.title | escape }}</span>
                                          {%- render 'icon',
                                            name: 'chevron-forward',
                                            size: 20,
                                            class: 'menu-drawer__chevron'
                                          -%}
                                        </summary>

                                        <div class="menu-drawer__panel">
                                          <div class="menu-drawer__bar">
                                            <button type="button" class="menu-drawer__back" data-drill-back>
                                              {%- render 'icon', name: 'chevron-back', size: 22 -%}
                                              <span class="visually-hidden">
                                                {{- 'header.menu.back_to' | t: title: link.title -}}
                                              </span>
                                            </button>
                                            <p class="menu-drawer__panel-title">{{ child.title | escape }}</p>
                                          </div>

                                          <div class="menu-drawer__panel-body">
                                            <ul class="menu-drawer__list" role="list">
                                              {%- if child.url != blank and child.url != '#' -%}
                                                <li class="menu-drawer__item">
                                                  <a
                                                    class="menu-drawer__row menu-drawer__row--all"
                                                    href="{{ child.url }}"
                                                    {% if child.current %}
                                                      aria-current="page"
                                                    {% endif %}
                                                  >
                                                    <span class="menu-drawer__label">
                                                      {{- 'header.menu.shop_all_title' | t: title: child.title -}}
                                                    </span>
                                                    {%- render 'icon',
                                                      name: 'arrow-forward',
                                                      size: 18,
                                                      class: 'menu-drawer__arrow'
                                                    -%}
                                                  </a>
                                                </li>
                                              {%- endif -%}
                                              {%- for grandchild in child.links -%}
                                                {%- assign grandchild_key = grandchild_prefix
                                                  | append: forloop.index
                                                  | append: ','
                                                -%}
                                                {%- unless hidden contains grandchild_key -%}
                                                  <li class="menu-drawer__item">
                                                    <a
                                                      class="menu-drawer__row"
                                                      href="{{ grandchild.url }}"
                                                      {% if grandchild.current %}
                                                        aria-current="page"
                                                      {% endif %}
                                                    >
                                                      <span class="menu-drawer__label">
                                                        {{- grandchild.title | escape -}}
                                                      </span>
                                                    </a>
                                                  </li>
                                                {%- endunless -%}
                                              {%- endfor -%}
                                            </ul>
                                          </div>
                                        </div>
                                      </details>
                                    {%- else -%}
                                      <a
                                        class="menu-drawer__row"
                                        href="{{ child.url }}"
                                        {% if child.current %}
                                          aria-current="page"
                                        {% endif %}
                                      >
                                        <span class="menu-drawer__label">{{ child.title | escape }}</span>
                                      </a>
                                    {%- endif -%}
                                  </li>
                                {%- endunless -%}
                              {%- endfor -%}
                            </ul>
                          </div>
                        </div>
                      </details>
                    {%- else -%}
                      <a
                        class="{{ row_class }}"
                        href="{{ link.url }}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        <span class="menu-drawer__label">{{ link.title | escape }}</span>
                      </a>
                    {%- endif -%}
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <div class="menu-drawer__secondary">
          {%- if shop.customer_accounts_enabled -%}
            <a class="menu-drawer__secondary-link" href="{{ routes.account_url }}">
              {%- render 'icon', name: 'user', size: 20 -%}
              <span>
                {%- if customer -%}
                  {{- 'header.account.account' | t -}}
                {%- else -%}
                  {{- 'header.account.log_in' | t -}}
                {%- endif -%}
              </span>
            </a>
          {%- endif -%}

          {%- render 'localization-switcher', id: 'MenuLocalization' -%}

          {%- if whatsapp_digits != blank -%}
            <a
              class="menu-drawer__secondary-link"
              href="https://wa.me/{{ whatsapp_digits }}?text={{ whatsapp_text }}"
              target="_blank"
              rel="noopener"
            >
              {%- render 'icon', name: 'whatsapp', size: 20 -%}
              <span>{{ 'header.menu.team_orders' | t }}</span>
              <span class="visually-hidden">({{ 'accessibility.new_window' | t }})</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </sw-drill-menu>
  </dialog>
</sw-drawer>

{% stylesheet %}
  /* Brand strip: the header's colors, so the drawer reads as part of the header. */
  .menu-drawer__header {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-block-size: 60px;
    padding-inline: var(--space-5) var(--space-2);
  }

  .menu-drawer__title {
    margin: 0;
    font-size: calc(28px * var(--heading-scale, 1) * var(--display-lang-scale));
  }

  /* Without JavaScript the body scrolls and the panels open in place (nested accordions). */
  .menu-drawer__body {
    display: block;
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu-drawer__main {
    display: flex;
    flex-direction: column;
    min-block-size: 100%;
  }

  /* With <sw-drill-menu> running, each panel covers the level under it: the body stops scrolling
     (each layer scrolls on its own) and becomes the containing block of the level-2 panels; a
     level-3 panel is positioned against its level-2 panel, which does not scroll itself. */
  .menu-drawer__body:defined {
    position: relative;
    overflow: hidden;

    & .menu-drawer__main {
      block-size: 100%;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  .menu-drawer__nav {
    padding-block-end: var(--space-6);
  }

  .menu-drawer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-drawer__item {
    border-block-end: 1px solid var(--color-border);
  }

  .menu-drawer__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: 52px;
    padding: var(--space-3) var(--space-5);
    color: inherit;
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }

    &:focus-visible {
      outline-offset: -3px;
    }
  }

  @media (hover: hover) {
    .menu-drawer__row:hover,
    .menu-drawer__back:hover {
      background: var(--color-surface);
    }
  }

  .menu-drawer__row--top {
    min-block-size: 56px;
    font-size: calc(18px * var(--body-scale, 1));
    font-weight: 700;
  }

  .menu-drawer__row--all {
    font-weight: 800;
  }

  .menu-drawer__row--sale {
    color: var(--color-sale);
  }

  .menu-drawer__label {
    flex: 1;
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .menu-drawer__row[aria-current='page'] .menu-drawer__label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .menu-drawer__chevron,
  .menu-drawer__arrow {
    color: var(--color-muted);
  }

  /* Panel: a nested accordion body without JavaScript… */
  .menu-drawer__panel {
    border-block-start: 1px solid var(--color-border);
    padding-inline-start: var(--space-4);
  }

  .menu-drawer__panel .menu-drawer__item:last-child {
    border-block-end: 0;
  }

  .menu-drawer__bar {
    display: none;
  }

  .menu-drawer__details[open] > .menu-drawer__row .menu-drawer__chevron {
    rotate: 90deg;
  }

  [dir='rtl'] .menu-drawer__details[open] > .menu-drawer__row .menu-drawer__chevron {
    rotate: -90deg;
  }

  /* …and a layer that slides over the level under it with <sw-drill-menu>. */
  .menu-drawer__body:defined {
    & .menu-drawer__panel {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      padding: 0;
      border: 0;
      background: var(--color-background);
    }

    & .menu-drawer__panel .menu-drawer__item:last-child {
      border-block-end: 1px solid var(--color-border);
    }

    & .menu-drawer__bar {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: var(--space-1);
      min-block-size: 56px;
      padding-inline: var(--space-2) var(--space-5);
      border-block-end: 1px solid var(--color-border);
    }

    & .menu-drawer__panel-body {
      flex: 1;
      min-block-size: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    & .menu-drawer__details[open] > .menu-drawer__row .menu-drawer__chevron {
      rotate: none;
    }
  }

  .menu-drawer__back {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    inline-size: var(--touch-target);
    block-size: var(--touch-target);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-drawer__panel-title {
    min-inline-size: 0;
    overflow: hidden;
    font-size: calc(19px * var(--body-scale, 1));
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* The level under an open panel stays painted while the panel slides in, then leaves the tab
     order and the accessibility tree. */
  .menu-drawer__body[data-drilled] .menu-drawer__main {
    visibility: hidden;
    transition: visibility 0s linear var(--duration);
  }

  .menu-drawer__body[data-drilled] .menu-drawer__panel {
    visibility: visible;
  }

  .menu-drawer__body[data-drilled] .menu-drawer__panel[data-covered] {
    visibility: hidden;
    transition: visibility 0s linear var(--duration);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-drawer__body:defined .menu-drawer__panel {
      transition: translate var(--duration) var(--ease);

      @starting-style {
        translate: 100% 0;
      }
    }

    [dir='rtl'] .menu-drawer__body:defined .menu-drawer__panel {
      @starting-style {
        translate: -100% 0;
      }
    }
  }

  /* Account, language and team orders: compact and quieter, at the bottom of the first level. */
  .menu-drawer__secondary {
    display: grid;
    justify-items: start;
    gap: 2px;
    margin-block-start: auto;
    padding: var(--space-3) var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    border-block-start: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--text-md);
  }

  .menu-drawer__secondary-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--touch-target);
    color: inherit;
    font-weight: 600;
    text-decoration: none;
    text-underline-offset: 4px;

    & .icon {
      color: var(--color-muted);
    }

    &:hover {
      text-decoration-line: underline;
    }
  }
{% endstylesheet %}
