{%- doc -%}
  Size (variant) picker: one fieldset per option (SportWear products have a single Size option), with
  radio inputs styled as size buttons. Adult sizes sit in 4 columns, kids sizes (5-6 ... 13-14) in 5.
  Sold-out sizes of single-option products stay visible but are disabled, struck through and announced
  as sold out. The same markup serves three places (context):
  - 'main': the picker in the product info column. The first option gets the "Size guide" button that
    opens the SizeChart dialog, and an inline "choose a size" message that assets/product-info.js shows
    when the customer tries to add to cart without a size.
  - 'sheet': the size sheet of the sticky buy bar on phones (same look, own input names).
  - 'bar': compact size buttons inside the sticky buy bar on desktop, with a "choose a size" bubble.

  With a single option, each main radio carries its variant id and posts it to the product form through
  the form attribute, so the size choice works without JavaScript (the selected or first available size
  is checked); assets/product-info.js then moves the id to the form's hidden input and, when the
  customer has to choose the size (size_required), clears the preselection. The sheet and bar radios are
  JavaScript-only and mirror the main picker. With several options, the main radios only describe the
  choice and the section is re-rendered for the new combination (Section Rendering API).

  @param {product} product - The product
  @param {object} block - The variant_picker block (settings: show_size_guide)
  @param {string} section_id - The section id, used for unique input ids
  @param {string} [form_id] - Id of the product form the main size radios post to
  @param {boolean} [submits_id] - The main radios submit the variant id themselves (single-option products)
  @param {string} [context] - 'main' (default), 'sheet' or 'bar'
  @param {boolean} [size_required] - No size is chosen yet: the sheet and bar start with none checked

  @example
  {% render 'variant-picker', product: product, block: block, section_id: section.id, form_id: form_id, submits_id: true %}
{%- enddoc -%}
{%- liquid
  assign context = context | default: 'main'
  assign first_option = product.options_with_values | first
  assign first_value = first_option.values | first
  assign audience = product.metafields.sportwear.audience.value
  assign is_kids = false
  if audience == 'kids'
    assign is_kids = true
  elsif audience == blank and first_value.name contains '-'
    assign is_kids = true
  endif

  assign single_option = false
  if product.options.size == 1
    assign single_option = true
  endif

  # Which size is marked as chosen. A sold-out product has none, unless the URL asked for one.
  assign mark_selected = true
  if context != 'main' and size_required
    assign mark_selected = false
  endif
  if single_option and product.available == false and product.selected_variant == blank
    assign mark_selected = false
  endif

  assign id_prefix = section_id
  if context != 'main'
    assign id_prefix = section_id | append: '-' | append: context
  endif
  assign message_id = id_prefix | append: '-size-message'
-%}
<div
  class="variant-picker variant-picker--{{ context }}{% if is_kids %} variant-picker--kids{% endif %}"
  {% if single_option %}
    data-size-picker="{{ context }}"
  {% endif %}
>
  <div
    class="variant-picker__options"
    {% if product.options.size > 1 %}
      data-product-dynamic="picker"
    {% endif %}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_index = forloop.index
        assign option_label = option.name | downcase
      -%}
      <fieldset class="variant-picker__option">
        <legend class="variant-picker__legend{% if context == 'bar' %} visually-hidden{% endif %}">
          {{- 'products.variant_picker.choose' | t: option: option_label -}}
        </legend>
        {%- if forloop.first and context != 'bar' and block.settings.show_size_guide -%}
          <button
            type="button"
            class="variant-picker__guide js-only"
            data-drawer-open="SizeChart"
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            {%- render 'icon', name: 'ruler', size: 18 -%}
            <span>{{ 'products.variant_picker.size_guide' | t }}</span>
          </button>
        {%- endif -%}
        {%- if forloop.first and single_option and context != 'sheet' -%}
          <p id="{{ message_id }}" class="variant-picker__message" data-size-message hidden>
            {%- render 'icon', name: 'alert', size: 18 -%}
            <span>{{ 'products.buy.choose_size' | t }}</span>
          </p>
        {%- endif -%}
        <div class="variant-picker__values{% if forloop.first %} variant-picker__values--primary{% else %} variant-picker__values--auto{% endif %}">
          {%- for value in option.values -%}
            {%- capture input_id -%}{{ id_prefix }}-option{{ option_index }}-{{ forloop.index }}{%- endcapture -%}
            <input
              type="radio"
              class="variant-picker__input visually-hidden"
              id="{{ input_id }}"
              {% if context != 'main' %}
                name="{{ id_prefix }}-size"
                value="{{ value.variant.id }}"
              {% elsif submits_id %}
                name="id"
                value="{{ value.variant.id }}"
                form="{{ form_id }}"
              {% else %}
                name="{{ section_id }}-option{{ option_index }}"
                value="{{ value.name | escape }}"
              {% endif %}
              data-variant-option
              data-option-value-id="{{ value.id }}"
              {% if value.variant != blank %}
                data-variant-id="{{ value.variant.id }}"
              {% endif %}
              {% if single_option %}
                data-size-input
                data-size-name="{{ value.name | escape }}"
              {% endif %}
              autocomplete="off"
              {% if value.selected and mark_selected %}
                checked
              {% endif %}
              {% if single_option and value.available == false %}
                disabled
              {% endif %}
            >
            <label
              class="variant-picker__value{% unless value.available %} variant-picker__value--unavailable{% endunless %}"
              for="{{ input_id }}"
            >
              <bdi dir="ltr">{{ value.name | escape }}</bdi>
              {%- unless value.available -%}
                <span class="visually-hidden">, {{ 'products.variant_picker.sold_out' | t }}</span>
              {%- endunless -%}
            </label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}
  </div>
  {%- if is_kids and context != 'bar' -%}
    <p class="variant-picker__note">
      {%- if block.settings.show_size_guide -%}
        {{ 'products.variant_picker.kids_note' | t }}
      {%- else -%}
        {{ 'products.variant_picker.kids_note_short' | t }}
      {%- endif -%}
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .variant-picker {
    --variant-pill-border: color-mix(in srgb, var(--color-text) 18%, var(--color-background));
  }

  .variant-picker__option {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;

    & + & {
      margin-block-start: var(--space-4);
    }
  }

  /* Floated so the legend and the size guide button share one row; the legend still names the fieldset. */
  .variant-picker__legend {
    float: inline-start;
    display: flex;
    align-items: center;
    min-block-size: var(--touch-target);
    padding: 0;
    font-size: calc(15px * var(--body-scale, 1));
    font-weight: 700;
  }

  .variant-picker__guide {
    float: inline-end;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: var(--touch-target);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: var(--text-md);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;

    &:hover {
      text-decoration-thickness: 2px;
    }
  }

  /* "Choose a size": shown by assets/product-info.js when the customer tries to add without one. */
  .variant-picker__message {
    clear: both;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-1);
    color: var(--color-error);
    font-size: var(--text-md);
    font-weight: 700;
    line-height: var(--leading-tight);
  }

  .variant-picker__values {
    clear: both;
    display: grid;
    grid-template-columns: repeat(var(--variant-columns, 4), minmax(0, 1fr));
    gap: var(--space-2);
    padding-block-start: var(--space-2);
  }

  .variant-picker__values--auto {
    grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
  }

  .variant-picker--kids .variant-picker__values--primary {
    --variant-columns: 5;

    gap: 6px;
  }

  .variant-picker__value {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--control-height);
    padding-inline: var(--space-1);
    border: 1.5px solid var(--variant-pill-border);
    border-radius: var(--radius-button);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);

    &:hover {
      border-color: var(--color-text);
    }
  }

  .variant-picker--kids .variant-picker__values--primary .variant-picker__value {
    font-size: var(--text-md);
  }

  .variant-picker__value--unavailable {
    background: color-mix(in srgb, var(--color-surface) 55%, var(--color-background));
    color: var(--color-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  .variant-picker__input:disabled + .variant-picker__value {
    border-style: dashed;
    cursor: not-allowed;

    &:hover {
      border-color: var(--variant-pill-border);
    }
  }

  .variant-picker__input:checked + .variant-picker__value {
    border-style: solid;
    border-color: var(--color-button);
    background: var(--color-button);
    color: var(--color-button-label);
  }

  .variant-picker__input:focus-visible + .variant-picker__value {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  /* After a "choose a size" prompt the size buttons that can be chosen get the error color. */
  .variant-picker[data-invalid] .variant-picker__input:enabled + .variant-picker__value {
    border-color: var(--color-error);
  }

  .variant-picker__note {
    margin-block-start: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* Sheet: the same buttons, a little taller for thumbs. */
  .variant-picker--sheet .variant-picker__value {
    min-block-size: 56px;
  }

  /* Bar (desktop sticky buy bar): one row of compact size buttons and a bubble for the prompt. */
  .variant-picker--bar {
    position: relative;

    & .variant-picker__values {
      display: flex;
      flex-wrap: nowrap;
      gap: 6px;
      padding: 0;
    }

    & .variant-picker__value {
      min-block-size: var(--touch-target);
      min-inline-size: var(--touch-target);
      padding-inline: 10px;
      font-size: var(--text-md);
    }

    & .variant-picker__message {
      position: absolute;
      inset-block-end: calc(100% + 14px);
      inset-inline-start: 50%;
      z-index: 1;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-button);
      background: var(--color-text);
      box-shadow: 0 8px 24px rgb(13 14 17 / 0.22);
      color: var(--color-background);
      font-size: var(--text-sm);
      white-space: nowrap;
      translate: -50% 0;

      &::after {
        content: '';
        position: absolute;
        inset-block-start: 100%;
        inset-inline-start: 50%;
        border: 7px solid transparent;
        border-block-start-color: var(--color-text);
        translate: -50% 0;
      }
    }
  }

  /* translate is physical: in right-to-left pages the start edge is the right one. */
  [dir='rtl'] .variant-picker--bar .variant-picker__message,
  [dir='rtl'] .variant-picker--bar .variant-picker__message::after {
    translate: 50% 0;
  }
{% endstylesheet %}
