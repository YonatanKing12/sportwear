{%- doc -%}
  Empty-cart message for the drawer and the cart page: a friendly line, a primary button back to
  the shop and, when the free-shipping threshold is set, a reminder of it.

  @param {string} url - Where the shopping button goes (a collection URL or routes.all_products_collection_url)
  @param {string} [class] - Extra classes on the wrapper

  @example
  {% render 'cart-empty', url: routes.all_products_collection_url %}
{%- enddoc -%}
{%- liquid
  capture threshold_cents
    render 'free-shipping-cents'
  endcapture
  assign threshold_cents = threshold_cents | plus: 0
-%}
<div class="cart-empty{% if class != blank %} {{ class }}{% endif %}">
  <span class="cart-empty__icon">{% render 'icon', name: 'bag', size: 28 %}</span>
  <p class="cart-empty__title title-m">{{ 'cart.empty.title' | t }}</p>
  <p class="cart-empty__text">{{ 'cart.empty.text' | t }}</p>
  <a class="button button--primary button--large cart-empty__button" href="{{ url }}">
    {{- 'cart.empty.button' | t -}}
  </a>
  {%- if threshold_cents > 0 -%}
    {%- assign threshold_money = threshold_cents | money_without_trailing_zeros | prepend: '⁨' | append: '⁩' -%}
    <p class="cart-empty__perk">
      {%- render 'icon', name: 'truck', size: 18 -%}
      {{ 'cart.empty.free_shipping' | t: amount: threshold_money }}
    </p>
  {%- endif -%}
</div>
