{%- doc -%}
  Empty-cart message for the drawer and the cart page: a friendly line, a primary button back to
  the shop and, when the free-shipping threshold is set, a reminder of it.

  @param {string} url - Where the shopping button goes (a collection URL or routes.all_products_collection_url)
  @param {string} [class] - Extra classes on the wrapper

  @example
  {% render 'cart-empty', url: routes.all_products_collection_url %}
{%- enddoc -%}
{%- assign threshold_cents = settings.free_shipping_threshold | default: 0 | times: 100 | round -%}
<div class="cart-empty{% if class != blank %} {{ class }}{% endif %}">
  <span class="cart-empty__icon">{% render 'icon', name: 'bag', size: 28 %}</span>
  <p class="cart-empty__title title-m">{{ 'cart.empty.title' | t }}</p>
  <p class="cart-empty__text">{{ 'cart.empty.text' | t }}</p>
  <a class="button button--primary button--large cart-empty__button" href="{{ url }}">
    {{- 'cart.empty.button' | t -}}
  </a>
  {%- if threshold_cents > 0 and cart.currency.iso_code == shop.currency -%}
    {%- assign threshold_money = threshold_cents | money_without_trailing_zeros -%}
    <p class="cart-empty__perk">
      {%- render 'icon', name: 'truck', size: 18 -%}
      {{ 'cart.empty.free_shipping' | t: amount: threshold_money }}
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-10) var(--space-5);
    text-align: center;
  }

  .cart-empty__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 64px;
    block-size: 64px;
    margin-block-end: var(--space-1);
    border-radius: 50%;
    background: var(--color-surface);
  }

  .cart-empty__text {
    max-inline-size: 32ch;
    color: var(--color-muted);
  }

  .cart-empty__button {
    min-inline-size: min(100%, 260px);
    margin-block-start: var(--space-2);
  }

  .cart-empty__perk {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }
{% endstylesheet %}
