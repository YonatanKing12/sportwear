{%- doc -%}
  "Complete the set" panel of the main product section: the products from the metafield
  sportwear.complements (the shorts of the same kit on a jersey's page, the jerseys on the shorts'
  page), in a quiet bordered card under the buy buttons. Each row has a 72px image tile, the title
  and price, the set price when the store's set discount covers the pair (snippets/set-price.liquid),
  a size select and an "Add" button. Each row is a real product form (works without
  JavaScript); <sw-product-form data-source="quick-add"> (assets/product-info.js) adds it through
  CartAPI instead. Sold-out products are left out.
  The size chosen for this product is also picked in a row whose size the customer has not chosen
  (assets/product-info.js, select[data-set-size]); with ?variant= in the URL, Liquid picks it already.
  The "together: free shipping" line shows only when there is a free shipping amount above 0 (Theme
  settings > Cart), this product alone is below it and the two together reach it; it is re-rendered
  with the variant. When every order ships free there is nothing to reach, so it never shows.

  @param {product} product - The product on the page
  @param {variant} [variant] - The selected variant of that product
  @param {boolean} [size_required] - No size is chosen yet (see sections/main-product.liquid)
  @param {product[]} complements - The products of the metafield sportwear.complements
  @param {object} block - The complete_set block (settings: heading, products_to_show, color_scheme, show_free_shipping_note)

  @example
  {% render 'product-complete-set', product: product, variant: current_variant, size_required: size_required, complements: complements, block: block %}
{%- enddoc -%}
{%- liquid
  assign items = complements | where: 'available'

  assign heading = block.settings.heading | escape
  if heading == blank
    assign heading = 'products.complete_set.heading' | t
  endif

  assign threshold_cents = 0
  if block.settings.show_free_shipping_note
    capture threshold_cents
      render 'free-shipping-cents'
    endcapture
    assign threshold_cents = threshold_cents | plus: 0
  endif

  assign main_price = product.price
  assign chosen_size = ''
  if variant != blank
    assign main_price = variant.price
    if size_required != true and product.selected_variant != blank
      assign chosen_size = variant.option1
    endif
  endif
  assign heading_id = 'CompleteSet-' | append: block.id
  assign title_comma = 'general.comma' | t | append: ' '
-%}
{%- if items.size > 0 -%}
  <div class="product-set color-{{ block.settings.color_scheme.id }}">
    <h2 id="{{ heading_id }}" class="product-set__heading">{{ heading }}</h2>
    <ul class="product-set__list" role="list" aria-labelledby="{{ heading_id }}">
      {%- for item in items limit: block.settings.products_to_show -%}
        {%- liquid
          assign item_variant = item.selected_or_first_available_variant
          assign item_plain_title = item.title | replace: ' | ', title_comma
          assign item_form_id = 'CompleteSetForm-' | append: block.id | append: '-' | append: item.id
          assign select_id = item_form_id | append: '-size'
          assign error_id = item_form_id | append: '-error'
          assign together = main_price | plus: item_variant.price
        -%}
        <li class="product-set__item">
          <sw-product-form class="product-set__product" data-source="quick-add">
            <a class="product-set__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- render 'image',
                image: item.featured_media.preview_image,
                sizes: '72px',
                widths: '72, 144, 216',
                alt: ''
              -%}
            </a>
            <div class="product-set__info">
              <a class="product-set__title" href="{{ item.url }}">{% render 'product-title', title: item.title %}</a>
              {%- render 'price', product: item, class: 'product-set__price' -%}
              <div class="product-set__deal" data-product-dynamic="set-price-{{ item.id }}">
                {%- render 'set-price',
                  product: product,
                  price: main_price,
                  item: item,
                  item_price: item_variant.price
                -%}
              </div>
              {%- if threshold_cents > 0 -%}
                <p class="product-set__note" data-product-dynamic="set-note-{{ item.id }}">
                  {%- if main_price < threshold_cents and together >= threshold_cents -%}
                    {{ 'products.complete_set.free_shipping_together' | t }}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
            {%- form 'product', item, id: item_form_id, class: 'product-set__form' -%}
              {%- if item.has_only_default_variant -%}
                <input type="hidden" name="id" value="{{ item_variant.id }}">
              {%- else -%}
                {%- liquid
                  assign preselect_id = 0
                  if chosen_size != blank
                    for option_variant in item.variants
                      if option_variant.available and option_variant.option1 == chosen_size
                        assign preselect_id = option_variant.id
                        break
                      endif
                    endfor
                  endif
                -%}
                <label class="visually-hidden" for="{{ select_id }}">
                  {{- 'products.complete_set.size_label' | t: title: item_plain_title -}}
                </label>
                <select
                  id="{{ select_id }}"
                  class="field__select product-set__select"
                  name="id"
                  required
                  aria-describedby="{{ error_id }}"
                  data-set-size
                >
                  <option
                    value=""
                    {% if preselect_id == 0 %}
                      selected
                    {% endif %}
                    disabled
                  >
                    {{- 'products.complete_set.choose_size' | t -}}
                  </option>
                  {%- for option_variant in item.variants -%}
                    <option
                      value="{{ option_variant.id }}"
                      data-size="{{ option_variant.option1 | escape }}"
                      {% if option_variant.id == preselect_id %}
                        selected
                      {% endif %}
                      {% unless option_variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {%- if option_variant.available -%}
                        {{ option_variant.title | escape }}
                      {%- else -%}
                        {{ 'products.complete_set.option_sold_out' | t: size: option_variant.title }}
                      {%- endif -%}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="button button--secondary product-set__add product-submit">
                <span class="product-set__add-label">
                  {%- render 'icon', name: 'plus', size: 16 -%}
                  {{- 'products.complete_set.add' | t -}}
                </span>
                <span class="visually-hidden">: {{ item_plain_title | escape }}</span>
                <span class="spinner product-submit__spinner" aria-hidden="true"></span>
              </button>
              <p
                id="{{ error_id }}"
                class="product-set__error field__message field__message--error"
                role="alert"
                data-form-error
                data-invalid-message="{{ 'products.buy.choose_size' | t }}"
              ></p>
            {%- endform -%}
          </sw-product-form>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  /* A quiet card in the page's own colors, like the trust grid above it: a hairline border, a small
     heading and compact rows, so it reads as part of the buy box rather than a banner. */
  .product-set {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-background);
    color: var(--color-text);
  }

  .product-set__heading {
    font-size: var(--text-md);
    font-weight: 800;
    line-height: var(--leading-tight);
  }

  .product-set__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-set__item + .product-set__item {
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-border);
  }

  .product-set__product {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    grid-template-areas:
      'media info'
      'media form';
    align-items: start;
    gap: var(--space-2) var(--space-3);
  }

  .product-set__media {
    grid-area: media;
    display: block;
    inline-size: 72px;
    block-size: 72px;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-tile);

    & > img,
    & > svg {
      inline-size: 100%;
      block-size: 100%;
      object-fit: contain;
    }
  }

  .product-set__info {
    grid-area: info;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px var(--space-3);
    min-inline-size: 0;
  }

  .product-set__title {
    flex: 1 1 12em;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    color: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    overflow-wrap: anywhere;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .product-set__price {
    flex: 0 0 auto;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .product-set__deal {
    flex-basis: 100%;

    &:empty {
      display: none;
    }
  }

  .product-set__note {
    flex-basis: 100%;
    font-size: var(--text-xs);
    font-weight: 700;

    &:empty {
      display: none;
    }
  }

  .product-set__form {
    position: relative;
    grid-area: form;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .product-set .product-set__select {
    flex: 1 1 110px;
    inline-size: auto;
    min-inline-size: 0;
    min-block-size: var(--touch-target);
    padding-block: 6px;
    font-size: var(--text-sm);
  }

  .product-set__add {
    flex: 0 0 auto;
    min-block-size: var(--touch-target);
    padding-inline: var(--space-4);
    font-size: var(--text-sm);
  }

  .product-set__add-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .product-set__error {
    flex-basis: 100%;

    /* Out of the flow while empty, but still in the accessibility tree so the alert is announced. */
    &:empty {
      position: absolute;
    }
  }
{% endstylesheet %}
