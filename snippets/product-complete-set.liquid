{%- doc -%}
  "Complete the set" panel of the main product section: the products from the metafield
  sportwear.complements (for example the shorts that go with a tank), each with an 88px image tile,
  its title and price, a size select when it has several variants, and an "Add" button. Each row is
  a real product form (works without JavaScript); <sw-product-form data-source="quick-add">
  (assets/product-info.js) adds it through CartAPI instead. Sold-out products are left out.
  The "together: free shipping" line shows only when this product alone is below the free shipping
  amount (Theme settings > Cart) and the two together reach it; it is re-rendered with the variant.

  @param {product} product - The product on the page
  @param {variant} [variant] - The selected variant of that product
  @param {product[]} complements - The products of the metafield sportwear.complements
  @param {object} block - The complete_set block (settings: heading, products_to_show, color_scheme, show_free_shipping_note)

  @example
  {% render 'product-complete-set', product: product, variant: current_variant, complements: complements, block: block %}
{%- enddoc -%}
{%- liquid
  assign items = complements | where: 'available'

  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'products.complete_set.heading' | t
  endif

  assign threshold_cents = 0
  if block.settings.show_free_shipping_note and settings.free_shipping_threshold != blank
    assign threshold_cents = settings.free_shipping_threshold | times: 100
  endif

  assign main_price = product.price
  if variant != blank
    assign main_price = variant.price
  endif
  assign heading_id = 'CompleteSet-' | append: block.id
-%}
{%- if items.size > 0 -%}
  <div class="product-set color-{{ block.settings.color_scheme.id }}">
    <h2 id="{{ heading_id }}" class="product-set__heading display-s">{{ heading | escape }}</h2>
    <ul class="product-set__list" role="list" aria-labelledby="{{ heading_id }}">
      {%- for item in items limit: block.settings.products_to_show -%}
        {%- liquid
          assign item_variant = item.selected_or_first_available_variant
          assign item_form_id = 'CompleteSetForm-' | append: block.id | append: '-' | append: item.id
          assign select_id = item_form_id | append: '-size'
          assign error_id = item_form_id | append: '-error'
          assign together = main_price | plus: item_variant.price
        -%}
        <li class="product-set__item">
          <sw-product-form class="product-set__product" data-source="quick-add">
            <a class="product-set__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- render 'image',
                image: item.featured_media.preview_image,
                sizes: '88px',
                widths: '88, 176, 264',
                alt: ''
              -%}
            </a>
            <div class="product-set__info">
              <a class="product-set__title" href="{{ item.url }}">{{ item.title | escape }}</a>
              {%- render 'price', product: item, class: 'product-set__price' -%}
              {%- if threshold_cents > 0 -%}
                <p class="product-set__note" data-product-dynamic="set-note-{{ item.id }}">
                  {%- if main_price < threshold_cents and together >= threshold_cents -%}
                    {{ 'products.complete_set.free_shipping_together' | t }}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
            {%- form 'product', item, id: item_form_id, class: 'product-set__form' -%}
              {%- if item.has_only_default_variant -%}
                <input type="hidden" name="id" value="{{ item_variant.id }}">
              {%- else -%}
                <label class="visually-hidden" for="{{ select_id }}">
                  {{- 'products.complete_set.size_label' | t: title: item.title -}}
                </label>
                <select
                  id="{{ select_id }}"
                  class="field__select product-set__select"
                  name="id"
                  required
                  aria-describedby="{{ error_id }}"
                >
                  <option value="" selected disabled>{{ 'products.complete_set.choose_size' | t }}</option>
                  {%- for option_variant in item.variants -%}
                    <option
                      value="{{ option_variant.id }}"
                      {% unless option_variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {%- if option_variant.available -%}
                        {{ option_variant.title | escape }}
                      {%- else -%}
                        {{ 'products.complete_set.option_sold_out' | t: size: option_variant.title }}
                      {%- endif -%}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="button button--primary button--small product-set__add product-submit">
                <span>{{ 'products.complete_set.add' | t }}</span>
                <span class="visually-hidden">: {{ item.title | escape }}</span>
                <span class="spinner product-submit__spinner" aria-hidden="true"></span>
              </button>
              <p
                id="{{ error_id }}"
                class="product-set__error field__message field__message--error"
                role="alert"
                data-form-error
                data-invalid-message="{{ 'products.buy.choose_size' | t }}"
              ></p>
            {%- endform -%}
          </sw-product-form>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-set {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-card);
  }

  .product-set__heading {
    line-height: 1;
  }

  .product-set__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-set__product {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    grid-template-areas:
      'media info'
      'media form';
    align-items: start;
    gap: var(--space-2) var(--space-3);
  }

  .product-set__media {
    grid-area: media;
    display: block;
    inline-size: 88px;
    block-size: 88px;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-tile);

    & > img,
    & > svg {
      inline-size: 100%;
      block-size: 100%;
      object-fit: contain;
      mix-blend-mode: multiply;
    }
  }

  .product-set__info {
    grid-area: info;
    display: grid;
    gap: 3px;
    min-inline-size: 0;
  }

  .product-set__title {
    color: inherit;
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    overflow-wrap: anywhere;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .product-set__price {
    font-size: var(--text-base);
  }

  .product-set__note {
    font-size: var(--text-xs);
    font-weight: 700;

    &:empty {
      display: none;
    }
  }

  .product-set__form {
    position: relative;
    grid-area: form;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .product-set .product-set__select {
    flex: 1 1 120px;
    inline-size: auto;
    min-inline-size: 0;
    min-block-size: var(--touch-target);
    padding-block: 6px;
    background-color: var(--color-surface);
    font-size: var(--text-md);
  }

  .product-set__add {
    flex: 0 0 auto;
    min-inline-size: 66px;
  }

  .product-set__error {
    flex-basis: 100%;

    /* Out of the flow while empty, but still in the accessibility tree so the alert is announced. */
    &:empty {
      position: absolute;
    }
  }
{% endstylesheet %}
