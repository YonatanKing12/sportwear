{
  "_status": "CREATED in Shopify on 2026-09-25. IDs are in catalog/store-setup.json. Change definitions only via the Shopify MCP GraphQL workflow. On 2026-09-27: the storefront-filter definitions (team_handle, league_handle, styles, player; admin-filterable, like audience and kit), the audience choice \"women\" and the shop metafield filter_names (catalog/README.md, \"מסננים באתר\").",
  "metaobjects": [
    {
      "type": "sw_league",
      "name": "League",
      "translatable": true,
      "storefront_access": "PUBLIC_READ",
      "fields": [
        { "key": "name", "type": "single_line_text_field", "required": true },
        { "key": "slug", "type": "single_line_text_field", "required": true },
        { "key": "sport", "type": "single_line_text_field", "choices": ["football", "basketball"] }
      ]
    },
    {
      "type": "sw_team",
      "name": "Team",
      "translatable": true,
      "storefront_access": "PUBLIC_READ",
      "fields": [
        { "key": "name", "type": "single_line_text_field", "required": true },
        { "key": "short_name", "type": "single_line_text_field" },
        { "key": "slug", "type": "single_line_text_field", "required": true },
        { "key": "sport", "type": "single_line_text_field", "choices": ["football", "basketball"] },
        { "key": "leagues", "type": "list.metaobject_reference", "metaobject": "sw_league" },
        { "key": "primary_color", "type": "color" }
      ]
    },
    {
      "type": "sw_size_chart",
      "name": "Size chart",
      "translatable": true,
      "storefront_access": "PUBLIC_READ",
      "fields": [
        { "key": "name", "type": "single_line_text_field", "required": true },
        { "key": "audience", "type": "single_line_text_field", "choices": ["adult", "kids"] },
        {
          "key": "table",
          "type": "json",
          "note": "{\"rows\": [...]} (or a bare array). Row keys, all optional but size: size, age, height_cm, weight_kg, chest_width_cm (flat, armpit to armpit), chest_cm (circumference), length_cm, shorts_length_cm. Values are numbers or ranges such as \"160-170\". Other keys are kept but not shown."
        },
        { "key": "fit_note", "type": "multi_line_text_field" }
      ]
    }
  ],
  "product_metafields": [
    {
      "namespace": "sportwear",
      "key": "team",
      "type": "metaobject_reference",
      "metaobject": "sw_team",
      "storefront_access": "PUBLIC_READ"
    },
    {
      "namespace": "sportwear",
      "key": "leagues",
      "type": "list.metaobject_reference",
      "metaobject": "sw_league",
      "storefront_access": "PUBLIC_READ"
    },
    { "namespace": "sportwear", "key": "season", "type": "single_line_text_field", "storefront_access": "PUBLIC_READ" },
    {
      "namespace": "sportwear",
      "key": "kit",
      "type": "single_line_text_field",
      "choices": ["home", "away", "third", "fourth", "special", "training"],
      "storefront_access": "PUBLIC_READ"
    },
    {
      "namespace": "sportwear",
      "key": "audience",
      "type": "single_line_text_field",
      "choices": ["adult", "kids", "women"],
      "storefront_access": "PUBLIC_READ",
      "note": "storefront filter 'למי'"
    },
    {
      "namespace": "sportwear",
      "key": "size_chart",
      "type": "metaobject_reference",
      "metaobject": "sw_size_chart",
      "storefront_access": "PUBLIC_READ"
    },
    {
      "namespace": "sportwear",
      "key": "counterpart",
      "type": "product_reference",
      "storefront_access": "PUBLIC_READ",
      "note": "adult <-> kids version"
    },
    {
      "namespace": "sportwear",
      "key": "complements",
      "type": "list.product_reference",
      "storefront_access": "PUBLIC_READ",
      "note": "set pieces: a basketball jersey <-> the shorts of the same kit (same design on the photos), both directions; product page and cart 'complete the set'"
    },
    {
      "namespace": "sportwear",
      "key": "source_url",
