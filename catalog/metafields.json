      "note": "internal only"
    },
    {
      "namespace": "sportwear",
      "key": "team_handle",
      "type": "single_line_text_field",
      "storefront_access": "PUBLIC_READ",
      "note": "storefront filter 'קבוצה': the team slug (= its collection handle), mirrored from the team: tag"
    },
    {
      "namespace": "sportwear",
      "key": "league_handle",
      "type": "single_line_text_field",
      "storefront_access": "PUBLIC_READ",
      "note": "storefront filter 'ליגה': the league slug, mirrored from the league: tag"
    },
    {
      "namespace": "sportwear",
      "key": "styles",
      "type": "list.single_line_text_field",
      "choices": ["retro", "city-edition", "special"],
      "storefront_access": "PUBLIC_READ",
      "note": "storefront filter 'סגנון', mirrored from the style: tags"
    },
    {
      "namespace": "sportwear",
      "key": "player",
      "type": "list.single_line_text_field",
