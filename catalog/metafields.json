  ],
  "shop_metafields": [
    {
      "namespace": "sportwear",
      "key": "filter_names",
      "type": "json",
      "storefront_access": "PUBLIC_READ",
      "note": "he/en/ar names of the filter values, written by scripts/catalog/filter-data.mjs from catalog/taxonomy.json; read by snippets/facet-label.liquid"
    }
  ]
}
